exports[`code generation > preset snapshots > satellite 1`] = `
""""Image preprocessing pipeline "Satellite / aerial" (generated by Modelith Preprocessing Studio).

Steps, with shapes for a 640×480 input:

    input  BGR uint8 (H, W, 3) from load_image()
     1. Percentile contrast stretch  → BGR uint8 (480, 640, 3)
     2. Random rotate 90° [train]    → BGR uint8 (640, 640, 3)
     3. Random flip [train]          → BGR uint8 (640, 640, 3)
     4. Random flip [train]          → BGR uint8 (640, 640, 3)
     5. Convert colour               → RGB uint8 (640, 640, 3)
     6. Scale to [0, 1]              → RGB float32 (640, 640, 3), range ~[0, 1]
     7. HWC → CHW                    → RGB float32 (3, 640, 640) CHW, range ~[0, 1]

Output (inference): RGB float32 (3, 480, 640) CHW, range ~[0, 1]

Usage:
    img = load_image("photo.jpg")
    x, t = preprocess(img)                                   # inference (deterministic)
    x, t = preprocess(img, mask=m, boxes=b, train=True)      # training (augmentations on)
    boxes = postprocess_boxes(pred_boxes, t.history)         # back to original pixels

    python preprocess.py input_dir output_dir [--train] [--seed N] [--save-steps] [--npy]
"""

from __future__ import annotations

import argparse
from pathlib import Path

import cv2
import numpy as np


SEED = 0  # np.random.Generator(np.random.PCG64(SEED)) drives every random step
READ_FLAG = cv2.IMREAD_COLOR

# 1. Percentile contrast stretch
PERCENTILE_STRETCH_PERCENTILES = (2, 98)

# 3. Random flip
RANDOM_FLIP_3_P = 0.5  # probability of applying

# 4. Random flip
RANDOM_FLIP_4_P = 0.5  # probability of applying


MIN_BOX_VISIBILITY = 0.1  # boxes keeping less of their area after clipping are dropped

# Pixel-index matrices (OpenCV) ↔ continuous coordinates (pixel edges at integers) used for boxes / keypoints.
_TO_CONT = np.array([[1.0, 0.0, 0.5], [0.0, 1.0, 0.5], [0.0, 0.0, 1.0]])
_FROM_CONT = np.array([[1.0, 0.0, -0.5], [0.0, 1.0, -0.5], [0.0, 0.0, 1.0]])


def _apply_h(H, pts):
    """Apply a 3×3 homography to (N, 2) points."""
    p = np.concatenate([pts, np.ones((len(pts), 1))], axis=1) @ H.T
    return p[:, :2] / p[:, 2:3]


def _box_corners(boxes):
    b = boxes
    return np.stack([b[:, [0, 1]], b[:, [2, 1]], b[:, [2, 3]], b[:, [0, 3]]], axis=1).reshape(-1, 2)


class Targets:
    """Mask, boxes and keypoints that follow the image through geometric steps.

    mask:      (H, W) or (H, W, C) label image, always warped with INTER_NEAREST so class ids stay intact.
    boxes:     (N, 4+) array of x1, y1, x2, y2 in pixels; extra columns (e.g. class ids) are carried along.
    keypoints: (N, 2+) array of x, y in pixels.
    history:   every geometric transform applied, for postprocess_boxes / _mask / _keypoints.
    """

    def __init__(self, image_size, mask=None, boxes=None, keypoints=None):
        self.size = tuple(image_size)  # (width, height)
        self.mask = mask
        self.boxes = np.zeros((0, 4)) if boxes is None else np.asarray(boxes, np.float64).reshape(len(boxes), -1)
        self.keypoints = np.zeros((0, 2)) if keypoints is None else np.asarray(keypoints, np.float64).reshape(len(keypoints), -1)
        self.history = []

    def _points(self, H, dst):
        if len(self.boxes):
            pts = _apply_h(H, _box_corners(self.boxes)).reshape(-1, 4, 2)
            x1, y1 = pts[..., 0].min(1), pts[..., 1].min(1)
            x2, y2 = pts[..., 0].max(1), pts[..., 1].max(1)
            area = (x2 - x1) * (y2 - y1)
            cx1, cx2 = np.clip(x1, 0, dst[0]), np.clip(x2, 0, dst[0])
            cy1, cy2 = np.clip(y1, 0, dst[1]), np.clip(y2, 0, dst[1])
            clipped = (cx2 - cx1) * (cy2 - cy1)
            keep = (area > 0) & (clipped > 0) & (clipped >= MIN_BOX_VISIBILITY * area)
            self.boxes = np.concatenate([np.stack([cx1, cy1, cx2, cy2], 1), self.boxes[:, 4:]], 1)[keep]
        if len(self.keypoints):
            self.keypoints = np.concatenate([_apply_h(H, self.keypoints[:, :2]), self.keypoints[:, 2:]], 1)

    def _record(self, kind, H, dst, arg=None):
        self.history.append({"kind": kind, "H": H, "src": self.size, "dst": tuple(dst), "arg": arg})
        self.size = tuple(dst)

    def resize(self, dst):
        """Follow cv2.resize to dst = (width, height)."""
        if self.mask is not None:
            self.mask = cv2.resize(self.mask, dst, interpolation=cv2.INTER_NEAREST)
        H = np.array([[dst[0] / self.size[0], 0, 0], [0, dst[1] / self.size[1], 0], [0, 0, 1.0]])
        self._points(H, dst)
        self._record("resize", H, dst)

    def warp(self, M, dst):
        """Follow cv2.warpAffine (2×3 M) or cv2.warpPerspective (3×3 M) to dst = (width, height)."""
        M = np.asarray(M, np.float64)
        M3 = np.vstack([M, [0, 0, 1]]) if M.shape[0] == 2 else M
        if self.mask is not None:
            warp = cv2.warpAffine if M.shape[0] == 2 else cv2.warpPerspective
            self.mask = warp(self.mask, M, dst, flags=cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        H = _TO_CONT @ M3 @ _FROM_CONT
        self._points(H, dst)
        self._record("warp", H, dst, M3)

    def flip(self, code):
        """Follow cv2.flip: 1 horizontal, 0 vertical, -1 both."""
        w, h = self.size
        if self.mask is not None:
            self.mask = cv2.flip(self.mask, code)
        fx, fy = code != 0, code != 1
        H = np.array([[-1 if fx else 1, 0, w if fx else 0], [0, -1 if fy else 1, h if fy else 0], [0, 0, 1.0]])
        self._points(H, self.size)
        self._record("flip", H, self.size, code)

    def crop(self, x, y, w, h):
        if self.mask is not None:
            self.mask = self.mask[y : y + h, x : x + w].copy()
        H = np.array([[1, 0, -x], [0, 1, -y], [0, 0, 1.0]])
        self._points(H, (w, h))
        self._record("crop", H, (w, h), (x, y, w, h))

    def pad(self, top, bottom, left, right):
        if self.mask is not None:
            self.mask = cv2.copyMakeBorder(self.mask, top, bottom, left, right, cv2.BORDER_CONSTANT, value=0)
        dst = (self.size[0] + left + right, self.size[1] + top + bottom)
        H = np.array([[1, 0, left], [0, 1, top], [0, 0, 1.0]])
        self._points(H, dst)
        self._record("pad", H, dst, (top, bottom, left, right))

    def rot90(self, k):
        """k quarter turns clockwise (k = 1 is cv2.ROTATE_90_CLOCKWISE)."""
        k %= 4
        if not k:
            return
        w, h = self.size
        if self.mask is not None:
            self.mask = cv2.rotate(self.mask, [None, cv2.ROTATE_90_CLOCKWISE, cv2.ROTATE_180, cv2.ROTATE_90_COUNTERCLOCKWISE][k])
        H = {1: [[0, -1, h], [1, 0, 0]], 2: [[-1, 0, w], [0, -1, h]], 3: [[0, 1, 0], [-1, 0, w]]}[k]
        H = np.array(H + [[0, 0, 1]], np.float64)
        dst = (w, h) if k == 2 else (h, w)
        self._points(H, dst)
        self._record("rot90", H, dst, k)

    def remap(self, map_x, map_y):
        """Follow cv2.remap (elastic / grid / optical distortion). Not invertible by postprocess_*."""
        dh, dw = map_x.shape[:2]
        if self.mask is not None:
            self.mask = cv2.remap(self.mask, map_x, map_y, cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        flat_x, flat_y = map_x.ravel() + 0.5, map_y.ravel() + 0.5

        def nearest(pts):
            idx = [int(np.argmin((flat_x - x) ** 2 + (flat_y - y) ** 2)) for x, y in pts]
            return np.array([[i % dw + 0.5, i // dw + 0.5] for i in idx]).reshape(-1, 2)

        if len(self.keypoints):
            self.keypoints = np.concatenate([nearest(self.keypoints[:, :2]), self.keypoints[:, 2:]], 1)
        if len(self.boxes):
            pts = nearest(_box_corners(self.boxes)).reshape(-1, 4, 2)
            b = np.stack([pts[..., 0].min(1), pts[..., 1].min(1), pts[..., 0].max(1), pts[..., 1].max(1)], 1)
            keep = (b[:, 2] > b[:, 0]) & (b[:, 3] > b[:, 1])
            self.boxes = np.concatenate([b, self.boxes[:, 4:]], 1)[keep]
        self._record("remap", None, (dw, dh))


def _check_invertible(history):
    if any(r["kind"] == "remap" for r in history):
        raise ValueError("remap-based distortions (elastic / grid / optical) cannot be inverted; use the inference pipeline")


def postprocess_boxes(boxes, history):
    """Map boxes (N, 4+) predicted on the preprocessed image back to original image pixels.

    Undoes letterbox, resize, crop, pad, flips, 90° rotations and warps in reverse order
    (for a letterbox: x_orig = (x - pad_left) / scale).
    """
    _check_invertible(history)
    boxes = np.asarray(boxes, np.float64).reshape(len(boxes), -1)
    for rec in reversed(history):
        if not len(boxes):
            break
        pts = _apply_h(np.linalg.inv(rec["H"]), _box_corners(boxes)).reshape(-1, 4, 2)
        w, h = rec["src"]
        b = np.stack([pts[..., 0].min(1), pts[..., 1].min(1), pts[..., 0].max(1), pts[..., 1].max(1)], 1)
        b[:, [0, 2]] = b[:, [0, 2]].clip(0, w)
        b[:, [1, 3]] = b[:, [1, 3]].clip(0, h)
        boxes = np.concatenate([b, boxes[:, 4:]], 1)
    return boxes


def postprocess_keypoints(keypoints, history):
    """Map keypoints (N, 2+) back to original image pixels."""
    _check_invertible(history)
    kp = np.asarray(keypoints, np.float64).reshape(len(keypoints), -1)
    for rec in reversed(history):
        kp = np.concatenate([_apply_h(np.linalg.inv(rec["H"]), kp[:, :2]), kp[:, 2:]], 1)
    return kp


def postprocess_mask(mask, history, interpolation=cv2.INTER_NEAREST):
    """Map a mask / depth map predicted on the preprocessed image back to the original image size.

    Use interpolation=cv2.INTER_LINEAR for continuous maps such as depth.
    """
    _check_invertible(history)
    for rec in reversed(history):
        kind, arg = rec["kind"], rec["arg"]
        w, h = rec["src"]
        if kind == "resize":
            mask = cv2.resize(mask, (w, h), interpolation=interpolation)
        elif kind == "flip":
            mask = cv2.flip(mask, arg)
        elif kind == "rot90":
            mask = np.ascontiguousarray(np.rot90(mask, arg))  # np.rot90 turns counter-clockwise
        elif kind == "crop":
            x, y, cw, ch = arg
            full = np.zeros((h, w) + mask.shape[2:], mask.dtype)
            full[y : y + ch, x : x + cw] = mask
            mask = full
        elif kind == "pad":
            top, _, left, _ = arg
            mask = mask[top : top + h, left : left + w]
        elif kind == "warp":
            mask = cv2.warpPerspective(mask, np.linalg.inv(arg), (w, h), flags=interpolation)
    return mask


def _randint(rng, lo, hi):
    """Integer in [lo, hi] inclusive, from one rng.random() draw."""
    return lo + min(int(rng.random() * (hi - lo + 1)), hi - lo)


def _saturate(x, dtype):
    """Round and clip a float array into an integer dtype (what OpenCV's saturate_cast does)."""
    info = np.iinfo(dtype)
    return np.clip(np.rint(x), info.min, info.max).astype(dtype)


def load_image(path):
    """Read an image with cv2 (works with non-ASCII paths): BGR uint8 (H, W, 3)."""
    data = np.fromfile(str(path), dtype=np.uint8)
    img = cv2.imdecode(data, READ_FLAG)
    if img is None:
        raise ValueError(f"cannot decode image: {path}")
    return img


def step_01_percentile_stretch(img):
    """Per channel, map the low percentile (e.g.

    in:  BGR uint8 (480, 640, 3)
    out: BGR uint8 (480, 640, 3)
    cv2: lo, hi = np.percentile(img, (2, 98), axis=(0, 1)); (img - lo) * max / (hi - lo)
    """
    lo, hi = np.percentile(img, PERCENTILE_STRETCH_PERCENTILES, axis=(0, 1))  # per channel
    out = (img.astype(np.float32) - lo) * (255.0 / np.maximum(hi - lo, 1e-6))
    img = _saturate(out, np.uint8)
    return img


def step_02_random_rotate90(img, t, rng):
    """Rotate by a random multiple of 90° (0, 90, 180 or 270°): lossless, no border filling.

    in:  BGR uint8 (480, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: cv2.rotate(img, [None, cv2.ROTATE_90_CLOCKWISE, cv2.ROTATE_180, cv2.ROTATE_90_COUNTERCLOCKWISE][k])
    """
    k = _randint(rng, 0, 3)  # quarter turns clockwise
    if k:
        img = cv2.rotate(img, [None, cv2.ROTATE_90_CLOCKWISE, cv2.ROTATE_180, cv2.ROTATE_90_COUNTERCLOCKWISE][k])
        t.rot90(k)
    return img


def step_03_random_flip(img, t, rng):
    """Mirror the image with probability p (horizontal is the classic, almost always safe
    augmentation; vertical only where up/down has no meaning: aerial, microscopy).

    in:  BGR uint8 (640, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: cv2.flip(img, 1)
    """
    if rng.random() >= RANDOM_FLIP_3_P:
        return img
    img = cv2.flip(img, 1)
    t.flip(1)
    return img


def step_04_random_flip(img, t, rng):
    """Mirror the image with probability p (horizontal is the classic, almost always safe
    augmentation; vertical only where up/down has no meaning: aerial, microscopy).

    in:  BGR uint8 (640, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: cv2.flip(img, 1)
    """
    if rng.random() >= RANDOM_FLIP_4_P:
        return img
    img = cv2.flip(img, 0)
    t.flip(0)
    return img


def step_05_convert_color(img):
    """Convert between colour spaces with cv2.cvtColor (BGR↔RGB, GRAY, HSV, HLS, LAB, LUV, YCrCb,
    XYZ, BGRA).

    BGR → RGB

    in:  BGR uint8 (640, 640, 3)
    out: RGB uint8 (640, 640, 3)
    cv2: cv2.cvtColor(img, cv2.COLOR_<FROM>2<TO>)
    """
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    # img is now RGB uint8 (640, 640, 3)
    return img


def step_06_scale_01(img):
    """Divide by the dtype maximum (255 for uint8, 65535 for uint16) to get float32 in [0, 1],
    without mean / std normalisation.

    in:  RGB uint8 (640, 640, 3)
    out: RGB float32 (640, 640, 3), range ~[0, 1]
    cv2: img.astype(np.float32) / 255.0
    """
    img = img.astype(np.float32) / 255.0
    # img is now RGB float32 (640, 640, 3), range ~[0, 1]
    return img


def step_07_to_chw(img):
    """Move channels first, (H, W, C) → (C, H, W), the layout PyTorch models expect.

    in:  RGB float32 (640, 640, 3), range ~[0, 1]
    out: RGB float32 (3, 640, 640) CHW, range ~[0, 1]
    cv2: np.ascontiguousarray(img.transpose(2, 0, 1))
    """
    img = np.ascontiguousarray(img.transpose(2, 0, 1))
    # img is now RGB float32 (3, 640, 640) CHW, range ~[0, 1]
    return img


def run_steps(img, t, rng, train=False, start=0, on_step=None):
    """Apply steps[start:] in order. on_step(index, name, colour_space, img) is called after each step that runs."""
    steps = [
        # (name, applies in, colour space after, function)
        ("01_percentile_stretch", "both", "BGR", step_01_percentile_stretch),
        ("02_random_rotate90", "train", "BGR", lambda x: step_02_random_rotate90(x, t, rng)),
        ("03_random_flip", "train", "BGR", lambda x: step_03_random_flip(x, t, rng)),
        ("04_random_flip", "train", "BGR", lambda x: step_04_random_flip(x, t, rng)),
        ("05_convert_color", "both", "RGB", step_05_convert_color),
        ("06_scale_01", "both", "RGB", step_06_scale_01),
        ("07_to_chw", "both", "RGB", step_07_to_chw),
    ]
    for i, (name, mode, space, fn) in enumerate(steps):
        if i < start or (mode == "train" and not train) or (mode == "inference" and train):
            continue
        img = fn(img)
        if on_step is not None:
            on_step(i, name, space, img)
    return img


_DEFAULT_RNG = np.random.Generator(np.random.PCG64(SEED))


def preprocess(img, mask=None, boxes=None, keypoints=None, train=False, rng=None, on_step=None):
    """Run the pipeline on one image from load_image() (BGR uint8 (H, W, 3)).

    Returns (image, targets). The image is RGB float32 (3, 480, 640) CHW, range ~[0, 1] at inference.
    targets.mask / .boxes / .keypoints follow every geometric step; pass targets.history to
    postprocess_boxes / postprocess_mask / postprocess_keypoints to map predictions back.
    train=True applies train-only steps (augmentations) and skips inference-only ones. Pass one rng
    for a whole run (default: a module-level Generator seeded with SEED).
    """
    rng = _DEFAULT_RNG if rng is None else rng
    t = Targets((img.shape[1], img.shape[0]), mask, boxes, keypoints)
    img = run_steps(img, t, rng, train=train, on_step=on_step)
    return img, t


IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".webp"}


def save_array(path, img, space, npy=False):
    """Save a step result: .png for 8/16-bit HWC images (converted to BGR for viewing), else / also .npy."""
    path = Path(path)
    viewable = img.ndim in (2, 3) and img.dtype in (np.uint8, np.uint16) and (img.ndim == 2 or img.shape[2] in (1, 3, 4))
    if viewable:
        out = img
        if space in ("RGB", "RGBA"):
            out = cv2.cvtColor(img, cv2.COLOR_RGB2BGR if img.shape[2] == 3 else cv2.COLOR_RGBA2BGRA)
        cv2.imencode(".png", out)[1].tofile(str(path.with_suffix(".png")))
    if npy or not viewable:
        np.save(path.with_suffix(".npy"), img)


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the preprocessing pipeline on a folder of images.")
    parser.add_argument("input_dir", type=Path)
    parser.add_argument("output_dir", type=Path)
    parser.add_argument("--train", action="store_true", help="apply train-only steps (augmentations)")
    parser.add_argument("--seed", type=int, default=SEED)
    parser.add_argument("--save-steps", action="store_true", help="also save every intermediate step")
    parser.add_argument("--npy", action="store_true", help="always save exact .npy arrays too")
    args = parser.parse_args()
    rng = np.random.Generator(np.random.PCG64(args.seed))
    args.output_dir.mkdir(parents=True, exist_ok=True)
    files = sorted(p for p in args.input_dir.iterdir() if p.suffix.lower() in IMAGE_EXTS)
    for path in files:
        img = load_image(path)
        on_step = None
        if args.save_steps:
            step_dir = args.output_dir / f"{path.stem}_steps"
            step_dir.mkdir(exist_ok=True)

            def on_step(i, name, space, x, step_dir=step_dir):
                save_array(step_dir / name, x, space, args.npy)

        out, _ = preprocess(img, train=args.train, rng=rng, on_step=on_step)
        save_array(args.output_dir / path.stem, out, "RGB", args.npy)
    print(f"processed {len(files)} image(s) -> {args.output_dir}")


if __name__ == "__main__":
    main()
"
`;

exports[`code generation > preset snapshots > semseg 1`] = `
""""Image preprocessing pipeline "Semantic segmentation" (generated by Modelith Preprocessing Studio).

Steps, with shapes for a 640×480 input:

    input  BGR uint8 (H, W, 3) from load_image()
     1. Resize                    → BGR uint8 (512, 512, 3)
     2. Random flip [train]       → BGR uint8 (512, 512, 3)
     3. Random affine [train]     → BGR uint8 (512, 512, 3)
     4. Convert colour            → RGB uint8 (512, 512, 3)
     5. Standardise (mean / std)  → RGB float32 (512, 512, 3), range ~[-2.12, 2.64]
     6. HWC → CHW                 → RGB float32 (3, 512, 512) CHW, range ~[-2.12, 2.64]

Output (inference): RGB float32 (3, 512, 512) CHW, range ~[-2.12, 2.64]

Usage:
    img = load_image("photo.jpg")
    x, t = preprocess(img)                                   # inference (deterministic)
    x, t = preprocess(img, mask=m, boxes=b, train=True)      # training (augmentations on)
    boxes = postprocess_boxes(pred_boxes, t.history)         # back to original pixels

    python preprocess.py input_dir output_dir [--train] [--seed N] [--save-steps] [--npy]
"""

from __future__ import annotations

import argparse
from pathlib import Path

import cv2
import numpy as np


SEED = 0  # np.random.Generator(np.random.PCG64(SEED)) drives every random step
READ_FLAG = cv2.IMREAD_COLOR

# 1. Resize
RESIZE_INTERP = cv2.INTER_LINEAR
RESIZE_W = 512
RESIZE_H = 512

# 2. Random flip
RANDOM_FLIP_P = 0.5  # probability of applying

# 3. Random affine
RANDOM_AFFINE_DEGREES = 15.0
RANDOM_AFFINE_SCALE = (0.75, 1.25)
RANDOM_AFFINE_TRANSLATE = 0.05  # fraction of width / height
RANDOM_AFFINE_SHEAR = 0.0  # degrees
RANDOM_AFFINE_INTERP = cv2.INTER_LINEAR
RANDOM_AFFINE_BORDER = cv2.BORDER_REFLECT_101
RANDOM_AFFINE_P = 0.7  # probability of applying

# 5. Standardise (mean / std)
STANDARDIZE_MEAN = np.array((0.485, 0.456, 0.406), np.float32)  # ImageNet, RGB order
STANDARDIZE_STD = np.array((0.229, 0.224, 0.225), np.float32)


MIN_BOX_VISIBILITY = 0.1  # boxes keeping less of their area after clipping are dropped

# Pixel-index matrices (OpenCV) ↔ continuous coordinates (pixel edges at integers) used for boxes / keypoints.
_TO_CONT = np.array([[1.0, 0.0, 0.5], [0.0, 1.0, 0.5], [0.0, 0.0, 1.0]])
_FROM_CONT = np.array([[1.0, 0.0, -0.5], [0.0, 1.0, -0.5], [0.0, 0.0, 1.0]])


def _apply_h(H, pts):
    """Apply a 3×3 homography to (N, 2) points."""
    p = np.concatenate([pts, np.ones((len(pts), 1))], axis=1) @ H.T
    return p[:, :2] / p[:, 2:3]


def _box_corners(boxes):
    b = boxes
    return np.stack([b[:, [0, 1]], b[:, [2, 1]], b[:, [2, 3]], b[:, [0, 3]]], axis=1).reshape(-1, 2)


class Targets:
    """Mask, boxes and keypoints that follow the image through geometric steps.

    mask:      (H, W) or (H, W, C) label image, always warped with INTER_NEAREST so class ids stay intact.
    boxes:     (N, 4+) array of x1, y1, x2, y2 in pixels; extra columns (e.g. class ids) are carried along.
    keypoints: (N, 2+) array of x, y in pixels.
    history:   every geometric transform applied, for postprocess_boxes / _mask / _keypoints.
    """

    def __init__(self, image_size, mask=None, boxes=None, keypoints=None):
        self.size = tuple(image_size)  # (width, height)
        self.mask = mask
        self.boxes = np.zeros((0, 4)) if boxes is None else np.asarray(boxes, np.float64).reshape(len(boxes), -1)
        self.keypoints = np.zeros((0, 2)) if keypoints is None else np.asarray(keypoints, np.float64).reshape(len(keypoints), -1)
        self.history = []

    def _points(self, H, dst):
        if len(self.boxes):
            pts = _apply_h(H, _box_corners(self.boxes)).reshape(-1, 4, 2)
            x1, y1 = pts[..., 0].min(1), pts[..., 1].min(1)
            x2, y2 = pts[..., 0].max(1), pts[..., 1].max(1)
            area = (x2 - x1) * (y2 - y1)
            cx1, cx2 = np.clip(x1, 0, dst[0]), np.clip(x2, 0, dst[0])
            cy1, cy2 = np.clip(y1, 0, dst[1]), np.clip(y2, 0, dst[1])
            clipped = (cx2 - cx1) * (cy2 - cy1)
            keep = (area > 0) & (clipped > 0) & (clipped >= MIN_BOX_VISIBILITY * area)
            self.boxes = np.concatenate([np.stack([cx1, cy1, cx2, cy2], 1), self.boxes[:, 4:]], 1)[keep]
        if len(self.keypoints):
            self.keypoints = np.concatenate([_apply_h(H, self.keypoints[:, :2]), self.keypoints[:, 2:]], 1)

    def _record(self, kind, H, dst, arg=None):
        self.history.append({"kind": kind, "H": H, "src": self.size, "dst": tuple(dst), "arg": arg})
        self.size = tuple(dst)

    def resize(self, dst):
        """Follow cv2.resize to dst = (width, height)."""
        if self.mask is not None:
            self.mask = cv2.resize(self.mask, dst, interpolation=cv2.INTER_NEAREST)
        H = np.array([[dst[0] / self.size[0], 0, 0], [0, dst[1] / self.size[1], 0], [0, 0, 1.0]])
        self._points(H, dst)
        self._record("resize", H, dst)

    def warp(self, M, dst):
        """Follow cv2.warpAffine (2×3 M) or cv2.warpPerspective (3×3 M) to dst = (width, height)."""
        M = np.asarray(M, np.float64)
        M3 = np.vstack([M, [0, 0, 1]]) if M.shape[0] == 2 else M
        if self.mask is not None:
            warp = cv2.warpAffine if M.shape[0] == 2 else cv2.warpPerspective
            self.mask = warp(self.mask, M, dst, flags=cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        H = _TO_CONT @ M3 @ _FROM_CONT
        self._points(H, dst)
        self._record("warp", H, dst, M3)

    def flip(self, code):
        """Follow cv2.flip: 1 horizontal, 0 vertical, -1 both."""
        w, h = self.size
        if self.mask is not None:
            self.mask = cv2.flip(self.mask, code)
        fx, fy = code != 0, code != 1
        H = np.array([[-1 if fx else 1, 0, w if fx else 0], [0, -1 if fy else 1, h if fy else 0], [0, 0, 1.0]])
        self._points(H, self.size)
        self._record("flip", H, self.size, code)

    def crop(self, x, y, w, h):
        if self.mask is not None:
            self.mask = self.mask[y : y + h, x : x + w].copy()
        H = np.array([[1, 0, -x], [0, 1, -y], [0, 0, 1.0]])
        self._points(H, (w, h))
        self._record("crop", H, (w, h), (x, y, w, h))

    def pad(self, top, bottom, left, right):
        if self.mask is not None:
            self.mask = cv2.copyMakeBorder(self.mask, top, bottom, left, right, cv2.BORDER_CONSTANT, value=0)
        dst = (self.size[0] + left + right, self.size[1] + top + bottom)
        H = np.array([[1, 0, left], [0, 1, top], [0, 0, 1.0]])
        self._points(H, dst)
        self._record("pad", H, dst, (top, bottom, left, right))

    def rot90(self, k):
        """k quarter turns clockwise (k = 1 is cv2.ROTATE_90_CLOCKWISE)."""
        k %= 4
        if not k:
            return
        w, h = self.size
        if self.mask is not None:
            self.mask = cv2.rotate(self.mask, [None, cv2.ROTATE_90_CLOCKWISE, cv2.ROTATE_180, cv2.ROTATE_90_COUNTERCLOCKWISE][k])
        H = {1: [[0, -1, h], [1, 0, 0]], 2: [[-1, 0, w], [0, -1, h]], 3: [[0, 1, 0], [-1, 0, w]]}[k]
        H = np.array(H + [[0, 0, 1]], np.float64)
        dst = (w, h) if k == 2 else (h, w)
        self._points(H, dst)
        self._record("rot90", H, dst, k)

    def remap(self, map_x, map_y):
        """Follow cv2.remap (elastic / grid / optical distortion). Not invertible by postprocess_*."""
        dh, dw = map_x.shape[:2]
        if self.mask is not None:
            self.mask = cv2.remap(self.mask, map_x, map_y, cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        flat_x, flat_y = map_x.ravel() + 0.5, map_y.ravel() + 0.5

        def nearest(pts):
            idx = [int(np.argmin((flat_x - x) ** 2 + (flat_y - y) ** 2)) for x, y in pts]
            return np.array([[i % dw + 0.5, i // dw + 0.5] for i in idx]).reshape(-1, 2)

        if len(self.keypoints):
            self.keypoints = np.concatenate([nearest(self.keypoints[:, :2]), self.keypoints[:, 2:]], 1)
        if len(self.boxes):
            pts = nearest(_box_corners(self.boxes)).reshape(-1, 4, 2)
            b = np.stack([pts[..., 0].min(1), pts[..., 1].min(1), pts[..., 0].max(1), pts[..., 1].max(1)], 1)
            keep = (b[:, 2] > b[:, 0]) & (b[:, 3] > b[:, 1])
            self.boxes = np.concatenate([b, self.boxes[:, 4:]], 1)[keep]
        self._record("remap", None, (dw, dh))


def _check_invertible(history):
    if any(r["kind"] == "remap" for r in history):
        raise ValueError("remap-based distortions (elastic / grid / optical) cannot be inverted; use the inference pipeline")


def postprocess_boxes(boxes, history):
    """Map boxes (N, 4+) predicted on the preprocessed image back to original image pixels.

    Undoes letterbox, resize, crop, pad, flips, 90° rotations and warps in reverse order
    (for a letterbox: x_orig = (x - pad_left) / scale).
    """
    _check_invertible(history)
    boxes = np.asarray(boxes, np.float64).reshape(len(boxes), -1)
    for rec in reversed(history):
        if not len(boxes):
            break
        pts = _apply_h(np.linalg.inv(rec["H"]), _box_corners(boxes)).reshape(-1, 4, 2)
        w, h = rec["src"]
        b = np.stack([pts[..., 0].min(1), pts[..., 1].min(1), pts[..., 0].max(1), pts[..., 1].max(1)], 1)
        b[:, [0, 2]] = b[:, [0, 2]].clip(0, w)
        b[:, [1, 3]] = b[:, [1, 3]].clip(0, h)
        boxes = np.concatenate([b, boxes[:, 4:]], 1)
    return boxes


def postprocess_keypoints(keypoints, history):
    """Map keypoints (N, 2+) back to original image pixels."""
    _check_invertible(history)
    kp = np.asarray(keypoints, np.float64).reshape(len(keypoints), -1)
    for rec in reversed(history):
        kp = np.concatenate([_apply_h(np.linalg.inv(rec["H"]), kp[:, :2]), kp[:, 2:]], 1)
    return kp


def postprocess_mask(mask, history, interpolation=cv2.INTER_NEAREST):
    """Map a mask / depth map predicted on the preprocessed image back to the original image size.

    Use interpolation=cv2.INTER_LINEAR for continuous maps such as depth.
    """
    _check_invertible(history)
    for rec in reversed(history):
        kind, arg = rec["kind"], rec["arg"]
        w, h = rec["src"]
        if kind == "resize":
            mask = cv2.resize(mask, (w, h), interpolation=interpolation)
        elif kind == "flip":
            mask = cv2.flip(mask, arg)
        elif kind == "rot90":
            mask = np.ascontiguousarray(np.rot90(mask, arg))  # np.rot90 turns counter-clockwise
        elif kind == "crop":
            x, y, cw, ch = arg
            full = np.zeros((h, w) + mask.shape[2:], mask.dtype)
            full[y : y + ch, x : x + cw] = mask
            mask = full
        elif kind == "pad":
            top, _, left, _ = arg
            mask = mask[top : top + h, left : left + w]
        elif kind == "warp":
            mask = cv2.warpPerspective(mask, np.linalg.inv(arg), (w, h), flags=interpolation)
    return mask


def _uniform(rng, lo, hi):
    """Float in [lo, hi). Built on rng.random() only, so the Studio preview draws the same numbers."""
    return lo + (hi - lo) * rng.random()


def load_image(path):
    """Read an image with cv2 (works with non-ASCII paths): BGR uint8 (H, W, 3)."""
    data = np.fromfile(str(path), dtype=np.uint8)
    img = cv2.imdecode(data, READ_FLAG)
    if img is None:
        raise ValueError(f"cannot decode image: {path}")
    return img


def step_01_resize(img, t):
    """Resize with cv2.resize to an exact size, by a scale factor, or so the shorter / longer side
    has a given length (keeps the aspect ratio).

    in:  BGR uint8 (480, 640, 3)
    out: BGR uint8 (512, 512, 3)
    cv2: cv2.resize(img, (width, height), interpolation=cv2.INTER_*)
    """
    img = cv2.resize(img, (RESIZE_W, RESIZE_H), interpolation=RESIZE_INTERP)  # cv2.resize takes (width, height)
    t.resize((RESIZE_W, RESIZE_H))
    return img


def step_02_random_flip(img, t, rng):
    """Mirror the image with probability p (horizontal is the classic, almost always safe
    augmentation; vertical only where up/down has no meaning: aerial, microscopy).

    in:  BGR uint8 (512, 512, 3)
    out: BGR uint8 (512, 512, 3)
    cv2: cv2.flip(img, 1)
    """
    if rng.random() >= RANDOM_FLIP_P:
        return img
    img = cv2.flip(img, 1)
    t.flip(1)
    return img


def step_03_random_affine(img, t, rng):
    """Random rotation, scale, translation (fraction of the size) and shear in one warp (like
    Albumentations Affine / YOLO 'degrees, scale, translate, shear').

    in:  BGR uint8 (512, 512, 3)
    out: BGR uint8 (512, 512, 3)
    cv2: cv2.warpAffine(img, M, (w, h))
    """
    if rng.random() >= RANDOM_AFFINE_P:
        return img
    h, w = img.shape[:2]
    angle = np.deg2rad(_uniform(rng, -RANDOM_AFFINE_DEGREES, RANDOM_AFFINE_DEGREES))
    s = _uniform(rng, *RANDOM_AFFINE_SCALE)
    tx, ty = _uniform(rng, -RANDOM_AFFINE_TRANSLATE, RANDOM_AFFINE_TRANSLATE) * w, _uniform(rng, -RANDOM_AFFINE_TRANSLATE, RANDOM_AFFINE_TRANSLATE) * h
    sh = np.tan(np.deg2rad(_uniform(rng, -RANDOM_AFFINE_SHEAR, RANDOM_AFFINE_SHEAR)))
    R = s * np.array([[np.cos(angle), np.sin(angle)], [-np.sin(angle), np.cos(angle)]])
    A = R @ np.array([[1.0, sh], [0.0, 1.0]])  # rotate·scale after shear
    c = np.array([(w - 1) / 2, (h - 1) / 2])
    M = np.hstack([A, (c + [tx, ty] - A @ c)[:, None]])
    size = (w, h)
    img = cv2.warpAffine(img, M, size, flags=RANDOM_AFFINE_INTERP, borderMode=RANDOM_AFFINE_BORDER)
    t.warp(M, size)
    return img


def step_04_convert_color(img):
    """Convert between colour spaces with cv2.cvtColor (BGR↔RGB, GRAY, HSV, HLS, LAB, LUV, YCrCb,
    XYZ, BGRA).

    BGR → RGB

    in:  BGR uint8 (512, 512, 3)
    out: RGB uint8 (512, 512, 3)
    cv2: cv2.cvtColor(img, cv2.COLOR_<FROM>2<TO>)
    """
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    # img is now RGB uint8 (512, 512, 3)
    return img


def step_05_standardize(img):
    """Scale pixels to [0, 1] and subtract the per-channel mean, divide by std, giving float32.

    in:  RGB uint8 (512, 512, 3)
    out: RGB float32 (512, 512, 3), range ~[-2.12, 2.64]
    cv2: (img.astype(np.float32) / 255.0 - mean) / std
    """
    img = img.astype(np.float32) / 255.0  # uint8 → [0, 1]
    img = (img - STANDARDIZE_MEAN) / STANDARDIZE_STD
    # img is now RGB float32 (512, 512, 3), range ~[-2.12, 2.64]
    return img


def step_06_to_chw(img):
    """Move channels first, (H, W, C) → (C, H, W), the layout PyTorch models expect.

    in:  RGB float32 (512, 512, 3), range ~[-2.12, 2.64]
    out: RGB float32 (3, 512, 512) CHW, range ~[-2.12, 2.64]
    cv2: np.ascontiguousarray(img.transpose(2, 0, 1))
    """
    img = np.ascontiguousarray(img.transpose(2, 0, 1))
    # img is now RGB float32 (3, 512, 512) CHW, range ~[-2.12, 2.64]
    return img


def run_steps(img, t, rng, train=False, start=0, on_step=None):
    """Apply steps[start:] in order. on_step(index, name, colour_space, img) is called after each step that runs."""
    steps = [
        # (name, applies in, colour space after, function)
        ("01_resize", "both", "BGR", lambda x: step_01_resize(x, t)),
        ("02_random_flip", "train", "BGR", lambda x: step_02_random_flip(x, t, rng)),
        ("03_random_affine", "train", "BGR", lambda x: step_03_random_affine(x, t, rng)),
        ("04_convert_color", "both", "RGB", step_04_convert_color),
        ("05_standardize", "both", "RGB", step_05_standardize),
        ("06_to_chw", "both", "RGB", step_06_to_chw),
    ]
    for i, (name, mode, space, fn) in enumerate(steps):
        if i < start or (mode == "train" and not train) or (mode == "inference" and train):
            continue
        img = fn(img)
        if on_step is not None:
            on_step(i, name, space, img)
    return img


_DEFAULT_RNG = np.random.Generator(np.random.PCG64(SEED))


def preprocess(img, mask=None, boxes=None, keypoints=None, train=False, rng=None, on_step=None):
    """Run the pipeline on one image from load_image() (BGR uint8 (H, W, 3)).

    Returns (image, targets). The image is RGB float32 (3, 512, 512) CHW, range ~[-2.12, 2.64] at inference.
    targets.mask / .boxes / .keypoints follow every geometric step; pass targets.history to
    postprocess_boxes / postprocess_mask / postprocess_keypoints to map predictions back.
    train=True applies train-only steps (augmentations) and skips inference-only ones. Pass one rng
    for a whole run (default: a module-level Generator seeded with SEED).
    """
    rng = _DEFAULT_RNG if rng is None else rng
    t = Targets((img.shape[1], img.shape[0]), mask, boxes, keypoints)
    img = run_steps(img, t, rng, train=train, on_step=on_step)
    return img, t


IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".webp"}


def save_array(path, img, space, npy=False):
    """Save a step result: .png for 8/16-bit HWC images (converted to BGR for viewing), else / also .npy."""
    path = Path(path)
    viewable = img.ndim in (2, 3) and img.dtype in (np.uint8, np.uint16) and (img.ndim == 2 or img.shape[2] in (1, 3, 4))
    if viewable:
        out = img
        if space in ("RGB", "RGBA"):
            out = cv2.cvtColor(img, cv2.COLOR_RGB2BGR if img.shape[2] == 3 else cv2.COLOR_RGBA2BGRA)
        cv2.imencode(".png", out)[1].tofile(str(path.with_suffix(".png")))
    if npy or not viewable:
        np.save(path.with_suffix(".npy"), img)


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the preprocessing pipeline on a folder of images.")
    parser.add_argument("input_dir", type=Path)
    parser.add_argument("output_dir", type=Path)
    parser.add_argument("--train", action="store_true", help="apply train-only steps (augmentations)")
    parser.add_argument("--seed", type=int, default=SEED)
    parser.add_argument("--save-steps", action="store_true", help="also save every intermediate step")
    parser.add_argument("--npy", action="store_true", help="always save exact .npy arrays too")
    args = parser.parse_args()
    rng = np.random.Generator(np.random.PCG64(args.seed))
    args.output_dir.mkdir(parents=True, exist_ok=True)
    files = sorted(p for p in args.input_dir.iterdir() if p.suffix.lower() in IMAGE_EXTS)
    for path in files:
        img = load_image(path)
        on_step = None
        if args.save_steps:
            step_dir = args.output_dir / f"{path.stem}_steps"
            step_dir.mkdir(exist_ok=True)

            def on_step(i, name, space, x, step_dir=step_dir):
                save_array(step_dir / name, x, space, args.npy)

        out, _ = preprocess(img, train=args.train, rng=rng, on_step=on_step)
        save_array(args.output_dir / path.stem, out, "RGB", args.npy)
    print(f"processed {len(files)} image(s) -> {args.output_dir}")


if __name__ == "__main__":
    main()
"
`;

exports[`code generation > preset snapshots > yolo_det 1`] = `
""""Image preprocessing pipeline "YOLO detection" (generated by Modelith Preprocessing Studio).

Steps, with shapes for a 640×480 input:

    input  BGR uint8 (H, W, 3) from load_image()
     1. Letterbox              → BGR uint8 (640, 640, 3)
     2. Colour jitter [train]  → BGR uint8 (640, 640, 3)
     3. Random flip [train]    → BGR uint8 (640, 640, 3)
     4. Random affine [train]  → BGR uint8 (640, 640, 3)
     5. Convert colour         → RGB uint8 (640, 640, 3)
     6. Scale to [0, 1]        → RGB float32 (640, 640, 3), range ~[0, 1]
     7. HWC → CHW              → RGB float32 (3, 640, 640) CHW, range ~[0, 1]

Output (inference): RGB float32 (3, 640, 640) CHW, range ~[0, 1]

Usage:
    img = load_image("photo.jpg")
    x, t = preprocess(img)                                   # inference (deterministic)
    x, t = preprocess(img, mask=m, boxes=b, train=True)      # training (augmentations on)
    boxes = postprocess_boxes(pred_boxes, t.history)         # back to original pixels

    python preprocess.py input_dir output_dir [--train] [--seed N] [--save-steps] [--npy]
"""

from __future__ import annotations

import argparse
from pathlib import Path

import cv2
import numpy as np


SEED = 0  # np.random.Generator(np.random.PCG64(SEED)) drives every random step
READ_FLAG = cv2.IMREAD_COLOR

# 1. Letterbox
LETTERBOX_W = 640
LETTERBOX_H = 640
LETTERBOX_COLOR = (114, 114, 114)  # padding value in the image channel order
LETTERBOX_INTERP = cv2.INTER_LINEAR

# 2. Colour jitter
COLOR_JITTER_BRIGHTNESS = 0.4
COLOR_JITTER_CONTRAST = 0.0
COLOR_JITTER_SATURATION = 0.7
COLOR_JITTER_HUE = 0.015  # fraction of the colour circle

# 3. Random flip
RANDOM_FLIP_P = 0.5  # probability of applying

# 4. Random affine
RANDOM_AFFINE_DEGREES = 0.0
RANDOM_AFFINE_SCALE = (0.5, 1.5)
RANDOM_AFFINE_TRANSLATE = 0.1  # fraction of width / height
RANDOM_AFFINE_SHEAR = 0.0  # degrees
RANDOM_AFFINE_INTERP = cv2.INTER_LINEAR
RANDOM_AFFINE_BORDER = cv2.BORDER_CONSTANT
RANDOM_AFFINE_COLOR = (114, 114, 114)


MIN_BOX_VISIBILITY = 0.1  # boxes keeping less of their area after clipping are dropped

# Pixel-index matrices (OpenCV) ↔ continuous coordinates (pixel edges at integers) used for boxes / keypoints.
_TO_CONT = np.array([[1.0, 0.0, 0.5], [0.0, 1.0, 0.5], [0.0, 0.0, 1.0]])
_FROM_CONT = np.array([[1.0, 0.0, -0.5], [0.0, 1.0, -0.5], [0.0, 0.0, 1.0]])


def _apply_h(H, pts):
    """Apply a 3×3 homography to (N, 2) points."""
    p = np.concatenate([pts, np.ones((len(pts), 1))], axis=1) @ H.T
    return p[:, :2] / p[:, 2:3]


def _box_corners(boxes):
    b = boxes
    return np.stack([b[:, [0, 1]], b[:, [2, 1]], b[:, [2, 3]], b[:, [0, 3]]], axis=1).reshape(-1, 2)


class Targets:
    """Mask, boxes and keypoints that follow the image through geometric steps.

    mask:      (H, W) or (H, W, C) label image, always warped with INTER_NEAREST so class ids stay intact.
    boxes:     (N, 4+) array of x1, y1, x2, y2 in pixels; extra columns (e.g. class ids) are carried along.
    keypoints: (N, 2+) array of x, y in pixels.
    history:   every geometric transform applied, for postprocess_boxes / _mask / _keypoints.
    """

    def __init__(self, image_size, mask=None, boxes=None, keypoints=None):
        self.size = tuple(image_size)  # (width, height)
        self.mask = mask
        self.boxes = np.zeros((0, 4)) if boxes is None else np.asarray(boxes, np.float64).reshape(len(boxes), -1)
        self.keypoints = np.zeros((0, 2)) if keypoints is None else np.asarray(keypoints, np.float64).reshape(len(keypoints), -1)
        self.history = []

    def _points(self, H, dst):
        if len(self.boxes):
            pts = _apply_h(H, _box_corners(self.boxes)).reshape(-1, 4, 2)
            x1, y1 = pts[..., 0].min(1), pts[..., 1].min(1)
            x2, y2 = pts[..., 0].max(1), pts[..., 1].max(1)
            area = (x2 - x1) * (y2 - y1)
            cx1, cx2 = np.clip(x1, 0, dst[0]), np.clip(x2, 0, dst[0])
            cy1, cy2 = np.clip(y1, 0, dst[1]), np.clip(y2, 0, dst[1])
            clipped = (cx2 - cx1) * (cy2 - cy1)
            keep = (area > 0) & (clipped > 0) & (clipped >= MIN_BOX_VISIBILITY * area)
            self.boxes = np.concatenate([np.stack([cx1, cy1, cx2, cy2], 1), self.boxes[:, 4:]], 1)[keep]
        if len(self.keypoints):
            self.keypoints = np.concatenate([_apply_h(H, self.keypoints[:, :2]), self.keypoints[:, 2:]], 1)

    def _record(self, kind, H, dst, arg=None):
        self.history.append({"kind": kind, "H": H, "src": self.size, "dst": tuple(dst), "arg": arg})
        self.size = tuple(dst)

    def resize(self, dst):
        """Follow cv2.resize to dst = (width, height)."""
        if self.mask is not None:
            self.mask = cv2.resize(self.mask, dst, interpolation=cv2.INTER_NEAREST)
        H = np.array([[dst[0] / self.size[0], 0, 0], [0, dst[1] / self.size[1], 0], [0, 0, 1.0]])
        self._points(H, dst)
        self._record("resize", H, dst)

    def warp(self, M, dst):
        """Follow cv2.warpAffine (2×3 M) or cv2.warpPerspective (3×3 M) to dst = (width, height)."""
        M = np.asarray(M, np.float64)
        M3 = np.vstack([M, [0, 0, 1]]) if M.shape[0] == 2 else M
        if self.mask is not None:
            warp = cv2.warpAffine if M.shape[0] == 2 else cv2.warpPerspective
            self.mask = warp(self.mask, M, dst, flags=cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        H = _TO_CONT @ M3 @ _FROM_CONT
        self._points(H, dst)
        self._record("warp", H, dst, M3)

    def flip(self, code):
        """Follow cv2.flip: 1 horizontal, 0 vertical, -1 both."""
        w, h = self.size
        if self.mask is not None:
            self.mask = cv2.flip(self.mask, code)
        fx, fy = code != 0, code != 1
        H = np.array([[-1 if fx else 1, 0, w if fx else 0], [0, -1 if fy else 1, h if fy else 0], [0, 0, 1.0]])
        self._points(H, self.size)
        self._record("flip", H, self.size, code)

    def crop(self, x, y, w, h):
        if self.mask is not None:
            self.mask = self.mask[y : y + h, x : x + w].copy()
        H = np.array([[1, 0, -x], [0, 1, -y], [0, 0, 1.0]])
        self._points(H, (w, h))
        self._record("crop", H, (w, h), (x, y, w, h))

    def pad(self, top, bottom, left, right):
        if self.mask is not None:
            self.mask = cv2.copyMakeBorder(self.mask, top, bottom, left, right, cv2.BORDER_CONSTANT, value=0)
        dst = (self.size[0] + left + right, self.size[1] + top + bottom)
        H = np.array([[1, 0, left], [0, 1, top], [0, 0, 1.0]])
        self._points(H, dst)
        self._record("pad", H, dst, (top, bottom, left, right))

    def rot90(self, k):
        """k quarter turns clockwise (k = 1 is cv2.ROTATE_90_CLOCKWISE)."""
        k %= 4
        if not k:
            return
        w, h = self.size
        if self.mask is not None:
            self.mask = cv2.rotate(self.mask, [None, cv2.ROTATE_90_CLOCKWISE, cv2.ROTATE_180, cv2.ROTATE_90_COUNTERCLOCKWISE][k])
        H = {1: [[0, -1, h], [1, 0, 0]], 2: [[-1, 0, w], [0, -1, h]], 3: [[0, 1, 0], [-1, 0, w]]}[k]
        H = np.array(H + [[0, 0, 1]], np.float64)
        dst = (w, h) if k == 2 else (h, w)
        self._points(H, dst)
        self._record("rot90", H, dst, k)

    def remap(self, map_x, map_y):
        """Follow cv2.remap (elastic / grid / optical distortion). Not invertible by postprocess_*."""
        dh, dw = map_x.shape[:2]
        if self.mask is not None:
            self.mask = cv2.remap(self.mask, map_x, map_y, cv2.INTER_NEAREST, borderMode=cv2.BORDER_CONSTANT, borderValue=0)
        flat_x, flat_y = map_x.ravel() + 0.5, map_y.ravel() + 0.5

        def nearest(pts):
            idx = [int(np.argmin((flat_x - x) ** 2 + (flat_y - y) ** 2)) for x, y in pts]
            return np.array([[i % dw + 0.5, i // dw + 0.5] for i in idx]).reshape(-1, 2)

        if len(self.keypoints):
            self.keypoints = np.concatenate([nearest(self.keypoints[:, :2]), self.keypoints[:, 2:]], 1)
        if len(self.boxes):
            pts = nearest(_box_corners(self.boxes)).reshape(-1, 4, 2)
            b = np.stack([pts[..., 0].min(1), pts[..., 1].min(1), pts[..., 0].max(1), pts[..., 1].max(1)], 1)
            keep = (b[:, 2] > b[:, 0]) & (b[:, 3] > b[:, 1])
            self.boxes = np.concatenate([b, self.boxes[:, 4:]], 1)[keep]
        self._record("remap", None, (dw, dh))


def _check_invertible(history):
    if any(r["kind"] == "remap" for r in history):
        raise ValueError("remap-based distortions (elastic / grid / optical) cannot be inverted; use the inference pipeline")


def postprocess_boxes(boxes, history):
    """Map boxes (N, 4+) predicted on the preprocessed image back to original image pixels.

    Undoes letterbox, resize, crop, pad, flips, 90° rotations and warps in reverse order
    (for a letterbox: x_orig = (x - pad_left) / scale).
    """
    _check_invertible(history)
    boxes = np.asarray(boxes, np.float64).reshape(len(boxes), -1)
    for rec in reversed(history):
        if not len(boxes):
            break
        pts = _apply_h(np.linalg.inv(rec["H"]), _box_corners(boxes)).reshape(-1, 4, 2)
        w, h = rec["src"]
        b = np.stack([pts[..., 0].min(1), pts[..., 1].min(1), pts[..., 0].max(1), pts[..., 1].max(1)], 1)
        b[:, [0, 2]] = b[:, [0, 2]].clip(0, w)
        b[:, [1, 3]] = b[:, [1, 3]].clip(0, h)
        boxes = np.concatenate([b, boxes[:, 4:]], 1)
    return boxes


def postprocess_keypoints(keypoints, history):
    """Map keypoints (N, 2+) back to original image pixels."""
    _check_invertible(history)
    kp = np.asarray(keypoints, np.float64).reshape(len(keypoints), -1)
    for rec in reversed(history):
        kp = np.concatenate([_apply_h(np.linalg.inv(rec["H"]), kp[:, :2]), kp[:, 2:]], 1)
    return kp


def postprocess_mask(mask, history, interpolation=cv2.INTER_NEAREST):
    """Map a mask / depth map predicted on the preprocessed image back to the original image size.

    Use interpolation=cv2.INTER_LINEAR for continuous maps such as depth.
    """
    _check_invertible(history)
    for rec in reversed(history):
        kind, arg = rec["kind"], rec["arg"]
        w, h = rec["src"]
        if kind == "resize":
            mask = cv2.resize(mask, (w, h), interpolation=interpolation)
        elif kind == "flip":
            mask = cv2.flip(mask, arg)
        elif kind == "rot90":
            mask = np.ascontiguousarray(np.rot90(mask, arg))  # np.rot90 turns counter-clockwise
        elif kind == "crop":
            x, y, cw, ch = arg
            full = np.zeros((h, w) + mask.shape[2:], mask.dtype)
            full[y : y + ch, x : x + cw] = mask
            mask = full
        elif kind == "pad":
            top, _, left, _ = arg
            mask = mask[top : top + h, left : left + w]
        elif kind == "warp":
            mask = cv2.warpPerspective(mask, np.linalg.inv(arg), (w, h), flags=interpolation)
    return mask


def _uniform(rng, lo, hi):
    """Float in [lo, hi). Built on rng.random() only, so the Studio preview draws the same numbers."""
    return lo + (hi - lo) * rng.random()


def _saturate(x, dtype):
    """Round and clip a float array into an integer dtype (what OpenCV's saturate_cast does)."""
    info = np.iinfo(dtype)
    return np.clip(np.rint(x), info.min, info.max).astype(dtype)


def load_image(path):
    """Read an image with cv2 (works with non-ASCII paths): BGR uint8 (H, W, 3)."""
    data = np.fromfile(str(path), dtype=np.uint8)
    img = cv2.imdecode(data, READ_FLAG)
    if img is None:
        raise ValueError(f"cannot decode image: {path}")
    return img


def step_01_letterbox(img, t):
    """Resize keeping the aspect ratio, then pad to the target size with a constant colour (YOLO
    style; 114 grey by default).

    in:  BGR uint8 (480, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: cv2.resize + cv2.copyMakeBorder(..., cv2.BORDER_CONSTANT)
    """
    h, w = img.shape[:2]
    scale = min(LETTERBOX_W / w, LETTERBOX_H / h)
    nw, nh = int(w * scale + 0.5), int(h * scale + 0.5)
    if (nw, nh) != (w, h):
        img = cv2.resize(img, (nw, nh), interpolation=LETTERBOX_INTERP)  # (width, height)
        t.resize((nw, nh))
    top, left = (LETTERBOX_H - nh) // 2, (LETTERBOX_W - nw) // 2
    bottom, right = LETTERBOX_H - nh - top, LETTERBOX_W - nw - left
    img = cv2.copyMakeBorder(img, top, bottom, left, right, cv2.BORDER_CONSTANT, value=LETTERBOX_COLOR)
    t.pad(top, bottom, left, right)  # postprocess_boxes: x_orig = (x - left) / scale
    return img


def step_02_color_jitter(img, rng):
    """Random brightness, contrast, saturation and hue (torchvision ColorJitter semantics, fixed
    order): factors are drawn from [1 − x, 1 + x] (hue: a shift of ±x of the colour circle).

    in:  BGR uint8 (640, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: img * b → (img − mean) * c + mean → img * s + gray * (1 − s) → HSV hue shift
    """
    b = _uniform(rng, 1 - COLOR_JITTER_BRIGHTNESS, 1 + COLOR_JITTER_BRIGHTNESS)
    c = _uniform(rng, 1 - COLOR_JITTER_CONTRAST, 1 + COLOR_JITTER_CONTRAST)
    s = _uniform(rng, 1 - COLOR_JITTER_SATURATION, 1 + COLOR_JITTER_SATURATION)
    hue = _uniform(rng, -COLOR_JITTER_HUE, COLOR_JITTER_HUE)
    img = _saturate(img * b, np.uint8)  # brightness
    mean = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY).mean()
    img = _saturate((img - mean) * c + mean, np.uint8)  # contrast
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)[..., None]
    img = _saturate(img * s + gray * (1 - s), np.uint8)  # saturation
    shift = int(np.rint(hue * 180))  # OpenCV hue units (0..179)
    if shift:
        hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)
        hsv[..., 0] = ((hsv[..., 0].astype(np.int16) + shift) % 180).astype(np.uint8)
        img = cv2.cvtColor(hsv, cv2.COLOR_HSV2BGR)
    return img


def step_03_random_flip(img, t, rng):
    """Mirror the image with probability p (horizontal is the classic, almost always safe
    augmentation; vertical only where up/down has no meaning: aerial, microscopy).

    in:  BGR uint8 (640, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: cv2.flip(img, 1)
    """
    if rng.random() >= RANDOM_FLIP_P:
        return img
    img = cv2.flip(img, 1)
    t.flip(1)
    return img


def step_04_random_affine(img, t, rng):
    """Random rotation, scale, translation (fraction of the size) and shear in one warp (like
    Albumentations Affine / YOLO 'degrees, scale, translate, shear').

    in:  BGR uint8 (640, 640, 3)
    out: BGR uint8 (640, 640, 3)
    cv2: cv2.warpAffine(img, M, (w, h))
    """
    h, w = img.shape[:2]
    angle = np.deg2rad(_uniform(rng, -RANDOM_AFFINE_DEGREES, RANDOM_AFFINE_DEGREES))
    s = _uniform(rng, *RANDOM_AFFINE_SCALE)
    tx, ty = _uniform(rng, -RANDOM_AFFINE_TRANSLATE, RANDOM_AFFINE_TRANSLATE) * w, _uniform(rng, -RANDOM_AFFINE_TRANSLATE, RANDOM_AFFINE_TRANSLATE) * h
    sh = np.tan(np.deg2rad(_uniform(rng, -RANDOM_AFFINE_SHEAR, RANDOM_AFFINE_SHEAR)))
    R = s * np.array([[np.cos(angle), np.sin(angle)], [-np.sin(angle), np.cos(angle)]])
    A = R @ np.array([[1.0, sh], [0.0, 1.0]])  # rotate·scale after shear
    c = np.array([(w - 1) / 2, (h - 1) / 2])
    M = np.hstack([A, (c + [tx, ty] - A @ c)[:, None]])
    size = (w, h)
    img = cv2.warpAffine(img, M, size, flags=RANDOM_AFFINE_INTERP, borderMode=RANDOM_AFFINE_BORDER, borderValue=RANDOM_AFFINE_COLOR)
    t.warp(M, size)
    return img


def step_05_convert_color(img):
    """Convert between colour spaces with cv2.cvtColor (BGR↔RGB, GRAY, HSV, HLS, LAB, LUV, YCrCb,
    XYZ, BGRA).

    BGR → RGB

    in:  BGR uint8 (640, 640, 3)
    out: RGB uint8 (640, 640, 3)
    cv2: cv2.cvtColor(img, cv2.COLOR_<FROM>2<TO>)
    """
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    # img is now RGB uint8 (640, 640, 3)
    return img


def step_06_scale_01(img):
    """Divide by the dtype maximum (255 for uint8, 65535 for uint16) to get float32 in [0, 1],
    without mean / std normalisation.

    in:  RGB uint8 (640, 640, 3)
    out: RGB float32 (640, 640, 3), range ~[0, 1]
    cv2: img.astype(np.float32) / 255.0
    """
    img = img.astype(np.float32) / 255.0
    # img is now RGB float32 (640, 640, 3), range ~[0, 1]
    return img


def step_07_to_chw(img):
    """Move channels first, (H, W, C) → (C, H, W), the layout PyTorch models expect.

    in:  RGB float32 (640, 640, 3), range ~[0, 1]
    out: RGB float32 (3, 640, 640) CHW, range ~[0, 1]
    cv2: np.ascontiguousarray(img.transpose(2, 0, 1))
    """
    img = np.ascontiguousarray(img.transpose(2, 0, 1))
    # img is now RGB float32 (3, 640, 640) CHW, range ~[0, 1]
    return img


def run_steps(img, t, rng, train=False, start=0, on_step=None):
    """Apply steps[start:] in order. on_step(index, name, colour_space, img) is called after each step that runs."""
    steps = [
        # (name, applies in, colour space after, function)
        ("01_letterbox", "both", "BGR", lambda x: step_01_letterbox(x, t)),
        ("02_color_jitter", "train", "BGR", lambda x: step_02_color_jitter(x, rng)),
        ("03_random_flip", "train", "BGR", lambda x: step_03_random_flip(x, t, rng)),
        ("04_random_affine", "train", "BGR", lambda x: step_04_random_affine(x, t, rng)),
        ("05_convert_color", "both", "RGB", step_05_convert_color),
        ("06_scale_01", "both", "RGB", step_06_scale_01),
        ("07_to_chw", "both", "RGB", step_07_to_chw),
    ]
    for i, (name, mode, space, fn) in enumerate(steps):
        if i < start or (mode == "train" and not train) or (mode == "inference" and train):
            continue
        img = fn(img)
        if on_step is not None:
            on_step(i, name, space, img)
    return img


_DEFAULT_RNG = np.random.Generator(np.random.PCG64(SEED))


def preprocess(img, mask=None, boxes=None, keypoints=None, train=False, rng=None, on_step=None):
    """Run the pipeline on one image from load_image() (BGR uint8 (H, W, 3)).

    Returns (image, targets). The image is RGB float32 (3, 640, 640) CHW, range ~[0, 1] at inference.
    targets.mask / .boxes / .keypoints follow every geometric step; pass targets.history to
    postprocess_boxes / postprocess_mask / postprocess_keypoints to map predictions back.
    train=True applies train-only steps (augmentations) and skips inference-only ones. Pass one rng
    for a whole run (default: a module-level Generator seeded with SEED).
    """
    rng = _DEFAULT_RNG if rng is None else rng
    t = Targets((img.shape[1], img.shape[0]), mask, boxes, keypoints)
    img = run_steps(img, t, rng, train=train, on_step=on_step)
    return img, t


IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".webp"}


def save_array(path, img, space, npy=False):
    """Save a step result: .png for 8/16-bit HWC images (converted to BGR for viewing), else / also .npy."""
    path = Path(path)
    viewable = img.ndim in (2, 3) and img.dtype in (np.uint8, np.uint16) and (img.ndim == 2 or img.shape[2] in (1, 3, 4))
    if viewable:
        out = img
        if space in ("RGB", "RGBA"):
            out = cv2.cvtColor(img, cv2.COLOR_RGB2BGR if img.shape[2] == 3 else cv2.COLOR_RGBA2BGRA)
        cv2.imencode(".png", out)[1].tofile(str(path.with_suffix(".png")))
    if npy or not viewable:
        np.save(path.with_suffix(".npy"), img)


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the preprocessing pipeline on a folder of images.")
    parser.add_argument("input_dir", type=Path)
    parser.add_argument("output_dir", type=Path)
    parser.add_argument("--train", action="store_true", help="apply train-only steps (augmentations)")
    parser.add_argument("--seed", type=int, default=SEED)
    parser.add_argument("--save-steps", action="store_true", help="also save every intermediate step")
    parser.add_argument("--npy", action="store_true", help="always save exact .npy arrays too")
    args = parser.parse_args()
    rng = np.random.Generator(np.random.PCG64(args.seed))
    args.output_dir.mkdir(parents=True, exist_ok=True)
    files = sorted(p for p in args.input_dir.iterdir() if p.suffix.lower() in IMAGE_EXTS)
    for path in files:
        img = load_image(path)
        on_step = None
        if args.save_steps:
            step_dir = args.output_dir / f"{path.stem}_steps"
            step_dir.mkdir(exist_ok=True)

            def on_step(i, name, space, x, step_dir=step_dir):
                save_array(step_dir / name, x, space, args.npy)

        out, _ = preprocess(img, train=args.train, rng=rng, on_step=on_step)
        save_array(args.output_dir / path.stem, out, "RGB", args.npy)
    print(f"processed {len(files)} image(s) -> {args.output_dir}")


if __name__ == "__main__":
    main()
"
`;
