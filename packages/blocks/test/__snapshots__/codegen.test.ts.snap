exports[`codegen snapshots > tabular-mlp / pytorch > model.py 1`] = `
""""Tabular MLP — PyTorch model generated by Netloom.

Inputs:
    features: (B, 32)  # vector 32
Outputs:
    regressor: 1 value (regression)
Parameters: 42.0K (41,985)
FLOPs: ~0.00 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
from torch import nn


CONFIG = {
    "inputs": {
        "features": {
            "kind": "tabular",
            "features": 32,
        },
    },
    "heads": {
        "regressor": {
            "task": "regression",
            "output_shape": [1],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """Tabular MLP.

    forward(features) returns the regressor output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: fc_1 → vector 256
        self.fc_1 = nn.Linear(32, 256)
        # node: ln → vector 256
        self.ln = nn.LayerNorm(256, eps=1e-6)
        # node: act_1 → vector 256
        self.act_1 = nn.GELU()
        # node: drop → vector 256
        self.drop = nn.Dropout(0.1)
        # node: fc_2 → vector 128
        self.fc_2 = nn.Linear(256, 128)
        # node: act_2 → vector 128
        self.act_2 = nn.GELU()
        # node: regressor → 1 value
        self.regressor = ClassificationHead(128, 1)

    def forward(self, features: torch.Tensor) -> torch.Tensor:
        fc_1 = self.fc_1(features)
        ln = self.ln(fc_1)
        act_1 = self.act_1(ln)
        drop = self.drop(act_1)
        fc_2 = self.fc_2(drop)
        act_2 = self.act_2(fc_2)
        regressor = self.regressor(act_2)
        return regressor


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "features": torch.randn(batch_size, 32),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"regressor": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > tabular-mlp / pytorch > train.py 1`] = `
""""Train Tabular MLP (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "regressor": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["features"]: float32 (32,) standardised features
    targets["regressor"]: float tensor (1,) of (standardised) targets
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "features": torch.randn(32),
        }
        targets = {
            "regressor": torch.randn(1),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "regressor": nn.MSELoss(),
        }
    )


class RMSE:
    """Root-mean-square error."""

    def __init__(self) -> None:
        self.sq = self.total = 0.0

    def update(self, pred: torch.Tensor, target: torch.Tensor) -> None:
        self.sq += ((pred.float() - target.float()) ** 2).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        return {"rmse": math.sqrt(self.sq / max(1, self.total))}


def build_metrics() -> dict:
    return {
        "regressor": RMSE(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"regressor": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"regressor": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > tabular-mlp / tensorflow > model.py 1`] = `
""""Tabular MLP — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    features: (B, 32)  # vector 32
Outputs:
    regressor: 1 value (regression)
Parameters: 42.0K (41,985)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "features": "(None, 32)",
    },
    "heads": {
        "regressor": {
            "task": "regression",
        },
    },
}


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    features = keras.Input(shape=(32,), name="features")
    # node: fc_1 → vector 256
    fc_1 = layers.Dense(256, use_bias=True, name="fc_1")(features)
    # node: ln → vector 256
    ln = layers.LayerNormalization(epsilon=1e-6, name="ln")(fc_1)
    # node: act_1 → vector 256
    act_1 = layers.Activation("gelu", name="act_1")(ln)
    # node: drop → vector 256
    drop = layers.Dropout(0.1, name="drop")(act_1)
    # node: fc_2 → vector 128
    fc_2 = layers.Dense(128, use_bias=True, name="fc_2")(drop)
    # node: act_2 → vector 128
    act_2 = layers.Activation("gelu", name="act_2")(fc_2)
    # node: regressor → 1 value
    regressor = layers.Dense(1, name="regressor")(act_2)
    return keras.Model(inputs={"features": features}, outputs=regressor, name="Tabular_MLP")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "features": np.random.rand(batch_size, 32).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"regressor": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > tabular-mlp / tensorflow > train.py 1`] = `
""""Train Tabular MLP with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    features: (N, 32)
    regressor: float tensor (1,) of (standardised) targets
    """
    inputs = {
        "features": np.random.rand(n, 32).astype("float32"),
    }
    targets = np.random.randn(n, 1).astype("float32")
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.MeanSquaredError(),
        metrics=[keras.metrics.RootMeanSquaredError()],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > unet / pytorch > model.py 1`] = `
""""U-Net — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 128, 128)  # image 3×128×128
Outputs:
    seg_head: 2×128×128 mask (segmentation)
Parameters: 31.04M (31,037,698)
FLOPs: ~24.12 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 128, 128],
            "norm": "0-1",
        },
    },
    "heads": {
        "seg_head": {
            "task": "segmentation",
            "classes": 2,
            "output_shape": [2, 128, 128],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class DoubleConv(nn.Module):
    """(3×3 Conv → BN → ReLU) × 2, the U-Net building block.

    Paper: U-Net, Ronneberger et al. 2015 (arXiv:1505.04597).
    """

    def __init__(self, c_in: int, c_out: int, c_mid: int | None = None) -> None:
        super().__init__()
        c_mid = c_mid or c_out
        self.conv1 = ConvBNAct(c_in, c_mid, 3, act="relu")
        self.conv2 = ConvBNAct(c_mid, c_out, 3, act="relu")

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.conv2(self.conv1(x))


class SegmentationHead(nn.Module):
    """3×3 Conv·BN·ReLU → 1×1 classifier → bilinear upsample to the input resolution."""

    def __init__(self, c_in: int, num_classes: int, hidden: int, size: tuple[int, int]) -> None:
        super().__init__()
        self.size = size
        self.conv = ConvBNAct(c_in, hidden, 3, act="relu") if hidden > 0 else nn.Identity()
        self.cls = nn.Conv2d(hidden if hidden > 0 else c_in, num_classes, 1)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.cls(self.conv(x))
        return F.interpolate(x, size=self.size, mode="bilinear", align_corners=False)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """U-Net.

    forward(image) returns the seg_head output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: enc1 → image 64×128×128
        self.enc1 = DoubleConv(3, 64)
        # node: maxpool_1 → image 64×64×64
        self.maxpool_1 = nn.MaxPool2d(kernel_size=2, stride=2)
        # node: enc2 → image 128×64×64
        self.enc2 = DoubleConv(64, 128)
        # node: maxpool_2 → image 128×32×32
        self.maxpool_2 = nn.MaxPool2d(kernel_size=2, stride=2)
        # node: enc3 → image 256×32×32
        self.enc3 = DoubleConv(128, 256)
        # node: maxpool_3 → image 256×16×16
        self.maxpool_3 = nn.MaxPool2d(kernel_size=2, stride=2)
        # node: enc4 → image 512×16×16
        self.enc4 = DoubleConv(256, 512)
        # node: maxpool_4 → image 512×8×8
        self.maxpool_4 = nn.MaxPool2d(kernel_size=2, stride=2)
        # node: bottleneck → image 1024×8×8
        self.bottleneck = DoubleConv(512, 1024)
        # node: up4 → image 512×16×16
        self.up4 = nn.ConvTranspose2d(1024, 512, kernel_size=2, stride=2, padding=0, bias=True)
        # node: dec4 → image 512×16×16
        self.dec4 = DoubleConv(1024, 512)
        # node: up3 → image 256×32×32
        self.up3 = nn.ConvTranspose2d(512, 256, kernel_size=2, stride=2, padding=0, bias=True)
        # node: dec3 → image 256×32×32
        self.dec3 = DoubleConv(512, 256)
        # node: up2 → image 128×64×64
        self.up2 = nn.ConvTranspose2d(256, 128, kernel_size=2, stride=2, padding=0, bias=True)
        # node: dec2 → image 128×64×64
        self.dec2 = DoubleConv(256, 128)
        # node: up1 → image 64×128×128
        self.up1 = nn.ConvTranspose2d(128, 64, kernel_size=2, stride=2, padding=0, bias=True)
        # node: dec1 → image 64×128×128
        self.dec1 = DoubleConv(128, 64)
        # node: seg_head → 2×128×128 mask
        self.seg_head = SegmentationHead(64, 2, hidden=0, size=(128, 128))

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        enc1 = self.enc1(image)
        maxpool_1 = self.maxpool_1(enc1)
        enc2 = self.enc2(maxpool_1)
        maxpool_2 = self.maxpool_2(enc2)
        enc3 = self.enc3(maxpool_2)
        maxpool_3 = self.maxpool_3(enc3)
        enc4 = self.enc4(maxpool_3)
        maxpool_4 = self.maxpool_4(enc4)
        bottleneck = self.bottleneck(maxpool_4)
        up4 = self.up4(bottleneck)
        cat_1 = torch.cat([up4, enc4], dim=1)
        dec4 = self.dec4(cat_1)
        up3 = self.up3(dec4)
        cat_2 = torch.cat([up3, enc3], dim=1)
        dec3 = self.dec3(cat_2)
        up2 = self.up2(dec3)
        cat_3 = torch.cat([up2, enc2], dim=1)
        dec2 = self.dec2(cat_3)
        up1 = self.up1(dec2)
        cat_4 = torch.cat([up1, enc1], dim=1)
        dec1 = self.dec1(cat_4)
        seg_head = self.seg_head(dec1)
        return seg_head


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SegmentationLoss(nn.Module):
    """Cross-entropy (BCE for a single class) + soft Dice.

    Paper: V-Net Dice loss, Milletari et al. 2016 (arXiv:1606.04797).
    """

    def __init__(self, num_classes: int, dice_weight: float = 1.0) -> None:
        super().__init__()
        self.num_classes = num_classes
        self.dice_weight = dice_weight

    def forward(self, logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        logits = logits.float()
        if self.num_classes == 1:
            target = target.float()
            base = F.binary_cross_entropy_with_logits(logits, target)
            prob, onehot, dims = logits.sigmoid(), target, (0, 2, 3)
        else:
            base = F.cross_entropy(logits, target)
            prob = logits.softmax(1)
            onehot = F.one_hot(target, self.num_classes).permute(0, 3, 1, 2).float()
            dims = (0, 2, 3)
        inter = (prob * onehot).sum(dims)
        union = prob.sum(dims) + onehot.sum(dims)
        dice = 1.0 - ((2.0 * inter + 1.0) / (union + 1.0)).mean()
        return base + self.dice_weight * dice


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 128, 128),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > unet / pytorch > train.py 1`] = `
""""Train U-Net (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, SegmentationLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 8
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "seg_head": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 128, 128), scaled to [0, 1]
    targets["seg_head"]: int64 mask (128, 128) with class ids in [0, 1]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 128, 128),
        }
        targets = {
            "seg_head": torch.randint(0, 2, (128, 128)),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Segmentation: pair each image with an integer mask PNG of the same size
    (pixel value = class id; for a binary mask use 0/1 and return it as float (1, H, W)),
    e.g. torchvision.datasets.VOCSegmentation("data", image_set="train", download=True).
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "seg_head": SegmentationLoss(2, dice_weight=1.0),
        }
    )


class MeanIoU:
    """Mean intersection-over-union from a running confusion matrix."""

    def __init__(self, num_classes: int) -> None:
        self.n = max(2, num_classes)
        self.confusion = torch.zeros(self.n, self.n, dtype=torch.long)

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if logits.shape[1] == 1:
            pred, target = (logits[:, 0] > 0).long(), target[:, 0].long()
        else:
            pred = logits.argmax(1)
        idx = target.flatten().cpu() * self.n + pred.flatten().cpu()
        self.confusion += torch.bincount(idx, minlength=self.n * self.n).reshape(self.n, self.n)

    def compute(self) -> dict[str, float]:
        inter = self.confusion.diag().float()
        union = self.confusion.sum(0).float() + self.confusion.sum(1).float() - inter
        iou = inter / union.clamp_min(1)
        return {"miou": iou[union > 0].mean().item() if (union > 0).any() else 0.0}


def build_metrics() -> dict:
    return {
        "seg_head": MeanIoU(2),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"seg_head": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > unet / tensorflow > model.py 1`] = `
""""U-Net — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 128, 128, 3)  # image 3×128×128
Outputs:
    seg_head: 2×128×128 mask (segmentation)
Parameters: 31.04M (31,037,698)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 128, 128, 3)",
    },
    "heads": {
        "seg_head": {
            "task": "segmentation",
            "classes": 2,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def activation(name: str, layer_name: str) -> layers.Layer:
    """Activation layer by name ("none" gives an identity)."""
    if name == "leaky_relu":
        return layers.LeakyReLU(negative_slope=0.1, name=layer_name)
    if name == "relu6":
        return layers.ReLU(max_value=6.0, name=layer_name)
    if name == "hardswish":
        return layers.Activation("hard_swish", name=layer_name)
    if name == "none":
        return layers.Identity(name=layer_name)
    return layers.Activation(name, name=layer_name)


def conv_bn_act(x, filters: int, k: int = 3, s: int = 1, d: int = 1, groups: int = 1, act: str = "silu", name: str = "cba"):
    """Conv2D → BatchNormalization → activation with "same" padding (NHWC)."""
    if groups > 1 and groups == x.shape[-1] == filters:
        x = layers.DepthwiseConv2D(k, strides=s, padding="same", dilation_rate=d, use_bias=False, name=f"{name}_dw")(x)
    else:
        x = layers.Conv2D(
            filters, k, strides=s, padding="same", dilation_rate=d, groups=groups, use_bias=False, name=f"{name}_conv"
        )(x)
    x = layers.BatchNormalization(momentum=0.9, epsilon=1e-5, name=f"{name}_bn")(x)
    return activation(act, f"{name}_act")(x)


def double_conv(x, filters: int, mid: int | None = None, name: str = "double_conv"):
    """(3×3 Conv → BN → ReLU) × 2 (U-Net)."""
    x = conv_bn_act(x, mid or filters, 3, act="relu", name=f"{name}_1")
    return conv_bn_act(x, filters, 3, act="relu", name=f"{name}_2")


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(128, 128, 3), name="image")
    # node: enc1 → image 64×128×128
    enc1 = double_conv(image, 64, name="enc1")
    # node: maxpool_1 → image 64×64×64
    maxpool_1 = layers.MaxPooling2D(pool_size=2, strides=2, padding="valid", name="maxpool_1")(enc1)
    # node: enc2 → image 128×64×64
    enc2 = double_conv(maxpool_1, 128, name="enc2")
    # node: maxpool_2 → image 128×32×32
    maxpool_2 = layers.MaxPooling2D(pool_size=2, strides=2, padding="valid", name="maxpool_2")(enc2)
    # node: enc3 → image 256×32×32
    enc3 = double_conv(maxpool_2, 256, name="enc3")
    # node: maxpool_3 → image 256×16×16
    maxpool_3 = layers.MaxPooling2D(pool_size=2, strides=2, padding="valid", name="maxpool_3")(enc3)
    # node: enc4 → image 512×16×16
    enc4 = double_conv(maxpool_3, 512, name="enc4")
    # node: maxpool_4 → image 512×8×8
    maxpool_4 = layers.MaxPooling2D(pool_size=2, strides=2, padding="valid", name="maxpool_4")(enc4)
    # node: bottleneck → image 1024×8×8
    bottleneck = double_conv(maxpool_4, 1024, name="bottleneck")
    # node: up4 → image 512×16×16
    up4 = layers.Conv2DTranspose(512, kernel_size=2, strides=2, padding="valid", use_bias=True, name="up4")(
        bottleneck,
    )
    # node: cat_1 → image 1024×16×16
    cat_1 = layers.Concatenate(axis=-1, name="cat_1")([up4, enc4])
    # node: dec4 → image 512×16×16
    dec4 = double_conv(cat_1, 512, name="dec4")
    # node: up3 → image 256×32×32
    up3 = layers.Conv2DTranspose(256, kernel_size=2, strides=2, padding="valid", use_bias=True, name="up3")(
        dec4,
    )
    # node: cat_2 → image 512×32×32
    cat_2 = layers.Concatenate(axis=-1, name="cat_2")([up3, enc3])
    # node: dec3 → image 256×32×32
    dec3 = double_conv(cat_2, 256, name="dec3")
    # node: up2 → image 128×64×64
    up2 = layers.Conv2DTranspose(128, kernel_size=2, strides=2, padding="valid", use_bias=True, name="up2")(
        dec3,
    )
    # node: cat_3 → image 256×64×64
    cat_3 = layers.Concatenate(axis=-1, name="cat_3")([up2, enc2])
    # node: dec2 → image 128×64×64
    dec2 = double_conv(cat_3, 128, name="dec2")
    # node: up1 → image 64×128×128
    up1 = layers.Conv2DTranspose(64, kernel_size=2, strides=2, padding="valid", use_bias=True, name="up1")(
        dec2,
    )
    # node: cat_4 → image 128×128×128
    cat_4 = layers.Concatenate(axis=-1, name="cat_4")([up1, enc1])
    # node: dec1 → image 64×128×128
    dec1 = double_conv(cat_4, 64, name="dec1")
    # node: seg_head → 2×128×128 mask
    seg_head = layers.Resizing(128, 128, interpolation="bilinear", name="seg_head")(
        layers.Conv2D(2, 1, name="seg_head_cls")(dec1),
    )
    return keras.Model(inputs={"image": image}, outputs=seg_head, name="U_Net")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 128, 128, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > unet / tensorflow > train.py 1`] = `
""""Train U-Net with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 8
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 128, 128, 3)
    seg_head: int64 mask (128, 128) with class ids in [0, 1]
    """
    inputs = {
        "image": np.random.rand(n, 128, 128, 3).astype("float32"),
    }
    targets = np.random.randint(0, 2, size=(n, 128, 128))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=[keras.metrics.MeanIoU(num_classes=2, sparse_y_pred=False)],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > vit-tiny / pytorch > model.py 1`] = `
""""ViT-Tiny/16 — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 224, 224)  # image 3×224×224
Outputs:
    classifier: 1000 classes (classification)
Parameters: 5.72M (5,717,416)
FLOPs: ~2.52 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 224, 224],
            "norm": "imagenet",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 1000,
            "output_shape": [1000],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class PatchEmbed(nn.Module):
    """Split the image into p×p patches, embed each linearly, optionally prepend a [CLS] token.

    Paper: An Image is Worth 16x16 Words (ViT), Dosovitskiy et al. 2021 (arXiv:2010.11929).
    """

    def __init__(self, c_in: int, dim: int, patch: int, cls_token: bool = True) -> None:
        super().__init__()
        self.proj = nn.Conv2d(c_in, dim, patch, stride=patch)
        self.cls_token = nn.Parameter(torch.zeros(1, 1, dim)) if cls_token else None

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.proj(x).flatten(2).transpose(1, 2)
        if self.cls_token is not None:
            x = torch.cat([self.cls_token.expand(x.shape[0], -1, -1), x], dim=1)
        return x


class LearnedPositionalEmbedding(nn.Module):
    """Trainable absolute position embedding added to a (B, L, D) sequence (BERT / ViT)."""

    def __init__(self, length: int, dim: int) -> None:
        super().__init__()
        self.pos = nn.Parameter(torch.zeros(1, length, dim))
        nn.init.trunc_normal_(self.pos, std=0.02)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return x + self.pos


def apply_rope(x: torch.Tensor, base: float = 10000.0) -> torch.Tensor:
    """Rotary position embedding on the last axis of (B, H, N, Dh) queries / keys.

    Paper: RoFormer, Su et al. 2021 (arXiv:2104.09864).
    """
    n, dh = x.shape[-2], x.shape[-1]
    half = dh // 2
    freqs = base ** (-torch.arange(half, device=x.device, dtype=torch.float32) / half)
    angles = torch.arange(n, device=x.device, dtype=torch.float32)[:, None] * freqs[None]
    cos, sin = angles.cos().to(x.dtype), angles.sin().to(x.dtype)
    x1, x2 = x[..., :half], x[..., half : 2 * half]
    rotated = torch.cat([x1 * cos - x2 * sin, x1 * sin + x2 * cos], dim=-1)
    return torch.cat([rotated, x[..., 2 * half :]], dim=-1) if dh % 2 else rotated


class Attention(nn.Module):
    """Multi-head self-attention with fused scaled-dot-product attention and optional RoPE."""

    def __init__(self, dim: int, heads: int, dropout: float = 0.0, rope: bool = False) -> None:
        super().__init__()
        self.heads, self.dropout, self.rope = heads, dropout, rope
        self.qkv = nn.Linear(dim, 3 * dim)
        self.proj = nn.Linear(dim, dim)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        b, n, d = x.shape
        q, k, v = self.qkv(x).reshape(b, n, 3, self.heads, d // self.heads).permute(2, 0, 3, 1, 4)
        if self.rope:
            q, k = apply_rope(q), apply_rope(k)
        x = F.scaled_dot_product_attention(q, k, v, dropout_p=self.dropout if self.training else 0.0)
        return self.proj(x.transpose(1, 2).reshape(b, n, d))


class DropPath(nn.Module):
    """Stochastic depth: randomly drops the whole residual branch per sample.

    Paper: Deep Networks with Stochastic Depth, Huang et al. 2016 (arXiv:1603.09382).
    """

    def __init__(self, p: float = 0.0) -> None:
        super().__init__()
        self.p = p

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.p == 0.0 or not self.training:
            return x
        keep = 1.0 - self.p
        mask = x.new_empty((x.shape[0],) + (1,) * (x.ndim - 1)).bernoulli_(keep)
        return x * mask / keep


class TransformerBlock(nn.Module):
    """Pre-norm encoder block: x + Attention(LN(x)), then x + MLP(LN(x)).

    Papers: Attention Is All You Need (arXiv:1706.03762); ViT (arXiv:2010.11929).
    """

    def __init__(
        self, dim: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, drop_path: float = 0.0, rope: bool = False
    ) -> None:
        super().__init__()
        hidden = int(dim * mlp_ratio)
        self.norm1 = nn.LayerNorm(dim, eps=1e-6)
        self.attn = Attention(dim, heads, dropout, rope)
        self.norm2 = nn.LayerNorm(dim, eps=1e-6)
        self.mlp = nn.Sequential(
            nn.Linear(dim, hidden), nn.GELU(), nn.Dropout(dropout), nn.Linear(hidden, dim), nn.Dropout(dropout)
        )
        self.drop_path = DropPath(drop_path)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x + self.drop_path(self.attn(self.norm1(x)))
        return x + self.drop_path(self.mlp(self.norm2(x)))


class TransformerEncoder(nn.Module):
    """depth × pre-norm TransformerBlock (linearly increasing drop path) + final LayerNorm."""

    def __init__(
        self,
        dim: int,
        depth: int,
        heads: int,
        mlp_ratio: float = 4.0,
        dropout: float = 0.0,
        drop_path: float = 0.0,
        rope: bool = False,
    ) -> None:
        super().__init__()
        rates = [drop_path * i / max(1, depth - 1) for i in range(depth)]
        self.blocks = nn.ModuleList(TransformerBlock(dim, heads, mlp_ratio, dropout, r, rope) for r in rates)
        self.norm = nn.LayerNorm(dim, eps=1e-6)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        for block in self.blocks:
            x = block(x)
        return self.norm(x)


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """ViT-Tiny/16.

    forward(image) returns the classifier output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: patch_embed → sequence 197×192
        self.patch_embed = PatchEmbed(3, 192, 16, cls_token=True)
        # node: pos → sequence 197×192
        self.pos = LearnedPositionalEmbedding(197, 192)
        # node: encoder → sequence 197×192
        self.encoder = TransformerEncoder(192, depth=12, heads=3, drop_path=0.1)
        # node: classifier → 1000 classes
        self.classifier = ClassificationHead(192, 1000)

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        patch_embed = self.patch_embed(image)
        pos = self.pos(patch_embed)
        encoder = self.encoder(pos)
        pooled = encoder[:, 0]
        classifier = self.classifier(pooled)
        return classifier


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 224, 224),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > vit-tiny / pytorch > train.py 1`] = `
""""Train ViT-Tiny/16 (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0003  # transformers prefer a smaller LR
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 224, 224), ImageNet mean/std normalised
    targets["classifier"]: int64 class index in [0, 999]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 224, 224),
        }
        targets = {
            "classifier": torch.randint(0, 1000, ()),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Image classification from class folders (data/train/<class>/*.jpg):

        from torchvision import datasets, transforms
        tf = transforms.Compose([
            transforms.RandomResizedCrop((224, 224)),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize((0.485, 0.456, 0.406), (0.229, 0.224, 0.225)),
        ])
        train = DictDataset(datasets.ImageFolder("data/train", tf), "image", "classifier")
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > vit-tiny / tensorflow > model.py 1`] = `
""""ViT-Tiny/16 — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 224, 224, 3)  # image 3×224×224
Outputs:
    classifier: 1000 classes (classification)
Parameters: 5.72M (5,717,416)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 224, 224, 3)",
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 1000,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class ClassToken(layers.Layer):
    """Prepend a learnable [CLS] token to a (B, N, D) sequence (ViT)."""

    def build(self, input_shape) -> None:
        self.cls = self.add_weight(shape=(1, 1, input_shape[-1]), initializer="zeros", name="cls")

    def call(self, x):
        cls = ops.broadcast_to(self.cls, (ops.shape(x)[0], 1, ops.shape(x)[-1]))
        return ops.concatenate([cls, x], axis=1)


def patch_embed(x, dim: int, patch: int, cls_token: bool = True, name: str = "patch_embed"):
    """Non-overlapping p×p patch embedding (ViT)."""
    x = layers.Conv2D(dim, patch, strides=patch, name=f"{name}_proj")(x)
    x = layers.Reshape((x.shape[1] * x.shape[2], dim), name=f"{name}_flatten")(x)
    return ClassToken(name=f"{name}_cls")(x) if cls_token else x


class PositionEmbedding(layers.Layer):
    """Add learned or fixed sinusoidal position encodings to a (B, L, D) sequence."""

    def __init__(self, mode: str = "learned", **kwargs) -> None:
        super().__init__(**kwargs)
        self.mode = mode

    def build(self, input_shape) -> None:
        length, dim = input_shape[1], input_shape[2]
        if self.mode == "learned":
            init = keras.initializers.TruncatedNormal(stddev=0.02)
            self.pos = self.add_weight(shape=(1, length, dim), initializer=init, name="pos")
            return
        position = np.arange(length)[:, None]
        div = np.exp(np.arange(0, dim, 2) * (-np.log(10000.0) / dim))
        pe = np.zeros((1, length, dim), dtype="float32")
        pe[0, :, 0::2] = np.sin(position * div)
        pe[0, :, 1::2] = np.cos(position * div[: dim // 2])
        self.pos = self.add_weight(shape=pe.shape, initializer=keras.initializers.Constant(pe), trainable=False, name="pos")

    def call(self, x):
        return x + self.pos

    def get_config(self) -> dict:
        return {**super().get_config(), "mode": self.mode}


def transformer_encoder(x, depth: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, name: str = "encoder"):
    """depth × pre-norm transformer block + final LayerNorm (Vaswani 2017; ViT 2021)."""
    dim = x.shape[-1]
    for i in range(depth):
        p = f"{name}_{i}"
        h = layers.LayerNormalization(epsilon=1e-6, name=f"{p}_ln1")(x)
        h = layers.MultiHeadAttention(heads, dim // heads, dropout=dropout, name=f"{p}_attn")(h, h)
        x = layers.Add(name=f"{p}_add1")([x, h])
        h = layers.LayerNormalization(epsilon=1e-6, name=f"{p}_ln2")(x)
        h = layers.Dense(int(dim * mlp_ratio), activation="gelu", name=f"{p}_fc1")(h)
        h = layers.Dropout(dropout, name=f"{p}_drop")(h)
        h = layers.Dense(dim, name=f"{p}_fc2")(h)
        x = layers.Add(name=f"{p}_add2")([x, h])
    return layers.LayerNormalization(epsilon=1e-6, name=f"{name}_ln")(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(224, 224, 3), name="image")
    # node: patch_embed → sequence 197×192
    patch_embed = patch_embed(image, 192, 16, cls_token=True, name="patch_embed")
    # node: pos → sequence 197×192
    pos = PositionEmbedding("learned", name="pos")(patch_embed)
    # node: encoder → sequence 197×192
    encoder = transformer_encoder(pos, depth=12, heads=3, mlp_ratio=4, dropout=0, name="encoder")
    # node: pooled → vector 192
    pooled = encoder[:, 0]
    # node: classifier → 1000 classes
    classifier = layers.Dense(1000, name="classifier")(pooled)
    return keras.Model(inputs={"image": image}, outputs=classifier, name="ViT_Tiny_16")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 224, 224, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > vit-tiny / tensorflow > train.py 1`] = `
""""Train ViT-Tiny/16 with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0003
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 224, 224, 3)
    classifier: int64 class index in [0, 999]
    """
    inputs = {
        "image": np.random.rand(n, 224, 224, 3).astype("float32"),
    }
    targets = np.random.randint(0, 1000, size=(n,))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=["accuracy"],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > yolov8s / pytorch > model.py 1`] = `
""""YOLOv8-s style — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 640, 640)  # image 3×640×640
Outputs:
    yolo: boxes + 80 cls (detection)
Parameters: 11.17M (11,166,544)
FLOPs: ~41.61 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import math

import torch
import torch.nn.functional as F
from torch import nn
import torchvision


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 640, 640],
            "norm": "0-1",
        },
    },
    "heads": {
        "yolo": {
            "task": "detection",
            "classes": 80,
            "output_shape": [80],
            "strides": [8, 16, 32],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class YoloBottleneck(nn.Module):
    """Two 3×3 Conv·BN·SiLU with an optional residual (YOLOv5 / YOLOv8)."""

    def __init__(self, c: int, shortcut: bool = True) -> None:
        super().__init__()
        self.cv1 = ConvBNAct(c, c, 3)
        self.cv2 = ConvBNAct(c, c, 3)
        self.add = shortcut

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        y = self.cv2(self.cv1(x))
        return x + y if self.add else y


class C2f(nn.Module):
    """CSP bottleneck with two convolutions: split, n bottlenecks, concatenate every partial output.

    Reference: Ultralytics YOLOv8 (2023).
    """

    def __init__(self, c_in: int, c_out: int, n: int = 1, shortcut: bool = True, e: float = 0.5) -> None:
        super().__init__()
        self.c = int(c_out * e)
        self.cv1 = ConvBNAct(c_in, 2 * self.c, 1)
        self.cv2 = ConvBNAct((2 + n) * self.c, c_out, 1)
        self.m = nn.ModuleList(YoloBottleneck(self.c, shortcut) for _ in range(n))

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        y = list(self.cv1(x).chunk(2, dim=1))
        for m in self.m:
            y.append(m(y[-1]))
        return self.cv2(torch.cat(y, dim=1))


class SPPF(nn.Module):
    """Spatial pyramid pooling (fast): three chained k×k max-pools, concatenated (YOLOv5 / YOLOv8)."""

    def __init__(self, c_in: int, c_out: int, k: int = 5) -> None:
        super().__init__()
        c = c_in // 2
        self.cv1 = ConvBNAct(c_in, c, 1)
        self.cv2 = ConvBNAct(4 * c, c_out, 1)
        self.pool = nn.MaxPool2d(k, stride=1, padding=k // 2)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        y = [self.cv1(x)]
        for _ in range(3):
            y.append(self.pool(y[-1]))
        return self.cv2(torch.cat(y, dim=1))


class PAN(nn.Module):
    """YOLOv8 PAN-FPN neck: top-down then bottom-up paths fused with C2f blocks (P3, P4, P5).

    Papers: PANet, Liu et al. 2018 (arXiv:1803.01534); Ultralytics YOLOv8.
    """

    def __init__(self, in_channels: list[int], n: int = 1) -> None:
        super().__init__()
        c3, c4, c5 = in_channels
        self.td4 = C2f(c5 + c4, c4, n, shortcut=False)
        self.td3 = C2f(c4 + c3, c3, n, shortcut=False)
        self.down3 = ConvBNAct(c3, c3, 3, 2)
        self.bu4 = C2f(c3 + c4, c4, n, shortcut=False)
        self.down4 = ConvBNAct(c4, c4, 3, 2)
        self.bu5 = C2f(c4 + c5, c5, n, shortcut=False)

    @staticmethod
    def up(x: torch.Tensor, like: torch.Tensor) -> torch.Tensor:
        return F.interpolate(x, size=like.shape[-2:], mode="nearest")

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        p3, p4, p5 = feats
        t4 = self.td4(torch.cat([self.up(p5, p4), p4], dim=1))
        n3 = self.td3(torch.cat([self.up(t4, p3), p3], dim=1))
        n4 = self.bu4(torch.cat([self.down3(n3), t4], dim=1))
        n5 = self.bu5(torch.cat([self.down4(n4), p5], dim=1))
        return [n3, n4, n5]


class YOLOHead(nn.Module):
    """Anchor-free decoupled YOLOv8 head with distribution-focal-loss box regression.

    forward(feats) returns raw predictions (B, 4·reg_max + num_classes, N) concatenated over levels
    (N = Σ h·w). Decode with yolo_postprocess(); train with YOLOLoss. Reference: Ultralytics YOLOv8.
    """

    def __init__(self, in_channels: list[int], num_classes: int, strides: list[int], reg_max: int = 16) -> None:
        super().__init__()
        self.nc, self.reg_max, self.strides = num_classes, reg_max, list(strides)
        c2 = max(16, in_channels[0] // 4, 4 * reg_max)
        c3 = max(in_channels[0], min(num_classes, 100))
        self.box = nn.ModuleList(
            nn.Sequential(ConvBNAct(c, c2, 3), ConvBNAct(c2, c2, 3), nn.Conv2d(c2, 4 * reg_max, 1)) for c in in_channels
        )
        self.cls = nn.ModuleList(
            nn.Sequential(ConvBNAct(c, c3, 3), ConvBNAct(c3, c3, 3), nn.Conv2d(c3, num_classes, 1)) for c in in_channels
        )
        self.init_bias()

    def init_bias(self) -> None:
        """Box bias 1.0; class bias log(5 / nc / (640 / stride)²) — a low initial objectness prior."""
        for box, cls, s in zip(self.box, self.cls, self.strides):
            box[-1].bias.data[:] = 1.0
            cls[-1].bias.data[:] = math.log(5 / self.nc / (640 / s) ** 2)

    def forward(self, feats: list[torch.Tensor]) -> torch.Tensor:
        outs = [torch.cat([box(f), cls(f)], dim=1).flatten(2) for f, box, cls in zip(feats, self.box, self.cls)]
        return torch.cat(outs, dim=2)


def make_anchors(
    feat_sizes: list[tuple[int, int]], strides: list[int], device: torch.device | None = None, offset: float = 0.5
) -> tuple[torch.Tensor, torch.Tensor]:
    """Anchor points at cell centres (grid units, (N, 2) as x, y) and the stride of each point (N, 1)."""
    points, stride_t = [], []
    for (h, w), s in zip(feat_sizes, strides):
        ys = torch.arange(h, device=device, dtype=torch.float32) + offset
        xs = torch.arange(w, device=device, dtype=torch.float32) + offset
        yy, xx = torch.meshgrid(ys, xs, indexing="ij")
        points.append(torch.stack([xx, yy], dim=-1).reshape(-1, 2))
        stride_t.append(torch.full((h * w, 1), float(s), device=device))
    return torch.cat(points), torch.cat(stride_t)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """YOLOv8-s style.

    forward(image) returns the yolo output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: stem → image 32×320×320
        self.stem = ConvBNAct(3, 32, k=3, s=2, act="silu")
        # node: cba_1 → image 64×160×160
        self.cba_1 = ConvBNAct(32, 64, k=3, s=2, act="silu")
        # node: c2f_1 → image 64×160×160
        self.c2f_1 = C2f(64, 64, n=1)
        # node: cba_2 → image 128×80×80
        self.cba_2 = ConvBNAct(64, 128, k=3, s=2, act="silu")
        # node: c3 → image 128×80×80
        self.c3 = C2f(128, 128, n=2)
        # node: cba_3 → image 256×40×40
        self.cba_3 = ConvBNAct(128, 256, k=3, s=2, act="silu")
        # node: c4 → image 256×40×40
        self.c4 = C2f(256, 256, n=2)
        # node: cba_4 → image 512×20×20
        self.cba_4 = ConvBNAct(256, 512, k=3, s=2, act="silu")
        # node: c2f_2 → image 512×20×20
        self.c2f_2 = C2f(512, 512, n=1)
        # node: c5 → image 512×20×20
        self.c5 = SPPF(512, 512)
        # node: pan → pyramid P3–P5 · 128/256/512
        self.pan = PAN([128, 256, 512], n=1)
        # node: yolo → boxes + 80 cls
        self.yolo = YOLOHead([128, 256, 512], 80, strides=(8, 16, 32))

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        stem = self.stem(image)
        cba_1 = self.cba_1(stem)
        c2f_1 = self.c2f_1(cba_1)
        cba_2 = self.cba_2(c2f_1)
        c3 = self.c3(cba_2)
        cba_3 = self.cba_3(c3)
        c4 = self.c4(cba_3)
        cba_4 = self.cba_4(c4)
        c2f_2 = self.c2f_2(cba_4)
        c5 = self.c5(c2f_2)
        pyramid = [c3, c4, c5]
        pan = self.pan(pyramid)
        yolo = self.yolo(pan)
        return yolo


# ---------------------------------------------------------------------------
# Post-processing
# ---------------------------------------------------------------------------


@torch.no_grad()
def yolo_postprocess(
    preds: torch.Tensor,
    num_classes: int,
    strides: list[int],
    feat_sizes: list[tuple[int, int]],
    reg_max: int = 16,
    conf: float = 0.25,
    iou: float = 0.7,
    max_det: int = 300,
) -> list[dict[str, torch.Tensor]]:
    """Decode raw YOLO predictions: DFL expectation → ltrb distances → xyxy pixels, then class-wise NMS."""
    preds = preds.float().transpose(1, 2)
    box, cls = preds.split([4 * reg_max, num_classes], dim=-1)
    points, stride = make_anchors(feat_sizes, strides, preds.device)
    proj = torch.arange(reg_max, device=preds.device, dtype=torch.float32)
    ltrb = (box.reshape(*box.shape[:2], 4, reg_max).softmax(-1) * proj).sum(-1)
    boxes = torch.cat([points - ltrb[..., :2], points + ltrb[..., 2:]], dim=-1) * stride
    scores = cls.sigmoid()
    results = []
    for b in range(preds.shape[0]):
        score, label = scores[b].max(dim=-1)
        keep = score > conf
        bx, score, label = boxes[b][keep], score[keep], label[keep]
        idx = torchvision.ops.batched_nms(bx, score, label, iou)[:max_det]
        results.append({"boxes": bx[idx], "scores": score[idx], "labels": label[idx]})
    return results


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class YOLOLoss(nn.Module):
    """YOLOv8 loss: task-aligned assignment, BCE on IoU-aware soft targets, GIoU and distribution focal loss.

    Assignment: top-k (10) anchors inside each box ranked by score^0.5 · IoU^6; anchors claimed by several
    boxes keep the highest-IoU box. Weights: 7.5 box, 0.5 cls, 1.5 dfl.
    targets: list (per image) of {"boxes": (M, 4) xyxy pixels, "labels": (M,) int64 in [0, C-1]}.
    """

    def __init__(
        self,
        num_classes: int,
        strides: list[int],
        feat_sizes: list[tuple[int, int]],
        reg_max: int = 16,
        topk: int = 10,
        alpha: float = 0.5,
        beta: float = 6.0,
    ) -> None:
        super().__init__()
        self.nc, self.reg_max, self.topk, self.alpha, self.beta = num_classes, reg_max, topk, alpha, beta
        points, stride = make_anchors(feat_sizes, strides)
        self.register_buffer("points", points, persistent=False)
        self.register_buffer("stride", stride, persistent=False)
        self.register_buffer("proj", torch.arange(reg_max, dtype=torch.float32), persistent=False)

    def forward(self, preds: torch.Tensor, targets: list[dict[str, torch.Tensor]]) -> torch.Tensor:
        preds = preds.float().transpose(1, 2)
        box_logits, cls_logits = preds.split([4 * self.reg_max, self.nc], dim=-1)
        b, n, _ = preds.shape
        dist = box_logits.reshape(b, n, 4, self.reg_max)
        ltrb = (dist.softmax(-1) * self.proj).sum(-1)
        pred_boxes = torch.cat([self.points - ltrb[..., :2], self.points + ltrb[..., 2:]], dim=-1) * self.stride
        anchors = self.points * self.stride
        loss_box = loss_cls = loss_dfl = preds.new_zeros(())
        for i, t in enumerate(targets):
            scores_t, boxes_t, fg = self.assign(
                cls_logits[i].detach().sigmoid(), pred_boxes[i].detach(), anchors, t["labels"], t["boxes"].float()
            )
            norm = scores_t.sum().clamp_min(1.0)
            loss_cls = loss_cls + F.binary_cross_entropy_with_logits(cls_logits[i], scores_t, reduction="sum") / norm
            if fg.any():
                weight = scores_t[fg].sum(-1)
                giou = torchvision.ops.generalized_box_iou_loss(pred_boxes[i][fg], boxes_t[fg], reduction="none")
                loss_box = loss_box + (giou * weight).sum() / norm
                s, p = self.stride[fg], self.points[fg]
                target_ltrb = torch.cat([p - boxes_t[fg, :2] / s, boxes_t[fg, 2:] / s - p], dim=-1)
                target_ltrb = target_ltrb.clamp(0, self.reg_max - 1.01)
                loss_dfl = loss_dfl + (self.dfl(dist[i][fg], target_ltrb) * weight).sum() / norm
        return (7.5 * loss_box + 0.5 * loss_cls + 1.5 * loss_dfl) / len(targets)

    def dfl(self, dist: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        """Distribution focal loss: CE to the two bins around each continuous target distance."""
        left = target.long()
        right = left + 1
        w_left = right.float() - target
        logits = dist.reshape(-1, self.reg_max)
        ce_left = F.cross_entropy(logits, left.reshape(-1), reduction="none").view(left.shape)
        ce_right = F.cross_entropy(logits, right.reshape(-1), reduction="none").view(left.shape)
        return (ce_left * w_left + ce_right * (1 - w_left)).mean(-1)

    @torch.no_grad()
    def assign(
        self, scores: torch.Tensor, boxes: torch.Tensor, anchors: torch.Tensor, gt_labels: torch.Tensor, gt_boxes: torch.Tensor
    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
        """Task-aligned assigner → soft class targets (N, C), target boxes (N, 4), foreground mask (N,)."""
        n = anchors.shape[0]
        if gt_boxes.numel() == 0:
            return scores.new_zeros(n, self.nc), boxes.new_zeros(n, 4), torch.zeros(n, dtype=torch.bool, device=scores.device)
        lt = anchors[None] - gt_boxes[:, None, :2]
        rb = gt_boxes[:, None, 2:] - anchors[None]
        inside = torch.cat([lt, rb], dim=-1).amin(-1) > 1e-9
        iou = torchvision.ops.box_iou(gt_boxes, boxes).clamp_min(0)
        metric = scores[:, gt_labels].t().pow(self.alpha) * iou.pow(self.beta) * inside
        top = metric.topk(min(self.topk, n), dim=1).indices
        candidate = torch.zeros_like(inside).scatter_(1, top, True) & inside
        multi = candidate.sum(0) > 1
        if multi.any():
            best = torch.zeros_like(candidate).scatter_(0, iou.argmax(0, keepdim=True), True)
            candidate = torch.where(multi[None], best, candidate)
        fg = candidate.any(0)
        gt_idx = candidate.float().argmax(0)
        metric = metric * candidate
        norm = metric * (iou * candidate).amax(1, keepdim=True) / (metric.amax(1, keepdim=True) + 1e-9)
        target_scores = F.one_hot(gt_labels[gt_idx], self.nc).float() * (norm.amax(0) * fg)[:, None]
        return target_scores, gt_boxes[gt_idx], fg


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 640, 640),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"yolo": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > yolov8s / pytorch > train.py 1`] = `
""""Train YOLOv8-s style (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, yolo_postprocess, YOLOLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 8
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "yolo": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


def random_detection_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """1–5 random boxes (xyxy, pixels) with labels in [0, num_classes - 1]."""
    n = int(torch.randint(1, 6, ()).item())
    xy = torch.rand(n, 2) * torch.tensor([width * 0.7, height * 0.7])
    wh = torch.rand(n, 2) * torch.tensor([width * 0.25, height * 0.25]) + 8
    boxes = torch.cat([xy, (xy + wh).minimum(torch.tensor([width - 1.0, height - 1.0]))], dim=1)
    return {"boxes": boxes, "labels": torch.randint(0, num_classes, (n,))}


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 640, 640), scaled to [0, 1]
    targets["yolo"]: dict with "boxes" float (M, 4) xyxy pixels and "labels" int64 (M,) in [0, C-1]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 640, 640),
        }
        targets = {
            "yolo": random_detection_target(640, 640, 80),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Detection from COCO json (pip install pycocotools):

        from torchvision.datasets import CocoDetection, wrap_dataset_for_transforms_v2
        coco = wrap_dataset_for_transforms_v2(CocoDetection("images/", "instances.json"))
        # convert each sample to ({"image": img}, {head: {"boxes": xyxy, "labels": 0..C-1}})
        # and resize images to the declared input size, scaling boxes accordingly.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "yolo": YOLOLoss(80, strides=(8, 16, 32), feat_sizes=((80, 80), (40, 40), (20, 20)), reg_max=16),
        }
    )


class DetectionMAP:
    """COCO-style mAP via torchmetrics (pip install torchmetrics pycocotools); skipped if unavailable."""

    def __init__(self) -> None:
        try:
            from torchmetrics.detection import MeanAveragePrecision

            self.metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox")
        except Exception:  # torchmetrics / pycocotools missing
            self.metric = None

    def update(self, preds: list[dict[str, torch.Tensor]], targets: list[dict[str, torch.Tensor]]) -> None:
        if self.metric is not None:
            self.metric.update(
                [{k: v.detach().cpu() for k, v in p.items() if k in ("boxes", "scores", "labels")} for p in preds],
                [{k: v.detach().cpu() for k, v in t.items() if k in ("boxes", "labels")} for t in targets],
            )

    def compute(self) -> dict[str, float]:
        if self.metric is None:
            return {}
        result = self.metric.compute()
        return {"mAP": float(result["map"]), "mAP50": float(result["map_50"])}


def build_metrics() -> dict:
    return {
        "yolo": DetectionMAP(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"yolo": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"yolo": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        outputs["yolo"] = yolo_postprocess(
            outputs["yolo"],
            num_classes=80,
            strides=(8, 16, 32),
            feat_sizes=((80, 80), (40, 40), (20, 20)),
            reg_max=16,
            conf=0.001,
        )
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;
