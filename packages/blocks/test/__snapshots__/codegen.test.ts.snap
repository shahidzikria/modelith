exports[`codegen snapshots > bert-classifier / pytorch > model.py 1`] = `
""""BERT-style text classifier — PyTorch model generated by Netloom.

Inputs:
    tokens: (B, 128)  # tokens 128 tokens
Outputs:
    classifier: 2 classes (classification)
Parameters: 11.07M (11,072,258)
FLOPs: ~0.88 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn


CONFIG = {
    "inputs": {
        "tokens": {
            "kind": "tokens",
            "length": 128,
            "vocab": 30522,
            "tokenizer": "bert-base-uncased",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 2,
            "output_shape": [2],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class LearnedPositionalEmbedding(nn.Module):
    """Trainable absolute position embedding added to a (B, L, D) sequence (BERT / ViT)."""

    def __init__(self, length: int, dim: int) -> None:
        super().__init__()
        self.pos = nn.Parameter(torch.zeros(1, length, dim))
        nn.init.trunc_normal_(self.pos, std=0.02)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return x + self.pos


def apply_rope(x: torch.Tensor, base: float = 10000.0) -> torch.Tensor:
    """Rotary position embedding on the last axis of (B, H, N, Dh) queries / keys.

    Paper: RoFormer, Su et al. 2021 (arXiv:2104.09864).
    """
    n, dh = x.shape[-2], x.shape[-1]
    half = dh // 2
    freqs = base ** (-torch.arange(half, device=x.device, dtype=torch.float32) / half)
    angles = torch.arange(n, device=x.device, dtype=torch.float32)[:, None] * freqs[None]
    cos, sin = angles.cos().to(x.dtype), angles.sin().to(x.dtype)
    x1, x2 = x[..., :half], x[..., half : 2 * half]
    rotated = torch.cat([x1 * cos - x2 * sin, x1 * sin + x2 * cos], dim=-1)
    return torch.cat([rotated, x[..., 2 * half :]], dim=-1) if dh % 2 else rotated


class Attention(nn.Module):
    """Multi-head self-attention with fused scaled-dot-product attention and optional RoPE."""

    def __init__(self, dim: int, heads: int, dropout: float = 0.0, rope: bool = False) -> None:
        super().__init__()
        self.heads, self.dropout, self.rope = heads, dropout, rope
        self.qkv = nn.Linear(dim, 3 * dim)
        self.proj = nn.Linear(dim, dim)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        b, n, d = x.shape
        q, k, v = self.qkv(x).reshape(b, n, 3, self.heads, d // self.heads).permute(2, 0, 3, 1, 4)
        if self.rope:
            q, k = apply_rope(q), apply_rope(k)
        x = F.scaled_dot_product_attention(q, k, v, dropout_p=self.dropout if self.training else 0.0)
        return self.proj(x.transpose(1, 2).reshape(b, n, d))


class DropPath(nn.Module):
    """Stochastic depth: randomly drops the whole residual branch per sample.

    Paper: Deep Networks with Stochastic Depth, Huang et al. 2016 (arXiv:1603.09382).
    """

    def __init__(self, p: float = 0.0) -> None:
        super().__init__()
        self.p = p

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.p == 0.0 or not self.training:
            return x
        keep = 1.0 - self.p
        mask = x.new_empty((x.shape[0],) + (1,) * (x.ndim - 1)).bernoulli_(keep)
        return x * mask / keep


class TransformerBlock(nn.Module):
    """Pre-norm encoder block: x + Attention(LN(x)), then x + MLP(LN(x)).

    Papers: Attention Is All You Need (arXiv:1706.03762); ViT (arXiv:2010.11929).
    """

    def __init__(
        self, dim: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, drop_path: float = 0.0, rope: bool = False
    ) -> None:
        super().__init__()
        hidden = int(dim * mlp_ratio)
        self.norm1 = nn.LayerNorm(dim, eps=1e-6)
        self.attn = Attention(dim, heads, dropout, rope)
        self.norm2 = nn.LayerNorm(dim, eps=1e-6)
        self.mlp = nn.Sequential(
            nn.Linear(dim, hidden), nn.GELU(), nn.Dropout(dropout), nn.Linear(hidden, dim), nn.Dropout(dropout)
        )
        self.drop_path = DropPath(drop_path)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x + self.drop_path(self.attn(self.norm1(x)))
        return x + self.drop_path(self.mlp(self.norm2(x)))


class TransformerEncoder(nn.Module):
    """depth × pre-norm TransformerBlock (linearly increasing drop path) + final LayerNorm."""

    def __init__(
        self,
        dim: int,
        depth: int,
        heads: int,
        mlp_ratio: float = 4.0,
        dropout: float = 0.0,
        drop_path: float = 0.0,
        rope: bool = False,
    ) -> None:
        super().__init__()
        rates = [drop_path * i / max(1, depth - 1) for i in range(depth)]
        self.blocks = nn.ModuleList(TransformerBlock(dim, heads, mlp_ratio, dropout, r, rope) for r in rates)
        self.norm = nn.LayerNorm(dim, eps=1e-6)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        for block in self.blocks:
            x = block(x)
        return self.norm(x)


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """BERT-style text classifier.

    forward(tokens) returns the classifier output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: embed → sequence 128×256
        self.embed = nn.Embedding(30522, 256, padding_idx=0)
        # node: pos → sequence 128×256
        self.pos = LearnedPositionalEmbedding(128, 256)
        # node: drop → sequence 128×256
        self.drop = nn.Dropout(0.1)
        # node: encoder → sequence 128×256
        self.encoder = TransformerEncoder(256, depth=4, heads=4, dropout=0.1)
        # node: classifier → 2 classes
        self.classifier = ClassificationHead(256, 2, hidden=256, dropout=0.1)

    def forward(self, tokens: torch.Tensor) -> torch.Tensor:
        embed = self.embed(tokens)
        pos = self.pos(embed)
        drop = self.drop(pos)
        encoder = self.encoder(drop)
        pooled = encoder[:, 0]
        classifier = self.classifier(pooled)
        return classifier


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "tokens": torch.randint(0, 30522, (batch_size, 128)),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > bert-classifier / pytorch > train.py 1`] = `
""""Train BERT-style text classifier (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0003  # transformers prefer a smaller LR
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["tokens"]: int64 (128,) token ids from the "bert-base-uncased" tokenizer, padded / truncated
    targets["classifier"]: int64 class index in [0, 1]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "tokens": torch.randint(0, 30522, (128,)),
        }
        targets = {
            "classifier": torch.randint(0, 2, ()),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Text with Hugging Face datasets + tokenizers:

        from datasets import load_dataset
        from transformers import AutoTokenizer
        tok = AutoTokenizer.from_pretrained("bert-base-uncased")
        enc = lambda b: tok(b["text"], padding="max_length", truncation=True, max_length=128)
        ds = load_dataset("imdb").map(enc, batched=True)
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > bert-classifier / tensorflow > model.py 1`] = `
""""BERT-style text classifier — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    tokens: (B, 128)  # tokens 128 tokens
Outputs:
    classifier: 2 classes (classification)
Parameters: 11.07M (11,072,258)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "tokens": "(None, 128)",
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 2,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class PositionEmbedding(layers.Layer):
    """Add learned or fixed sinusoidal position encodings to a (B, L, D) sequence."""

    def __init__(self, mode: str = "learned", **kwargs) -> None:
        super().__init__(**kwargs)
        self.mode = mode

    def build(self, input_shape) -> None:
        length, dim = input_shape[1], input_shape[2]
        if self.mode == "learned":
            init = keras.initializers.TruncatedNormal(stddev=0.02)
            self.pos = self.add_weight(shape=(1, length, dim), initializer=init, name="pos")
            return
        position = np.arange(length)[:, None]
        div = np.exp(np.arange(0, dim, 2) * (-np.log(10000.0) / dim))
        pe = np.zeros((1, length, dim), dtype="float32")
        pe[0, :, 0::2] = np.sin(position * div)
        pe[0, :, 1::2] = np.cos(position * div[: dim // 2])
        self.pos = self.add_weight(shape=pe.shape, initializer=keras.initializers.Constant(pe), trainable=False, name="pos")

    def call(self, x):
        return x + self.pos

    def get_config(self) -> dict:
        return {**super().get_config(), "mode": self.mode}


def transformer_encoder(x, depth: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, name: str = "encoder"):
    """depth × pre-norm transformer block + final LayerNorm (Vaswani 2017; ViT 2021)."""
    dim = x.shape[-1]
    for i in range(depth):
        p = f"{name}_{i}"
        h = layers.LayerNormalization(epsilon=1e-6, name=f"{p}_ln1")(x)
        h = layers.MultiHeadAttention(heads, dim // heads, dropout=dropout, name=f"{p}_attn")(h, h)
        x = layers.Add(name=f"{p}_add1")([x, h])
        h = layers.LayerNormalization(epsilon=1e-6, name=f"{p}_ln2")(x)
        h = layers.Dense(int(dim * mlp_ratio), activation="gelu", name=f"{p}_fc1")(h)
        h = layers.Dropout(dropout, name=f"{p}_drop")(h)
        h = layers.Dense(dim, name=f"{p}_fc2")(h)
        x = layers.Add(name=f"{p}_add2")([x, h])
    return layers.LayerNormalization(epsilon=1e-6, name=f"{name}_ln")(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    tokens = keras.Input(shape=(128,), dtype="int32", name="tokens")
    # node: embed → sequence 128×256
    embed = layers.Embedding(30522, 256, name="embed")(tokens)
    # node: pos → sequence 128×256
    pos = PositionEmbedding("learned", name="pos")(embed)
    # node: drop → sequence 128×256
    drop = layers.Dropout(0.1, name="drop")(pos)
    # node: encoder → sequence 128×256
    encoder = transformer_encoder(drop, depth=4, heads=4, mlp_ratio=4, dropout=0.1, name="encoder")
    # node: pooled → vector 256
    pooled = encoder[:, 0]
    # node: classifier → 2 classes
    classifier = layers.Dense(2, name="classifier")(
        layers.Dropout(0.1, name="classifier_drop")(
            layers.Dense(256, activation="gelu", name="classifier_hidden")(pooled),
        ),
    )
    return keras.Model(
        inputs={"tokens": tokens},
        outputs=classifier,
        name="BERT_style_text_classifier",
    )


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "tokens": np.random.randint(0, 30522, size=(batch_size, 128)).astype("int32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > bert-classifier / tensorflow > train.py 1`] = `
""""Train BERT-style text classifier with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0003
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    tokens: (N, 128)
    classifier: int64 class index in [0, 1]
    """
    inputs = {
        "tokens": np.random.randint(0, 30522, size=(n, 128)).astype("int32"),
    }
    targets = np.random.randint(0, 2, size=(n,))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=["accuracy"],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > bilstm-ner / pytorch > model.py 1`] = `
""""BiLSTM-CRF NER tagger — PyTorch model generated by Netloom.

Inputs:
    tokens: (B, 64)  # tokens 64 tokens
Outputs:
    tagger: 64×9 tags (token)
Parameters: 3.22M (3,221,769)
FLOPs: ~0.08 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
from torch import nn


CONFIG = {
    "inputs": {
        "tokens": {
            "kind": "tokens",
            "length": 64,
            "vocab": 20000,
            "tokenizer": "bert-base-cased",
        },
    },
    "heads": {
        "tagger": {
            "task": "token",
            "classes": 9,
            "output_shape": [64, 9],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class RecurrentLayer(nn.Module):
    """LSTM / GRU over a (B, L, D) sequence, returning every hidden state (B, L, H × directions)."""

    def __init__(
        self, cell: str, d_in: int, hidden: int, layers: int = 1, bidirectional: bool = True, dropout: float = 0.0
    ) -> None:
        super().__init__()
        rnn = nn.LSTM if cell == "lstm" else nn.GRU
        self.rnn = rnn(
            d_in,
            hidden,
            num_layers=layers,
            batch_first=True,
            bidirectional=bidirectional,
            dropout=dropout if layers > 1 else 0.0,
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.rnn(x)[0]


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """BiLSTM-CRF NER tagger.

    forward(tokens) returns the tagger output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: embed → sequence 64×128
        self.embed = nn.Embedding(20000, 128, padding_idx=0)
        # node: drop → sequence 64×128
        self.drop = nn.Dropout(0.3)
        # node: rnn → sequence 64×256
        self.rnn = RecurrentLayer("lstm", 128, 128, layers=2, bidirectional=True, dropout=0.1)
        # node: tagger → 64×9 tags
        self.tagger = nn.Sequential(nn.Dropout(0.3), nn.Linear(256, 9))

    def forward(self, tokens: torch.Tensor) -> torch.Tensor:
        embed = self.embed(tokens)
        drop = self.drop(embed)
        rnn = self.rnn(drop)
        tagger = self.tagger(rnn)
        return tagger


# ---------------------------------------------------------------------------
# Post-processing
# ---------------------------------------------------------------------------


def crf_decode(emissions: torch.Tensor, crf: CRF) -> torch.Tensor:
    """Most likely tag sequence (B, L) under the trained CRF (Viterbi decoding)."""
    return crf.decode(emissions)


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class CRF(nn.Module):
    """Linear-chain CRF used as the loss of a token-classification head.

    forward(emissions, tags) returns the mean negative log-likelihood; decode() runs Viterbi.
    Tags equal to -100 are padding and must form a suffix of each sequence.
    Paper: Lafferty et al. 2001; BiLSTM-CRF, Huang et al. 2015 (arXiv:1508.01991).
    """

    def __init__(self, num_tags: int) -> None:
        super().__init__()
        self.start = nn.Parameter(torch.empty(num_tags).uniform_(-0.1, 0.1))
        self.end = nn.Parameter(torch.empty(num_tags).uniform_(-0.1, 0.1))
        self.trans = nn.Parameter(torch.empty(num_tags, num_tags).uniform_(-0.1, 0.1))  # trans[i, j]: i → j

    def forward(self, emissions: torch.Tensor, tags: torch.Tensor) -> torch.Tensor:
        emissions = emissions.float()
        mask = tags != -100
        tags = tags.clamp_min(0)
        return (self._log_partition(emissions, mask) - self._score(emissions, tags, mask)).mean()

    def _score(self, e: torch.Tensor, tags: torch.Tensor, mask: torch.Tensor) -> torch.Tensor:
        score = self.start[tags[:, 0]] + e[:, 0].gather(1, tags[:, :1]).squeeze(1)
        for i in range(1, e.shape[1]):
            step = self.trans[tags[:, i - 1], tags[:, i]] + e[:, i].gather(1, tags[:, i : i + 1]).squeeze(1)
            score = score + step * mask[:, i].float()
        last = tags.gather(1, (mask.sum(1) - 1).clamp_min(0).unsqueeze(1)).squeeze(1)
        return score + self.end[last]

    def _log_partition(self, e: torch.Tensor, mask: torch.Tensor) -> torch.Tensor:
        alpha = self.start + e[:, 0]
        for i in range(1, e.shape[1]):
            nxt = torch.logsumexp(alpha.unsqueeze(2) + self.trans + e[:, i].unsqueeze(1), dim=1)
            alpha = torch.where(mask[:, i : i + 1], nxt, alpha)
        return torch.logsumexp(alpha + self.end, dim=1)

    @torch.no_grad()
    def decode(self, emissions: torch.Tensor, mask: torch.Tensor | None = None) -> torch.Tensor:
        """Viterbi decoding: (B, L, T) emissions → (B, L) most likely tags."""
        e = emissions.float()
        b, length, t = e.shape
        if mask is None:
            mask = torch.ones(b, length, dtype=torch.bool, device=e.device)
        keep = torch.arange(t, device=e.device).expand(b, t)
        score = self.start + e[:, 0]
        history = []
        for i in range(1, length):
            best, idx = (score.unsqueeze(2) + self.trans).max(dim=1)
            score = torch.where(mask[:, i : i + 1], best + e[:, i], score)
            history.append(torch.where(mask[:, i : i + 1], idx, keep))
        best_last = (score + self.end).argmax(1)
        path = [best_last]
        for idx in reversed(history):
            best_last = idx.gather(1, best_last.unsqueeze(1)).squeeze(1)
            path.append(best_last)
        return torch.stack(path[::-1], dim=1)


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "tokens": torch.randint(0, 20000, (batch_size, 64)),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"tagger": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > bilstm-ner / pytorch > train.py 1`] = `
""""Train BiLSTM-CRF NER tagger (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, CRF, crf_decode, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "tagger": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["tokens"]: int64 (64,) token ids from the "bert-base-cased" tokenizer, padded / truncated
    targets["tagger"]: int64 tensor (64,) of tag ids in [0, 8], -100 for padding / ignored sub-words
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "tokens": torch.randint(0, 20000, (64,)),
        }
        targets = {
            "tagger": torch.randint(0, 9, (64,)),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Text with Hugging Face datasets + tokenizers:

        from datasets import load_dataset
        from transformers import AutoTokenizer
        tok = AutoTokenizer.from_pretrained("bert-base-cased")
        enc = lambda b: tok(b["text"], padding="max_length", truncation=True, max_length=64)
        ds = load_dataset("imdb").map(enc, batched=True)
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "tagger": CRF(9),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "tagger": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"tagger": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"tagger": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        outputs["tagger"] = crf_decode(outputs["tagger"], criteria["tagger"])
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > clip / pytorch > model.py 1`] = `
""""CLIP-style dual encoder — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 224, 224)  # image 3×224×224
    text: (B, 77)  # tokens 77 tokens
Outputs:
    clip_head: B×B similarities (contrastive)
Parameters: 39.93M (39,925,569)
FLOPs: ~13.41 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import math

import torch
import torch.nn.functional as F
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 224, 224],
            "norm": "imagenet",
        },
        "text": {
            "kind": "tokens",
            "length": 77,
            "vocab": 49408,
            "tokenizer": "openai/clip-vit-base-patch32",
        },
    },
    "heads": {
        "clip_head": {
            "task": "contrastive",
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class LearnedPositionalEmbedding(nn.Module):
    """Trainable absolute position embedding added to a (B, L, D) sequence (BERT / ViT)."""

    def __init__(self, length: int, dim: int) -> None:
        super().__init__()
        self.pos = nn.Parameter(torch.zeros(1, length, dim))
        nn.init.trunc_normal_(self.pos, std=0.02)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return x + self.pos


def apply_rope(x: torch.Tensor, base: float = 10000.0) -> torch.Tensor:
    """Rotary position embedding on the last axis of (B, H, N, Dh) queries / keys.

    Paper: RoFormer, Su et al. 2021 (arXiv:2104.09864).
    """
    n, dh = x.shape[-2], x.shape[-1]
    half = dh // 2
    freqs = base ** (-torch.arange(half, device=x.device, dtype=torch.float32) / half)
    angles = torch.arange(n, device=x.device, dtype=torch.float32)[:, None] * freqs[None]
    cos, sin = angles.cos().to(x.dtype), angles.sin().to(x.dtype)
    x1, x2 = x[..., :half], x[..., half : 2 * half]
    rotated = torch.cat([x1 * cos - x2 * sin, x1 * sin + x2 * cos], dim=-1)
    return torch.cat([rotated, x[..., 2 * half :]], dim=-1) if dh % 2 else rotated


class Attention(nn.Module):
    """Multi-head self-attention with fused scaled-dot-product attention and optional RoPE."""

    def __init__(self, dim: int, heads: int, dropout: float = 0.0, rope: bool = False) -> None:
        super().__init__()
        self.heads, self.dropout, self.rope = heads, dropout, rope
        self.qkv = nn.Linear(dim, 3 * dim)
        self.proj = nn.Linear(dim, dim)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        b, n, d = x.shape
        q, k, v = self.qkv(x).reshape(b, n, 3, self.heads, d // self.heads).permute(2, 0, 3, 1, 4)
        if self.rope:
            q, k = apply_rope(q), apply_rope(k)
        x = F.scaled_dot_product_attention(q, k, v, dropout_p=self.dropout if self.training else 0.0)
        return self.proj(x.transpose(1, 2).reshape(b, n, d))


class DropPath(nn.Module):
    """Stochastic depth: randomly drops the whole residual branch per sample.

    Paper: Deep Networks with Stochastic Depth, Huang et al. 2016 (arXiv:1603.09382).
    """

    def __init__(self, p: float = 0.0) -> None:
        super().__init__()
        self.p = p

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.p == 0.0 or not self.training:
            return x
        keep = 1.0 - self.p
        mask = x.new_empty((x.shape[0],) + (1,) * (x.ndim - 1)).bernoulli_(keep)
        return x * mask / keep


class TransformerBlock(nn.Module):
    """Pre-norm encoder block: x + Attention(LN(x)), then x + MLP(LN(x)).

    Papers: Attention Is All You Need (arXiv:1706.03762); ViT (arXiv:2010.11929).
    """

    def __init__(
        self, dim: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, drop_path: float = 0.0, rope: bool = False
    ) -> None:
        super().__init__()
        hidden = int(dim * mlp_ratio)
        self.norm1 = nn.LayerNorm(dim, eps=1e-6)
        self.attn = Attention(dim, heads, dropout, rope)
        self.norm2 = nn.LayerNorm(dim, eps=1e-6)
        self.mlp = nn.Sequential(
            nn.Linear(dim, hidden), nn.GELU(), nn.Dropout(dropout), nn.Linear(hidden, dim), nn.Dropout(dropout)
        )
        self.drop_path = DropPath(drop_path)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x + self.drop_path(self.attn(self.norm1(x)))
        return x + self.drop_path(self.mlp(self.norm2(x)))


class TransformerEncoder(nn.Module):
    """depth × pre-norm TransformerBlock (linearly increasing drop path) + final LayerNorm."""

    def __init__(
        self,
        dim: int,
        depth: int,
        heads: int,
        mlp_ratio: float = 4.0,
        dropout: float = 0.0,
        drop_path: float = 0.0,
        rope: bool = False,
    ) -> None:
        super().__init__()
        rates = [drop_path * i / max(1, depth - 1) for i in range(depth)]
        self.blocks = nn.ModuleList(TransformerBlock(dim, heads, mlp_ratio, dropout, r, rope) for r in rates)
        self.norm = nn.LayerNorm(dim, eps=1e-6)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        for block in self.blocks:
            x = block(x)
        return self.norm(x)


class ContrastiveHead(nn.Module):
    """Project two modalities into a shared space and return the scaled similarity matrix.

    Paper: CLIP, Radford et al. 2021 (arXiv:2103.00020). Row i is sample i of the first input.
    """

    def __init__(self, c_a: int, c_b: int, dim: int) -> None:
        super().__init__()
        self.proj_a = nn.Linear(c_a, dim, bias=False)
        self.proj_b = nn.Linear(c_b, dim, bias=False)
        self.logit_scale = nn.Parameter(torch.tensor(math.log(1 / 0.07)))

    def forward(self, a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
        a = F.normalize(self.proj_a(a), dim=-1)
        b = F.normalize(self.proj_b(b), dim=-1)
        return self.logit_scale.exp().clamp(max=100) * a @ b.t()


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """CLIP-style dual encoder.

    forward(image, text) returns the clip_head output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → image 2048×7×7
        self.backbone = TimmBackbone("resnet50", out_indices=(4,), pretrained=True)
        # node: embed → sequence 77×256
        self.embed = nn.Embedding(49408, 256, padding_idx=0)
        # node: pos → sequence 77×256
        self.pos = LearnedPositionalEmbedding(77, 256)
        # node: encoder → sequence 77×256
        self.encoder = TransformerEncoder(256, depth=4, heads=4)
        # node: clip_head → B×B similarities
        self.clip_head = ContrastiveHead(2048, 256, 256)

    def forward(self, image: torch.Tensor, text: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        embed = self.embed(text)
        gap = backbone.mean(dim=(2, 3))
        pos = self.pos(embed)
        encoder = self.encoder(pos)
        pooled = encoder.mean(dim=1)
        clip_head = self.clip_head(gap, pooled)
        return clip_head


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class CLIPLoss(nn.Module):
    """Symmetric InfoNCE over a (B, B) similarity matrix; matching pairs are on the diagonal."""

    def forward(self, logits: torch.Tensor, target: torch.Tensor | None = None) -> torch.Tensor:
        logits = logits.float()
        labels = torch.arange(logits.shape[0], device=logits.device)
        return 0.5 * (F.cross_entropy(logits, labels) + F.cross_entropy(logits.t(), labels))


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 224, 224),
        "text": torch.randint(0, 49408, (batch_size, 77)),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"clip_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > clip / pytorch > train.py 1`] = `
""""Train CLIP-style dual encoder (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CLIPLoss, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "clip_head": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 224, 224), ImageNet mean/std normalised
    inputs["text"]: int64 (77,) token ids from the "openai/clip-vit-base-patch32" tokenizer, padded / truncated
    targets["clip_head"]: no target needed: sample i of both inputs is a matching pair (
        the dataset yields a dummy 0,
    )
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 224, 224),
            "text": torch.randint(0, 49408, (77,)),
        }
        targets = {
            "clip_head": torch.zeros((), dtype=torch.long),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Text with Hugging Face datasets + tokenizers:

        from datasets import load_dataset
        from transformers import AutoTokenizer
        tok = AutoTokenizer.from_pretrained("openai/clip-vit-base-patch32")
        enc = lambda b: tok(b["text"], padding="max_length", truncation=True, max_length=77)
        ds = load_dataset("imdb").map(enc, batched=True)
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "clip_head": CLIPLoss(),
        }
    )


def build_metrics() -> dict:
    return {}


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"clip_head": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"clip_head": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > convnext-finetune / pytorch > model.py 1`] = `
""""ConvNeXt-T fine-tune — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 224, 224)  # image 3×224×224
Outputs:
    classifier: 10 classes (classification)
Parameters: 27.83M (27,826,282)
FLOPs: ~15.27 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 224, 224],
            "norm": "imagenet",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 10,
            "output_shape": [10],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """ConvNeXt-T fine-tune.

    forward(image) returns the classifier output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → image 768×7×7
        self.backbone = TimmBackbone("convnext_tiny", out_indices=(3,), pretrained=True)
        # node: classifier → 10 classes
        self.classifier = ClassificationHead(768, 10, dropout=0.2, pool="spatial")

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        classifier = self.classifier(backbone)
        return classifier


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 224, 224),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > convnext-finetune / pytorch > train.py 1`] = `
""""Train ConvNeXt-T fine-tune (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 224, 224), ImageNet mean/std normalised
    targets["classifier"]: int64 class index in [0, 9]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 224, 224),
        }
        targets = {
            "classifier": torch.randint(0, 10, ()),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Image classification from class folders (data/train/<class>/*.jpg):

        from torchvision import datasets, transforms
        tf = transforms.Compose([
            transforms.RandomResizedCrop((224, 224)),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize((0.485, 0.456, 0.406), (0.229, 0.224, 0.225)),
        ])
        train = DictDataset(datasets.ImageFolder("data/train", tf), "image", "classifier")
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > convnext-finetune / tensorflow > model.py 1`] = `
""""ConvNeXt-T fine-tune — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 224, 224, 3)  # image 3×224×224
Outputs:
    classifier: 10 classes (classification)
Parameters: 27.83M (27,826,282)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 224, 224, 3)",
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 10,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def keras_backbone(x, arch: str, taps: list[str], pretrained: bool, trainable: bool, name: str):
    """keras.applications model truncated at the given layers (returns a tensor or a list).

    Note: ResNet50 expects caffe-style preprocess_input; EfficientNet / ConvNeXt / MobileNetV3
    include their own rescaling and expect raw 0–255 pixels.
    """
    base = getattr(keras.applications, arch)(
        include_top=False, weights="imagenet" if pretrained else None, input_shape=tuple(x.shape[1:])
    )
    base.trainable = trainable
    outputs = [base.get_layer(t).output for t in taps] if taps else base.output
    return keras.Model(base.input, outputs, name=name)(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(224, 224, 3), name="image")
    # node: backbone → image 768×7×7
    backbone = keras_backbone(
        image,
        "ConvNeXtTiny",
        [],
        pretrained=True,
        trainable=True,
        name="backbone",
    )
    # node: classifier → 10 classes
    classifier = layers.Dense(10, name="classifier")(
        layers.Dropout(0.2, name="classifier_drop")(
            layers.GlobalAveragePooling2D(name="classifier_pool")(backbone),
        ),
    )
    return keras.Model(inputs={"image": image}, outputs=classifier, name="ConvNeXt_T_fine_tune")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 224, 224, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > convnext-finetune / tensorflow > train.py 1`] = `
""""Train ConvNeXt-T fine-tune with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 224, 224, 3)
    classifier: int64 class index in [0, 9]
    """
    inputs = {
        "image": np.random.rand(n, 224, 224, 3).astype("float32"),
    }
    targets = np.random.randint(0, 10, size=(n,))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=["accuracy"],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > deeplabv3 / pytorch > model.py 1`] = `
""""DeepLabV3 (ResNet-50 + ASPP) — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 384, 384)  # image 3×384×384
Outputs:
    seg_head: 21×384×384 mask (segmentation)
Parameters: 39.64M (39,638,869)
FLOPs: ~42.56 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 384, 384],
            "norm": "imagenet",
        },
    },
    "heads": {
        "seg_head": {
            "task": "segmentation",
            "classes": 21,
            "output_shape": [21, 384, 384],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class ASPP(nn.Module):
    """Atrous spatial pyramid pooling: 1×1, dilated 3×3 branches and an image-pooling branch.

    Paper: DeepLabV3, Chen et al. 2017 (arXiv:1706.05587).
    Note: BatchNorm on the pooled 1×1 branch needs batch size ≥ 2 in train mode.
    """

    def __init__(self, c_in: int, c_out: int = 256, rates: tuple[int, ...] = (6, 12, 18), dropout: float = 0.1) -> None:
        super().__init__()
        self.branches = nn.ModuleList(
            [ConvBNAct(c_in, c_out, 1, act="relu")] + [ConvBNAct(c_in, c_out, 3, d=r, act="relu") for r in rates]
        )
        self.pool = nn.Sequential(nn.AdaptiveAvgPool2d(1), ConvBNAct(c_in, c_out, 1, act="relu"))
        self.project = nn.Sequential(ConvBNAct(c_out * (len(rates) + 2), c_out, 1, act="relu"), nn.Dropout(dropout))

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        ys = [branch(x) for branch in self.branches]
        ys.append(F.interpolate(self.pool(x), size=x.shape[-2:], mode="bilinear", align_corners=False))
        return self.project(torch.cat(ys, dim=1))


class SegmentationHead(nn.Module):
    """3×3 Conv·BN·ReLU → 1×1 classifier → bilinear upsample to the input resolution."""

    def __init__(self, c_in: int, num_classes: int, hidden: int, size: tuple[int, int]) -> None:
        super().__init__()
        self.size = size
        self.conv = ConvBNAct(c_in, hidden, 3, act="relu") if hidden > 0 else nn.Identity()
        self.cls = nn.Conv2d(hidden if hidden > 0 else c_in, num_classes, 1)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.cls(self.conv(x))
        return F.interpolate(x, size=self.size, mode="bilinear", align_corners=False)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """DeepLabV3 (ResNet-50 + ASPP).

    forward(image) returns the seg_head output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → image 2048×12×12
        self.backbone = TimmBackbone("resnet50", out_indices=(4,), pretrained=True)
        # node: aspp → image 256×12×12
        self.aspp = ASPP(2048, 256, rates=(6, 12, 18), dropout=0.1)
        # node: seg_head → 21×384×384 mask
        self.seg_head = SegmentationHead(256, 21, hidden=256, size=(384, 384))

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        aspp = self.aspp(backbone)
        seg_head = self.seg_head(aspp)
        return seg_head


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SegmentationLoss(nn.Module):
    """Cross-entropy (BCE for a single class) + soft Dice.

    Paper: V-Net Dice loss, Milletari et al. 2016 (arXiv:1606.04797).
    """

    def __init__(self, num_classes: int, dice_weight: float = 1.0) -> None:
        super().__init__()
        self.num_classes = num_classes
        self.dice_weight = dice_weight

    def forward(self, logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        logits = logits.float()
        if self.num_classes == 1:
            target = target.float()
            base = F.binary_cross_entropy_with_logits(logits, target)
            prob, onehot, dims = logits.sigmoid(), target, (0, 2, 3)
        else:
            base = F.cross_entropy(logits, target)
            prob = logits.softmax(1)
            onehot = F.one_hot(target, self.num_classes).permute(0, 3, 1, 2).float()
            dims = (0, 2, 3)
        inter = (prob * onehot).sum(dims)
        union = prob.sum(dims) + onehot.sum(dims)
        dice = 1.0 - ((2.0 * inter + 1.0) / (union + 1.0)).mean()
        return base + self.dice_weight * dice


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 384, 384),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > deeplabv3 / pytorch > train.py 1`] = `
""""Train DeepLabV3 (ResNet-50 + ASPP) (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, SegmentationLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "seg_head": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 384, 384), ImageNet mean/std normalised
    targets["seg_head"]: int64 mask (384, 384) with class ids in [0, 20]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 384, 384),
        }
        targets = {
            "seg_head": torch.randint(0, 21, (384, 384)),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Segmentation: pair each image with an integer mask PNG of the same size
    (pixel value = class id; for a binary mask use 0/1 and return it as float (1, H, W)),
    e.g. torchvision.datasets.VOCSegmentation("data", image_set="train", download=True).
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "seg_head": SegmentationLoss(21, dice_weight=1.0),
        }
    )


class MeanIoU:
    """Mean intersection-over-union from a running confusion matrix."""

    def __init__(self, num_classes: int) -> None:
        self.n = max(2, num_classes)
        self.confusion = torch.zeros(self.n, self.n, dtype=torch.long)

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if logits.shape[1] == 1:
            pred, target = (logits[:, 0] > 0).long(), target[:, 0].long()
        else:
            pred = logits.argmax(1)
        idx = target.flatten().cpu() * self.n + pred.flatten().cpu()
        self.confusion += torch.bincount(idx, minlength=self.n * self.n).reshape(self.n, self.n)

    def compute(self) -> dict[str, float]:
        inter = self.confusion.diag().float()
        union = self.confusion.sum(0).float() + self.confusion.sum(1).float() - inter
        iou = inter / union.clamp_min(1)
        return {"miou": iou[union > 0].mean().item() if (union > 0).any() else 0.0}


def build_metrics() -> dict:
    return {
        "seg_head": MeanIoU(21),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"seg_head": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > deeplabv3 / tensorflow > model.py 1`] = `
""""DeepLabV3 (ResNet-50 + ASPP) — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 384, 384, 3)  # image 3×384×384
Outputs:
    seg_head: 21×384×384 mask (segmentation)
Parameters: 39.64M (39,638,869)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 384, 384, 3)",
    },
    "heads": {
        "seg_head": {
            "task": "segmentation",
            "classes": 21,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def keras_backbone(x, arch: str, taps: list[str], pretrained: bool, trainable: bool, name: str):
    """keras.applications model truncated at the given layers (returns a tensor or a list).

    Note: ResNet50 expects caffe-style preprocess_input; EfficientNet / ConvNeXt / MobileNetV3
    include their own rescaling and expect raw 0–255 pixels.
    """
    base = getattr(keras.applications, arch)(
        include_top=False, weights="imagenet" if pretrained else None, input_shape=tuple(x.shape[1:])
    )
    base.trainable = trainable
    outputs = [base.get_layer(t).output for t in taps] if taps else base.output
    return keras.Model(base.input, outputs, name=name)(x)


def activation(name: str, layer_name: str) -> layers.Layer:
    """Activation layer by name ("none" gives an identity)."""
    if name == "leaky_relu":
        return layers.LeakyReLU(negative_slope=0.1, name=layer_name)
    if name == "relu6":
        return layers.ReLU(max_value=6.0, name=layer_name)
    if name == "hardswish":
        return layers.Activation("hard_swish", name=layer_name)
    if name == "none":
        return layers.Identity(name=layer_name)
    return layers.Activation(name, name=layer_name)


def conv_bn_act(x, filters: int, k: int = 3, s: int = 1, d: int = 1, groups: int = 1, act: str = "silu", name: str = "cba"):
    """Conv2D → BatchNormalization → activation with "same" padding (NHWC)."""
    if groups > 1 and groups == x.shape[-1] == filters:
        x = layers.DepthwiseConv2D(k, strides=s, padding="same", dilation_rate=d, use_bias=False, name=f"{name}_dw")(x)
    else:
        x = layers.Conv2D(
            filters, k, strides=s, padding="same", dilation_rate=d, groups=groups, use_bias=False, name=f"{name}_conv"
        )(x)
    x = layers.BatchNormalization(momentum=0.9, epsilon=1e-5, name=f"{name}_bn")(x)
    return activation(act, f"{name}_act")(x)


def aspp(x, filters: int = 256, rates: tuple[int, ...] = (6, 12, 18), dropout: float = 0.1, name: str = "aspp"):
    """Atrous spatial pyramid pooling (DeepLabV3)."""
    h, w = x.shape[1], x.shape[2]
    ys = [conv_bn_act(x, filters, 1, act="relu", name=f"{name}_b0")]
    ys += [conv_bn_act(x, filters, 3, d=r, act="relu", name=f"{name}_b{i + 1}") for i, r in enumerate(rates)]
    pooled = layers.GlobalAveragePooling2D(keepdims=True, name=f"{name}_pool")(x)
    pooled = conv_bn_act(pooled, filters, 1, act="relu", name=f"{name}_pool_conv")
    ys.append(layers.Resizing(h, w, interpolation="bilinear", name=f"{name}_pool_up")(pooled))
    y = conv_bn_act(layers.Concatenate(name=f"{name}_cat")(ys), filters, 1, act="relu", name=f"{name}_project")
    return layers.Dropout(dropout, name=f"{name}_drop")(y)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(384, 384, 3), name="image")
    # node: backbone → image 2048×12×12
    backbone = keras_backbone(
        image,
        "ResNet50",
        ["conv5_block3_out"],
        pretrained=True,
        trainable=True,
        name="backbone",
    )
    # node: aspp → image 256×12×12
    aspp = aspp(backbone, 256, rates=(6, 12, 18), dropout=0.1, name="aspp")
    # node: seg_head → 21×384×384 mask
    seg_head = layers.Resizing(384, 384, interpolation="bilinear", name="seg_head")(
        layers.Conv2D(21, 1, name="seg_head_cls")(
            conv_bn_act(aspp, 256, 3, act="relu", name="seg_head_conv"),
        ),
    )
    return keras.Model(inputs={"image": image}, outputs=seg_head, name="DeepLabV3_ResNet_50_ASPP_")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 384, 384, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > deeplabv3 / tensorflow > train.py 1`] = `
""""Train DeepLabV3 (ResNet-50 + ASPP) with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 384, 384, 3)
    seg_head: int64 mask (384, 384) with class ids in [0, 20]
    """
    inputs = {
        "image": np.random.rand(n, 384, 384, 3).astype("float32"),
    }
    targets = np.random.randint(0, 21, size=(n, 384, 384))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=[keras.metrics.MeanIoU(num_classes=21, sparse_y_pred=False)],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > depth / pytorch > model.py 1`] = `
""""Monocular depth — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 256, 320)  # image 3×256×320
Outputs:
    dense_head: 1×256×320 map (dense)
Parameters: 28.66M (28,655,393)
FLOPs: ~26.10 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 256, 320],
            "norm": "imagenet",
        },
    },
    "heads": {
        "dense_head": {
            "task": "dense",
            "output_shape": [1, 256, 320],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class FPN(nn.Module):
    """Feature pyramid network: 1×1 laterals, top-down nearest upsampling, 3×3 output convs.

    Paper: Feature Pyramid Networks for Object Detection, Lin et al. 2017 (arXiv:1612.03144).
    """

    def __init__(self, in_channels: list[int], out_channels: int = 256) -> None:
        super().__init__()
        self.lateral = nn.ModuleList(nn.Conv2d(c, out_channels, 1) for c in in_channels)
        self.output = nn.ModuleList(nn.Conv2d(out_channels, out_channels, 3, padding=1) for _ in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        laterals = [conv(f) for conv, f in zip(self.lateral, feats)]
        for i in range(len(laterals) - 1, 0, -1):
            up = F.interpolate(laterals[i], size=laterals[i - 1].shape[-2:], mode="nearest")
            laterals[i - 1] = laterals[i - 1] + up
        return [conv(x) for conv, x in zip(self.output, laterals)]


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class DenseHead(nn.Module):
    """Dense regression (depth, restoration, reconstruction): conv → 1×1 → upsample → output activation."""

    def __init__(self, c_in: int, c_out: int, hidden: int, size: tuple[int, int], out_act: str = "none") -> None:
        super().__init__()
        self.size = size
        self.conv = ConvBNAct(c_in, hidden, 3, act="relu") if hidden > 0 else nn.Identity()
        self.proj = nn.Conv2d(hidden if hidden > 0 else c_in, c_out, 1)
        self.out_act = out_act

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.proj(self.conv(x))
        if tuple(x.shape[-2:]) != self.size:
            x = F.interpolate(x, size=self.size, mode="bilinear", align_corners=False)
        if self.out_act == "sigmoid":
            return x.sigmoid()
        if self.out_act == "softplus":
            return F.softplus(x)
        if self.out_act == "relu":
            return F.relu(x)
        return x


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """Monocular depth.

    forward(image) returns the dense_head output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → pyramid P3–P5 · 192/384/768
        self.backbone = TimmBackbone("convnext_tiny", out_indices=(1, 2, 3), pretrained=True)
        # node: fpn → pyramid P3–P5 · 128/128/128
        self.fpn = FPN([192, 384, 768], out_channels=128)
        # node: cba → image 128×32×40
        self.cba = ConvBNAct(128, 128, k=3, s=1, act="relu")
        # node: dense_head → 1×256×320 map
        self.dense_head = DenseHead(128, 1, hidden=64, size=(256, 320), out_act="softplus")

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        fpn = self.fpn(backbone)
        level_ = fpn[0]
        cba = self.cba(level_)
        dense_head = self.dense_head(cba)
        return dense_head


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SILogLoss(nn.Module):
    """Scale-invariant log loss for monocular depth (pixels with target ≤ 0 are ignored).

    Paper: Eigen et al. 2014 (arXiv:1406.2283); λ = 0.85 as in BTS / AdaBins.
    """

    def __init__(self, lambd: float = 0.85) -> None:
        super().__init__()
        self.lambd = lambd

    def forward(self, pred: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        pred, target = pred.float(), target.float()
        valid = target > 0
        d = torch.log(pred[valid].clamp_min(1e-6)) - torch.log(target[valid])
        return torch.sqrt((d**2).mean() - self.lambd * d.mean() ** 2 + 1e-8) * 10.0


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 256, 320),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"dense_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > depth / pytorch > train.py 1`] = `
""""Train Monocular depth (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, SILogLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "dense_head": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 256, 320), ImageNet mean/std normalised
    targets["dense_head"]: float depth map (1, 256, 320) in metres; 0 = invalid pixel
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 256, 320),
        }
        targets = {
            "dense_head": torch.rand(1, 256, 320) * 10.0 + 0.1,
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Dense regression: pair each image with a float target map of the same size (e.g. depth in metres, 0 = invalid).
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "dense_head": SILogLoss(),
        }
    )


class DepthMetrics:
    """Standard monocular-depth metrics over valid pixels: RMSE, AbsRel and δ < 1.25."""

    def __init__(self) -> None:
        self.sq = self.abs_rel = self.delta1 = self.total = 0.0

    def update(self, pred: torch.Tensor, target: torch.Tensor) -> None:
        valid = target > 0
        p, t = pred[valid].float().clamp_min(1e-6), target[valid].float()
        self.sq += ((p - t) ** 2).sum().item()
        self.abs_rel += ((p - t).abs() / t).sum().item()
        self.delta1 += (torch.maximum(p / t, t / p) < 1.25).sum().item()
        self.total += t.numel()

    def compute(self) -> dict[str, float]:
        n = max(1, self.total)
        return {
            "rmse": math.sqrt(self.sq / n),
            "abs_rel": self.abs_rel / n,
            "delta1": self.delta1 / n,
        }


def build_metrics() -> dict:
    return {
        "dense_head": DepthMetrics(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"dense_head": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"dense_head": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > detr / pytorch > model.py 1`] = `
""""DETR-R50 — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 512, 512)  # image 3×512×512
Outputs:
    detr: boxes + 80 cls (detection)
Parameters: 41.58M (41,575,573)
FLOPs: ~76.65 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn
from scipy.optimize import linear_sum_assignment
import timm
import torchvision


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 512, 512],
            "norm": "0-1",
        },
    },
    "heads": {
        "detr": {
            "task": "detection",
            "classes": 80,
            "output_shape": [80],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


def sine_position_2d(h: int, w: int, dim: int, device: torch.device, temperature: float = 10000.0) -> torch.Tensor:
    """DETR-style 2-D sine / cosine position encoding, (h·w, dim)."""
    d = dim // 4
    omega = 1.0 / temperature ** (torch.arange(d, device=device, dtype=torch.float32) / d)
    yy, xx = torch.meshgrid(
        torch.arange(h, device=device, dtype=torch.float32), torch.arange(w, device=device, dtype=torch.float32), indexing="ij"
    )
    y = yy.flatten()[:, None] * omega[None]
    x = xx.flatten()[:, None] * omega[None]
    pos = torch.cat([x.sin(), x.cos(), y.sin(), y.cos()], dim=1)
    return F.pad(pos, (0, dim - pos.shape[1]))


class DETRHead(nn.Module):
    """DETR head: 1×1 projection, 2-D sine positions, transformer encoder–decoder over learned queries,
    then class (C + 1, "no object" last) and box (normalised cx, cy, w, h) predictions.

    Returns (B, queries, C + 1 + 4). Paper: End-to-End Object Detection with Transformers,
    Carion et al. 2020 (arXiv:2005.12872). Simplification: positions are added once at the input.
    """

    def __init__(
        self,
        c_in: int,
        num_classes: int,
        dim: int = 256,
        heads: int = 8,
        enc_layers: int = 6,
        dec_layers: int = 6,
        queries: int = 100,
        ffn: int = 2048,
        dropout: float = 0.1,
    ) -> None:
        super().__init__()
        self.proj = nn.Conv2d(c_in, dim, 1)
        self.transformer = nn.Transformer(dim, heads, enc_layers, dec_layers, ffn, dropout, batch_first=True)
        self.query = nn.Embedding(queries, dim)
        self.cls = nn.Linear(dim, num_classes + 1)
        self.box = nn.Sequential(nn.Linear(dim, dim), nn.ReLU(), nn.Linear(dim, dim), nn.ReLU(), nn.Linear(dim, 4))

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if isinstance(x, (list, tuple)):
            x = x[-1]
        x = self.proj(x)
        b, d, h, w = x.shape
        src = x.flatten(2).transpose(1, 2) + sine_position_2d(h, w, d, x.device)
        tgt = self.query.weight.unsqueeze(0).expand(b, -1, -1)
        hs = self.transformer(src, tgt)
        return torch.cat([self.cls(hs), self.box(hs).sigmoid()], dim=-1)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """DETR-R50.

    forward(image) returns the detr output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → image 2048×16×16
        self.backbone = TimmBackbone("resnet50", out_indices=(4,), pretrained=True)
        # node: detr → boxes + 80 cls
        self.detr = DETRHead(
            2048,
            80,
            dim=256,
            heads=8,
            enc_layers=6,
            dec_layers=6,
            queries=100,
            ffn=2048,
        )

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        detr = self.detr(backbone)
        return detr


# ---------------------------------------------------------------------------
# Post-processing
# ---------------------------------------------------------------------------


@torch.no_grad()
def detr_postprocess(preds: torch.Tensor, image_size: tuple[int, int], conf: float = 0.5) -> list[dict[str, torch.Tensor]]:
    """Softmax over classes (dropping "no object"), cxcywh → xyxy pixels, confidence threshold."""
    preds = preds.float()
    h, w = image_size
    prob = preds[..., :-4].softmax(-1)[..., :-1]
    scores, labels = prob.max(-1)
    boxes = torchvision.ops.box_convert(preds[..., -4:], "cxcywh", "xyxy") * preds.new_tensor([w, h, w, h])
    return [
        {"boxes": boxes[b][scores[b] > conf], "scores": scores[b][scores[b] > conf], "labels": labels[b][scores[b] > conf]}
        for b in range(preds.shape[0])
    ]


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class DETRLoss(nn.Module):
    """Hungarian matching (cost: 1·class + 5·L1 + 2·GIoU), then CE ("no object" weight 0.1)
    + 5·L1 + 2·GIoU on matched boxes. Targets give xyxy pixels; they are normalised by the image size."""

    def __init__(self, num_classes: int, image_size: tuple[int, int], eos_coef: float = 0.1) -> None:
        super().__init__()
        self.nc, self.image_size = num_classes, image_size
        weight = torch.ones(num_classes + 1)
        weight[-1] = eos_coef
        self.register_buffer("empty_weight", weight, persistent=False)

    def forward(self, preds: torch.Tensor, targets: list[dict[str, torch.Tensor]]) -> torch.Tensor:
        preds = preds.float()
        logits, boxes = preds[..., :-4], preds[..., -4:]
        h, w = self.image_size
        scale = boxes.new_tensor([w, h, w, h])
        xyxy = lambda b: torchvision.ops.box_convert(b, "cxcywh", "xyxy")  # noqa: E731
        total = preds.new_zeros(())
        for i, t in enumerate(targets):
            labels = t["labels"]
            target_cls = torch.full((logits.shape[1],), self.nc, dtype=torch.long, device=preds.device)
            if len(labels):
                tgt = torchvision.ops.box_convert(t["boxes"].float() / scale, "xyxy", "cxcywh")
                with torch.no_grad():
                    cost = (
                        -logits[i].softmax(-1)[:, labels]
                        + 5 * torch.cdist(boxes[i], tgt, p=1)
                        - 2 * torchvision.ops.generalized_box_iou(xyxy(boxes[i]), xyxy(tgt))
                    )
                    rows, cols = linear_sum_assignment(cost.float().cpu().numpy())
                q = torch.as_tensor(rows, device=preds.device)
                g = torch.as_tensor(cols, device=preds.device)
                target_cls[q] = labels[g]
                n = len(labels)
                total = total + 5 * F.l1_loss(boxes[i][q], tgt[g], reduction="sum") / n
                giou = torchvision.ops.generalized_box_iou(xyxy(boxes[i][q]), xyxy(tgt[g])).diag()
                total = total + 2 * (1 - giou).sum() / n
            total = total + F.cross_entropy(logits[i], target_cls, self.empty_weight)
        return total / len(targets)


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 512, 512),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"detr": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > detr / pytorch > train.py 1`] = `
""""Train DETR-R50 (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, detr_postprocess, DETRLoss, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "detr": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


def random_detection_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """1–5 random boxes (xyxy, pixels) with labels in [0, num_classes - 1]."""
    n = int(torch.randint(1, 6, ()).item())
    xy = torch.rand(n, 2) * torch.tensor([width * 0.7, height * 0.7])
    wh = torch.rand(n, 2) * torch.tensor([width * 0.25, height * 0.25]) + 8
    boxes = torch.cat([xy, (xy + wh).minimum(torch.tensor([width - 1.0, height - 1.0]))], dim=1)
    return {"boxes": boxes, "labels": torch.randint(0, num_classes, (n,))}


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 512, 512), scaled to [0, 1]
    targets["detr"]: dict with "boxes" float (M, 4) xyxy pixels and "labels" int64 (M,) in [0, C-1]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 512, 512),
        }
        targets = {
            "detr": random_detection_target(512, 512, 80),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Detection from COCO json (pip install pycocotools):

        from torchvision.datasets import CocoDetection, wrap_dataset_for_transforms_v2
        coco = wrap_dataset_for_transforms_v2(CocoDetection("images/", "instances.json"))
        # convert each sample to ({"image": img}, {head: {"boxes": xyxy, "labels": 0..C-1}})
        # and resize images to the declared input size, scaling boxes accordingly.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "detr": DETRLoss(80, image_size=(512, 512)),
        }
    )


class DetectionMAP:
    """COCO-style mAP via torchmetrics (pip install torchmetrics pycocotools); skipped if unavailable."""

    def __init__(self) -> None:
        try:
            from torchmetrics.detection import MeanAveragePrecision

            self.metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox")
        except Exception:  # torchmetrics / pycocotools missing
            self.metric = None

    def update(self, preds: list[dict[str, torch.Tensor]], targets: list[dict[str, torch.Tensor]]) -> None:
        if self.metric is not None:
            self.metric.update(
                [{k: v.detach().cpu() for k, v in p.items() if k in ("boxes", "scores", "labels")} for p in preds],
                [{k: v.detach().cpu() for k, v in t.items() if k in ("boxes", "labels")} for t in targets],
            )

    def compute(self) -> dict[str, float]:
        if self.metric is None:
            return {}
        result = self.metric.compute()
        return {"mAP": float(result["map"]), "mAP50": float(result["map_50"])}


def build_metrics() -> dict:
    return {
        "detr": DetectionMAP(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"detr": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"detr": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        outputs["detr"] = detr_postprocess(outputs["detr"], image_size=(512, 512), conf=0.0)
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > efficientnet-transfer / pytorch > model.py 1`] = `
""""EfficientNet-B0 transfer — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 224, 224)  # image 3×224×224
Outputs:
    classifier: 5 classes (classification)
Parameters: 3.60M (3,596,993)
FLOPs: ~1.97 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 224, 224],
            "norm": "imagenet",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 5,
            "output_shape": [5],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """EfficientNet-B0 transfer.

    forward(image) returns the classifier output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → image 320×7×7
        self.backbone = TimmBackbone(
            "efficientnet_b0",
            out_indices=(4,),
            pretrained=True,
            freeze_stages=2,
        )
        # node: classifier → 5 classes
        self.classifier = ClassificationHead(320, 5, dropout=0.2, pool="spatial")

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        classifier = self.classifier(backbone)
        return classifier


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 224, 224),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > efficientnet-transfer / pytorch > train.py 1`] = `
""""Train EfficientNet-B0 transfer (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 224, 224), ImageNet mean/std normalised
    targets["classifier"]: int64 class index in [0, 4]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 224, 224),
        }
        targets = {
            "classifier": torch.randint(0, 5, ()),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Image classification from class folders (data/train/<class>/*.jpg):

        from torchvision import datasets, transforms
        tf = transforms.Compose([
            transforms.RandomResizedCrop((224, 224)),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize((0.485, 0.456, 0.406), (0.229, 0.224, 0.225)),
        ])
        train = DictDataset(datasets.ImageFolder("data/train", tf), "image", "classifier")
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > efficientnet-transfer / tensorflow > model.py 1`] = `
""""EfficientNet-B0 transfer — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 224, 224, 3)  # image 3×224×224
Outputs:
    classifier: 5 classes (classification)
Parameters: 3.60M (3,596,993)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 224, 224, 3)",
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 5,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def keras_backbone(x, arch: str, taps: list[str], pretrained: bool, trainable: bool, name: str):
    """keras.applications model truncated at the given layers (returns a tensor or a list).

    Note: ResNet50 expects caffe-style preprocess_input; EfficientNet / ConvNeXt / MobileNetV3
    include their own rescaling and expect raw 0–255 pixels.
    """
    base = getattr(keras.applications, arch)(
        include_top=False, weights="imagenet" if pretrained else None, input_shape=tuple(x.shape[1:])
    )
    base.trainable = trainable
    outputs = [base.get_layer(t).output for t in taps] if taps else base.output
    return keras.Model(base.input, outputs, name=name)(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(224, 224, 3), name="image")
    # node: backbone → image 320×7×7
    backbone = keras_backbone(
        image,
        "EfficientNetB0",
        ["block7a_project_bn"],
        pretrained=True,
        trainable=False,
        name="backbone",
    )
    # node: classifier → 5 classes
    classifier = layers.Dense(5, name="classifier")(
        layers.Dropout(0.2, name="classifier_drop")(
            layers.GlobalAveragePooling2D(name="classifier_pool")(backbone),
        ),
    )
    return keras.Model(inputs={"image": image}, outputs=classifier, name="EfficientNet_B0_transfer")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 224, 224, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > efficientnet-transfer / tensorflow > train.py 1`] = `
""""Train EfficientNet-B0 transfer with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.0001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 224, 224, 3)
    classifier: int64 class index in [0, 4]
    """
    inputs = {
        "image": np.random.rand(n, 224, 224, 3).astype("float32"),
    }
    targets = np.random.randint(0, 5, size=(n,))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=["accuracy"],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > faster-rcnn / pytorch > model.py 1`] = `
""""Faster R-CNN R50-FPN — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 512, 512)  # image 3×512×512
Outputs:
    detector: boxes + 20 cls (detection)
Parameters: 40.79M (40,793,784)
FLOPs: ~232.57 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import collections

import torch
import torch.nn.functional as F
from torch import nn
from torchvision.models.detection.anchor_utils import AnchorGenerator
from torchvision.ops import MultiScaleRoIAlign
import timm
import torchvision


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 512, 512],
            "norm": "0-1",
        },
    },
    "heads": {
        "detector": {
            "task": "detection",
            "classes": 20,
            "output_shape": [20],
            "strides": [8, 16, 32],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class FPN(nn.Module):
    """Feature pyramid network: 1×1 laterals, top-down nearest upsampling, 3×3 output convs.

    Paper: Feature Pyramid Networks for Object Detection, Lin et al. 2017 (arXiv:1612.03144).
    """

    def __init__(self, in_channels: list[int], out_channels: int = 256) -> None:
        super().__init__()
        self.lateral = nn.ModuleList(nn.Conv2d(c, out_channels, 1) for c in in_channels)
        self.output = nn.ModuleList(nn.Conv2d(out_channels, out_channels, 3, padding=1) for _ in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        laterals = [conv(f) for conv, f in zip(self.lateral, feats)]
        for i in range(len(laterals) - 1, 0, -1):
            up = F.interpolate(laterals[i], size=laterals[i - 1].shape[-2:], mode="nearest")
            laterals[i - 1] = laterals[i - 1] + up
        return [conv(x) for conv, x in zip(self.output, laterals)]


class TorchvisionDetector(nn.Module):
    """Adapts a torchvision detector to batched image tensors and 0-based labels.

    torchvision reserves label 0 for background (num_classes = C + 1), so labels are shifted +1 for
    training and −1 in the predictions. Train mode returns a loss dict, eval mode a list of detections.
    """

    def __init__(self, detector: nn.Module) -> None:
        super().__init__()
        self.detector = detector

    def forward(self, images: torch.Tensor, targets: list[dict[str, torch.Tensor]] | None = None):
        if targets is not None:
            targets = [{**t, "labels": t["labels"] + 1} for t in targets]
        out = self.detector(list(images), targets)
        if self.training:
            return out
        return [{**o, "labels": o["labels"] - 1} for o in out]


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GraphBackbone(nn.Module):
    """Everything upstream of the detector; returns an OrderedDict of equal-channel feature maps."""

    def __init__(self) -> None:
        super().__init__()
        self.out_channels = 256
        # node: backbone → pyramid P3–P5 · 512/1024/2048
        self.backbone = TimmBackbone("resnet50", out_indices=(2, 3, 4), pretrained=True)
        # node: fpn → pyramid P3–P5 · 256/256/256
        self.fpn = FPN([512, 1024, 2048], out_channels=256)

    def forward(self, image: torch.Tensor) -> collections.OrderedDict[str, torch.Tensor]:
        backbone = self.backbone(image)
        fpn = self.fpn(backbone)
        return collections.OrderedDict(zip(("0", "1", "2"), fpn))


class GeneratedModel(nn.Module):
    """Faster R-CNN R50-FPN: Faster R-CNN on top of GraphBackbone.

    Training: model(image, targets) → dict of losses.
    Inference: model(image) → list of {"boxes", "labels", "scores"} per image.
    image: float tensor (B, 3, 512, 512) with values in [0, 1] (torchvision normalises internally).
    targets: list of {"boxes": (N, 4) xyxy pixels, "labels": (N,) int64 in [0, C-1]}.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: detector
        self.detector = TorchvisionDetector(
            torchvision.models.detection.FasterRCNN(
                GraphBackbone(),
                rpn_anchor_generator=AnchorGenerator(
                    sizes=((32,), (64,), (128,)),
                    aspect_ratios=((0.5, 1, 2), (0.5, 1, 2), (0.5, 1, 2)),
                ),
                num_classes=21,
                box_roi_pool=MultiScaleRoIAlign(
                    featmap_names=["0", "1", "2"],
                    output_size=7,
                    sampling_ratio=2,
                ),
                min_size=512,
                max_size=512,
            ),
        )

    def forward(self, image: torch.Tensor, targets: list[dict[str, torch.Tensor]] | None = None):
        return self.detector(image, targets)


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 512, 512),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"detector": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > faster-rcnn / pytorch > train.py 1`] = `
""""Train Faster R-CNN R50-FPN (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


def random_detection_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """1–5 random boxes (xyxy, pixels) with labels in [0, num_classes - 1]."""
    n = int(torch.randint(1, 6, ()).item())
    xy = torch.rand(n, 2) * torch.tensor([width * 0.7, height * 0.7])
    wh = torch.rand(n, 2) * torch.tensor([width * 0.25, height * 0.25]) + 8
    boxes = torch.cat([xy, (xy + wh).minimum(torch.tensor([width - 1.0, height - 1.0]))], dim=1)
    return {"boxes": boxes, "labels": torch.randint(0, num_classes, (n,))}


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 512, 512), scaled to [0, 1]
    targets["detector"]: dict with "boxes" float (M, 4) xyxy pixels and "labels" int64 (M,) in [
        0,
        C-1,
    ]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 512, 512),
        }
        targets = {
            "detector": random_detection_target(512, 512, 20),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Detection from COCO json (pip install pycocotools):

        from torchvision.datasets import CocoDetection, wrap_dataset_for_transforms_v2
        coco = wrap_dataset_for_transforms_v2(CocoDetection("images/", "instances.json"))
        # convert each sample to ({"image": img}, {head: {"boxes": xyxy, "labels": 0..C-1}})
        # and resize images to the declared input size, scaling boxes accordingly.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


class DetectionMAP:
    """COCO-style mAP via torchmetrics (pip install torchmetrics pycocotools); skipped if unavailable."""

    def __init__(self) -> None:
        try:
            from torchmetrics.detection import MeanAveragePrecision

            self.metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox")
        except Exception:  # torchmetrics / pycocotools missing
            self.metric = None

    def update(self, preds: list[dict[str, torch.Tensor]], targets: list[dict[str, torch.Tensor]]) -> None:
        if self.metric is not None:
            self.metric.update(
                [{k: v.detach().cpu() for k, v in p.items() if k in ("boxes", "scores", "labels")} for p in preds],
                [{k: v.detach().cpu() for k, v in t.items() if k in ("boxes", "labels")} for t in targets],
            )

    def compute(self) -> dict[str, float]:
        if self.metric is None:
            return {}
        result = self.metric.compute()
        return {"mAP": float(result["map"]), "mAP50": float(result["map_50"])}


def build_metrics() -> dict:
    return {
        "detector": DetectionMAP(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict) -> tuple[torch.Tensor, dict]:
    """torchvision detectors return their own loss dict in train mode."""
    losses = model(**inputs, targets=targets["detector"])
    losses = {k: v.float() for k, v in losses.items()}
    return sum(losses.values()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader) -> dict[str, float]:
    """Detection mAP (losses are only available in train mode for torchvision detectors)."""
    model.eval()
    metrics = build_metrics()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        preds = model(**inputs)
        for metric in metrics.values():
            metric.update(preds, targets["detector"])
    results: dict[str, float] = {}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    optimizer = torch.optim.AdamW(param_groups(model, WEIGHT_DECAY), lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > forgery / pytorch > model.py 1`] = `
""""Tampering localisation — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 256, 256)  # image 3×256×256
Outputs:
    mask: 1×256×256 mask (segmentation)
Parameters: 4.18M (4,175,144)
FLOPs: ~3.15 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 256, 256],
            "norm": "imagenet",
        },
    },
    "heads": {
        "mask": {
            "task": "segmentation",
            "classes": 1,
            "output_shape": [1, 256, 256],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class FPN(nn.Module):
    """Feature pyramid network: 1×1 laterals, top-down nearest upsampling, 3×3 output convs.

    Paper: Feature Pyramid Networks for Object Detection, Lin et al. 2017 (arXiv:1612.03144).
    """

    def __init__(self, in_channels: list[int], out_channels: int = 256) -> None:
        super().__init__()
        self.lateral = nn.ModuleList(nn.Conv2d(c, out_channels, 1) for c in in_channels)
        self.output = nn.ModuleList(nn.Conv2d(out_channels, out_channels, 3, padding=1) for _ in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        laterals = [conv(f) for conv, f in zip(self.lateral, feats)]
        for i in range(len(laterals) - 1, 0, -1):
            up = F.interpolate(laterals[i], size=laterals[i - 1].shape[-2:], mode="nearest")
            laterals[i - 1] = laterals[i - 1] + up
        return [conv(x) for conv, x in zip(self.output, laterals)]


class CBAM(nn.Module):
    """Channel attention (shared MLP on avg + max pooling) followed by k×k spatial attention.

    Paper: CBAM, Woo et al. 2018 (arXiv:1807.06521).
    """

    def __init__(self, c: int, reduction: int = 16, k: int = 7) -> None:
        super().__init__()
        hidden = max(8, c // reduction)
        self.mlp = nn.Sequential(nn.Conv2d(c, hidden, 1), nn.ReLU(inplace=True), nn.Conv2d(hidden, c, 1))
        self.spatial = nn.Conv2d(2, 1, k, padding=k // 2)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        avg = self.mlp(x.mean(dim=(2, 3), keepdim=True))
        mx = self.mlp(x.amax(dim=(2, 3), keepdim=True))
        x = x * torch.sigmoid(avg + mx)
        s = torch.cat([x.mean(dim=1, keepdim=True), x.amax(dim=1, keepdim=True)], dim=1)
        return x * torch.sigmoid(self.spatial(s))


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class SegmentationHead(nn.Module):
    """3×3 Conv·BN·ReLU → 1×1 classifier → bilinear upsample to the input resolution."""

    def __init__(self, c_in: int, num_classes: int, hidden: int, size: tuple[int, int]) -> None:
        super().__init__()
        self.size = size
        self.conv = ConvBNAct(c_in, hidden, 3, act="relu") if hidden > 0 else nn.Identity()
        self.cls = nn.Conv2d(hidden if hidden > 0 else c_in, num_classes, 1)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.cls(self.conv(x))
        return F.interpolate(x, size=self.size, mode="bilinear", align_corners=False)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """Tampering localisation.

    forward(image) returns the mask output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → pyramid P3–P5 · 40/112/320
        self.backbone = TimmBackbone("efficientnet_b0", out_indices=(2, 3, 4), pretrained=True)
        # node: fpn → pyramid P3–P5 · 128/128/128
        self.fpn = FPN([40, 112, 320], out_channels=128)
        # node: cbam → image 128×32×32
        self.cbam = CBAM(128, reduction=16, k=7)
        # node: mask → 1×256×256 mask
        self.mask = SegmentationHead(128, 1, hidden=64, size=(256, 256))

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        fpn = self.fpn(backbone)
        level_ = fpn[0]
        cbam = self.cbam(level_)
        mask = self.mask(cbam)
        return mask


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SegmentationLoss(nn.Module):
    """Cross-entropy (BCE for a single class) + soft Dice.

    Paper: V-Net Dice loss, Milletari et al. 2016 (arXiv:1606.04797).
    """

    def __init__(self, num_classes: int, dice_weight: float = 1.0) -> None:
        super().__init__()
        self.num_classes = num_classes
        self.dice_weight = dice_weight

    def forward(self, logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        logits = logits.float()
        if self.num_classes == 1:
            target = target.float()
            base = F.binary_cross_entropy_with_logits(logits, target)
            prob, onehot, dims = logits.sigmoid(), target, (0, 2, 3)
        else:
            base = F.cross_entropy(logits, target)
            prob = logits.softmax(1)
            onehot = F.one_hot(target, self.num_classes).permute(0, 3, 1, 2).float()
            dims = (0, 2, 3)
        inter = (prob * onehot).sum(dims)
        union = prob.sum(dims) + onehot.sum(dims)
        dice = 1.0 - ((2.0 * inter + 1.0) / (union + 1.0)).mean()
        return base + self.dice_weight * dice


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 256, 256),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"mask": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > forgery / pytorch > train.py 1`] = `
""""Train Tampering localisation (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, SegmentationLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "mask": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 256, 256), ImageNet mean/std normalised
    targets["mask"]: float mask (1, 256, 256) with 1.0 = foreground
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 256, 256),
        }
        targets = {
            "mask": torch.randint(0, 2, (1, 256, 256)).float(),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Segmentation: pair each image with an integer mask PNG of the same size
    (pixel value = class id; for a binary mask use 0/1 and return it as float (1, H, W)),
    e.g. torchvision.datasets.VOCSegmentation("data", image_set="train", download=True).
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "mask": SegmentationLoss(1, dice_weight=1.0),
        }
    )


class MeanIoU:
    """Mean intersection-over-union from a running confusion matrix."""

    def __init__(self, num_classes: int) -> None:
        self.n = max(2, num_classes)
        self.confusion = torch.zeros(self.n, self.n, dtype=torch.long)

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if logits.shape[1] == 1:
            pred, target = (logits[:, 0] > 0).long(), target[:, 0].long()
        else:
            pred = logits.argmax(1)
        idx = target.flatten().cpu() * self.n + pred.flatten().cpu()
        self.confusion += torch.bincount(idx, minlength=self.n * self.n).reshape(self.n, self.n)

    def compute(self) -> dict[str, float]:
        inter = self.confusion.diag().float()
        union = self.confusion.sum(0).float() + self.confusion.sum(1).float() - inter
        iou = inter / union.clamp_min(1)
        return {"miou": iou[union > 0].mean().item() if (union > 0).any() else 0.0}


def build_metrics() -> dict:
    return {
        "mask": MeanIoU(1),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"mask": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"mask": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > forgery / tensorflow > model.py 1`] = `
""""Tampering localisation — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 256, 256, 3)  # image 3×256×256
Outputs:
    mask: 1×256×256 mask (segmentation)
Parameters: 4.18M (4,175,144)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 256, 256, 3)",
    },
    "heads": {
        "mask": {
            "task": "segmentation",
            "classes": 1,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def keras_backbone(x, arch: str, taps: list[str], pretrained: bool, trainable: bool, name: str):
    """keras.applications model truncated at the given layers (returns a tensor or a list).

    Note: ResNet50 expects caffe-style preprocess_input; EfficientNet / ConvNeXt / MobileNetV3
    include their own rescaling and expect raw 0–255 pixels.
    """
    base = getattr(keras.applications, arch)(
        include_top=False, weights="imagenet" if pretrained else None, input_shape=tuple(x.shape[1:])
    )
    base.trainable = trainable
    outputs = [base.get_layer(t).output for t in taps] if taps else base.output
    return keras.Model(base.input, outputs, name=name)(x)


def fpn(feats: list, filters: int = 256, name: str = "fpn") -> list:
    """Feature pyramid network (Lin et al. 2017)."""
    laterals = [layers.Conv2D(filters, 1, name=f"{name}_lat{i}")(f) for i, f in enumerate(feats)]
    for i in range(len(laterals) - 1, 0, -1):
        h, w = laterals[i - 1].shape[1], laterals[i - 1].shape[2]
        up = layers.Resizing(h, w, interpolation="nearest", name=f"{name}_up{i}")(laterals[i])
        laterals[i - 1] = layers.Add(name=f"{name}_add{i}")([laterals[i - 1], up])
    return [layers.Conv2D(filters, 3, padding="same", name=f"{name}_out{i}")(x) for i, x in enumerate(laterals)]


def cbam(x, reduction: int = 16, k: int = 7, name: str = "cbam"):
    """Channel then spatial attention (Woo et al. 2018)."""
    c = x.shape[-1]
    fc1 = layers.Dense(max(8, c // reduction), activation="relu", name=f"{name}_fc1")
    fc2 = layers.Dense(c, name=f"{name}_fc2")
    avg = fc2(fc1(layers.GlobalAveragePooling2D(keepdims=True, name=f"{name}_avg")(x)))
    mx = fc2(fc1(layers.GlobalMaxPooling2D(keepdims=True, name=f"{name}_max")(x)))
    gate = layers.Activation("sigmoid", name=f"{name}_cgate")(layers.Add(name=f"{name}_cadd")([avg, mx]))
    x = layers.Multiply(name=f"{name}_cmul")([x, gate])
    s = layers.Concatenate(name=f"{name}_scat")([ops.mean(x, axis=-1, keepdims=True), ops.max(x, axis=-1, keepdims=True)])
    s = layers.Conv2D(1, k, padding="same", activation="sigmoid", name=f"{name}_spatial")(s)
    return layers.Multiply(name=f"{name}_smul")([x, s])


def activation(name: str, layer_name: str) -> layers.Layer:
    """Activation layer by name ("none" gives an identity)."""
    if name == "leaky_relu":
        return layers.LeakyReLU(negative_slope=0.1, name=layer_name)
    if name == "relu6":
        return layers.ReLU(max_value=6.0, name=layer_name)
    if name == "hardswish":
        return layers.Activation("hard_swish", name=layer_name)
    if name == "none":
        return layers.Identity(name=layer_name)
    return layers.Activation(name, name=layer_name)


def conv_bn_act(x, filters: int, k: int = 3, s: int = 1, d: int = 1, groups: int = 1, act: str = "silu", name: str = "cba"):
    """Conv2D → BatchNormalization → activation with "same" padding (NHWC)."""
    if groups > 1 and groups == x.shape[-1] == filters:
        x = layers.DepthwiseConv2D(k, strides=s, padding="same", dilation_rate=d, use_bias=False, name=f"{name}_dw")(x)
    else:
        x = layers.Conv2D(
            filters, k, strides=s, padding="same", dilation_rate=d, groups=groups, use_bias=False, name=f"{name}_conv"
        )(x)
    x = layers.BatchNormalization(momentum=0.9, epsilon=1e-5, name=f"{name}_bn")(x)
    return activation(act, f"{name}_act")(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(256, 256, 3), name="image")
    # node: backbone → pyramid P3–P5 · 40/112/320
    backbone = keras_backbone(
        image,
        "EfficientNetB0",
        ["block3b_add", "block5c_add", "block7a_project_bn"],
        pretrained=True,
        trainable=True,
        name="backbone",
    )
    # node: fpn → pyramid P3–P5 · 128/128/128
    fpn = fpn(backbone, filters=128, name="fpn")
    # node: level_ → image 128×32×32
    level_ = fpn[0]
    # node: cbam → image 128×32×32
    cbam = cbam(level_, reduction=16, k=7, name="cbam")
    # node: mask → 1×256×256 mask
    mask = layers.Resizing(256, 256, interpolation="bilinear", name="mask")(
        layers.Conv2D(1, 1, name="mask_cls")(conv_bn_act(cbam, 64, 3, act="relu", name="mask_conv")),
    )
    return keras.Model(inputs={"image": image}, outputs=mask, name="Tampering_localisation")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 256, 256, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"mask": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
