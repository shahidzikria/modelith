exports[`codegen snapshots > forgery / tensorflow > train.py 1`] = `
""""Train Tampering localisation with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 256, 256, 3)
    mask: float mask (1, 256, 256) with 1.0 = foreground
    """
    inputs = {
        "image": np.random.rand(n, 256, 256, 3).astype("float32"),
    }
    targets = np.random.randint(0, 2, size=(n, 256, 256, 1)).astype("float32")
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.BinaryCrossentropy(from_logits=True),
        metrics=[keras.metrics.BinaryIoU(target_class_ids=[1], threshold=0.0)],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > mask-rcnn / pytorch > model.py 1`] = `
""""Mask R-CNN — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 512, 512)  # image 3×512×512
Outputs:
    detector: boxes + masks · 20 cls (instance)
Parameters: 43.42M (43,421,901)
FLOPs: ~260.83 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import collections

import torch
import torch.nn.functional as F
from torch import nn
from torchvision.models.detection.anchor_utils import AnchorGenerator
from torchvision.ops import MultiScaleRoIAlign
import timm
import torchvision


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 512, 512],
            "norm": "0-1",
        },
    },
    "heads": {
        "detector": {
            "task": "instance",
            "classes": 20,
            "output_shape": [20],
            "strides": [8, 16, 32],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class FPN(nn.Module):
    """Feature pyramid network: 1×1 laterals, top-down nearest upsampling, 3×3 output convs.

    Paper: Feature Pyramid Networks for Object Detection, Lin et al. 2017 (arXiv:1612.03144).
    """

    def __init__(self, in_channels: list[int], out_channels: int = 256) -> None:
        super().__init__()
        self.lateral = nn.ModuleList(nn.Conv2d(c, out_channels, 1) for c in in_channels)
        self.output = nn.ModuleList(nn.Conv2d(out_channels, out_channels, 3, padding=1) for _ in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        laterals = [conv(f) for conv, f in zip(self.lateral, feats)]
        for i in range(len(laterals) - 1, 0, -1):
            up = F.interpolate(laterals[i], size=laterals[i - 1].shape[-2:], mode="nearest")
            laterals[i - 1] = laterals[i - 1] + up
        return [conv(x) for conv, x in zip(self.output, laterals)]


class TorchvisionDetector(nn.Module):
    """Adapts a torchvision detector to batched image tensors and 0-based labels.

    torchvision reserves label 0 for background (num_classes = C + 1), so labels are shifted +1 for
    training and −1 in the predictions. Train mode returns a loss dict, eval mode a list of detections.
    """

    def __init__(self, detector: nn.Module) -> None:
        super().__init__()
        self.detector = detector

    def forward(self, images: torch.Tensor, targets: list[dict[str, torch.Tensor]] | None = None):
        if targets is not None:
            targets = [{**t, "labels": t["labels"] + 1} for t in targets]
        out = self.detector(list(images), targets)
        if self.training:
            return out
        return [{**o, "labels": o["labels"] - 1} for o in out]


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GraphBackbone(nn.Module):
    """Everything upstream of the detector; returns an OrderedDict of equal-channel feature maps."""

    def __init__(self) -> None:
        super().__init__()
        self.out_channels = 256
        # node: backbone → pyramid P3–P5 · 512/1024/2048
        self.backbone = TimmBackbone("resnet50", out_indices=(2, 3, 4), pretrained=True)
        # node: fpn → pyramid P3–P5 · 256/256/256
        self.fpn = FPN([512, 1024, 2048], out_channels=256)

    def forward(self, image: torch.Tensor) -> collections.OrderedDict[str, torch.Tensor]:
        backbone = self.backbone(image)
        fpn = self.fpn(backbone)
        return collections.OrderedDict(zip(("0", "1", "2"), fpn))


class GeneratedModel(nn.Module):
    """Mask R-CNN: Mask R-CNN on top of GraphBackbone.

    Training: model(image, targets) → dict of losses.
    Inference: model(image) → list of {"boxes", "labels", "scores", "masks"} per image.
    image: float tensor (B, 3, 512, 512) with values in [0, 1] (torchvision normalises internally).
    targets: list of {"boxes": (N, 4) xyxy pixels, "labels": (N,) int64 in [0, C-1], "masks": (N, H, W) uint8}.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: detector
        self.detector = TorchvisionDetector(
            torchvision.models.detection.MaskRCNN(
                GraphBackbone(),
                rpn_anchor_generator=AnchorGenerator(
                    sizes=((32,), (64,), (128,)),
                    aspect_ratios=((0.5, 1, 2), (0.5, 1, 2), (0.5, 1, 2)),
                ),
                num_classes=21,
                box_roi_pool=MultiScaleRoIAlign(
                    featmap_names=["0", "1", "2"],
                    output_size=7,
                    sampling_ratio=2,
                ),
                mask_roi_pool=MultiScaleRoIAlign(
                    featmap_names=["0", "1", "2"],
                    output_size=14,
                    sampling_ratio=2,
                ),
                min_size=512,
                max_size=512,
            ),
        )

    def forward(self, image: torch.Tensor, targets: list[dict[str, torch.Tensor]] | None = None):
        return self.detector(image, targets)


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 512, 512),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"detector": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > mask-rcnn / pytorch > train.py 1`] = `
""""Train Mask R-CNN (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


def random_detection_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """1–5 random boxes (xyxy, pixels) with labels in [0, num_classes - 1]."""
    n = int(torch.randint(1, 6, ()).item())
    xy = torch.rand(n, 2) * torch.tensor([width * 0.7, height * 0.7])
    wh = torch.rand(n, 2) * torch.tensor([width * 0.25, height * 0.25]) + 8
    boxes = torch.cat([xy, (xy + wh).minimum(torch.tensor([width - 1.0, height - 1.0]))], dim=1)
    return {"boxes": boxes, "labels": torch.randint(0, num_classes, (n,))}


def random_instance_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """Random boxes plus a filled-rectangle mask per box (uint8, (N, H, W))."""
    target = random_detection_target(height, width, num_classes)
    masks = torch.zeros(len(target["boxes"]), height, width, dtype=torch.uint8)
    for mask, (x1, y1, x2, y2) in zip(masks, target["boxes"].round().long().tolist()):
        mask[y1:y2, x1:x2] = 1
    return {**target, "masks": masks}


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 512, 512), scaled to [0, 1]
    targets["detector"]: dict with "boxes" float (M, 4) xyxy pixels and "labels" int64 (M,) in [0, C-1], plus "masks" uint8 (
        M,
        H,
        W,
    )
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 512, 512),
        }
        targets = {
            "detector": random_instance_target(512, 512, 20),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Detection from COCO json (pip install pycocotools):

        from torchvision.datasets import CocoDetection, wrap_dataset_for_transforms_v2
        coco = wrap_dataset_for_transforms_v2(CocoDetection("images/", "instances.json"))
        # convert each sample to ({"image": img}, {head: {"boxes": xyxy, "labels": 0..C-1}})
        # and resize images to the declared input size, scaling boxes accordingly.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


class DetectionMAP:
    """COCO-style mAP via torchmetrics (pip install torchmetrics pycocotools); skipped if unavailable."""

    def __init__(self) -> None:
        try:
            from torchmetrics.detection import MeanAveragePrecision

            self.metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox")
        except Exception:  # torchmetrics / pycocotools missing
            self.metric = None

    def update(self, preds: list[dict[str, torch.Tensor]], targets: list[dict[str, torch.Tensor]]) -> None:
        if self.metric is not None:
            self.metric.update(
                [{k: v.detach().cpu() for k, v in p.items() if k in ("boxes", "scores", "labels")} for p in preds],
                [{k: v.detach().cpu() for k, v in t.items() if k in ("boxes", "labels")} for t in targets],
            )

    def compute(self) -> dict[str, float]:
        if self.metric is None:
            return {}
        result = self.metric.compute()
        return {"mAP": float(result["map"]), "mAP50": float(result["map_50"])}


def build_metrics() -> dict:
    return {
        "detector": DetectionMAP(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict) -> tuple[torch.Tensor, dict]:
    """torchvision detectors return their own loss dict in train mode."""
    losses = model(**inputs, targets=targets["detector"])
    losses = {k: v.float() for k, v in losses.items()}
    return sum(losses.values()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader) -> dict[str, float]:
    """Detection mAP (losses are only available in train mode for torchvision detectors)."""
    model.eval()
    metrics = build_metrics()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        preds = model(**inputs)
        for metric in metrics.values():
            metric.update(preds, targets["detector"])
    results: dict[str, float] = {}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    optimizer = torch.optim.AdamW(param_groups(model, WEIGHT_DECAY), lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > multitask / pytorch > model.py 1`] = `
""""Multi-task (cls + seg) — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 224, 224)  # image 3×224×224
Outputs:
    classifier: 10 classes (classification)
    segmenter: 5×224×224 mask (segmentation)
Parameters: 11.89M (11,887,823)
FLOPs: ~6.71 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn
import timm


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 224, 224],
            "norm": "imagenet",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 10,
            "output_shape": [10],
        },
        "segmenter": {
            "task": "segmentation",
            "classes": 5,
            "output_shape": [5, 224, 224],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class FPN(nn.Module):
    """Feature pyramid network: 1×1 laterals, top-down nearest upsampling, 3×3 output convs.

    Paper: Feature Pyramid Networks for Object Detection, Lin et al. 2017 (arXiv:1612.03144).
    """

    def __init__(self, in_channels: list[int], out_channels: int = 256) -> None:
        super().__init__()
        self.lateral = nn.ModuleList(nn.Conv2d(c, out_channels, 1) for c in in_channels)
        self.output = nn.ModuleList(nn.Conv2d(out_channels, out_channels, 3, padding=1) for _ in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        laterals = [conv(f) for conv, f in zip(self.lateral, feats)]
        for i in range(len(laterals) - 1, 0, -1):
            up = F.interpolate(laterals[i], size=laterals[i - 1].shape[-2:], mode="nearest")
            laterals[i - 1] = laterals[i - 1] + up
        return [conv(x) for conv, x in zip(self.output, laterals)]


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class SegmentationHead(nn.Module):
    """3×3 Conv·BN·ReLU → 1×1 classifier → bilinear upsample to the input resolution."""

    def __init__(self, c_in: int, num_classes: int, hidden: int, size: tuple[int, int]) -> None:
        super().__init__()
        self.size = size
        self.conv = ConvBNAct(c_in, hidden, 3, act="relu") if hidden > 0 else nn.Identity()
        self.cls = nn.Conv2d(hidden if hidden > 0 else c_in, num_classes, 1)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.cls(self.conv(x))
        return F.interpolate(x, size=self.size, mode="bilinear", align_corners=False)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """Multi-task (cls + seg).

    forward(image) returns a dict of head outputs.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → pyramid P3–P5 · 128/256/512
        self.backbone = TimmBackbone("resnet18", out_indices=(2, 3, 4), pretrained=True)
        # node: fpn → pyramid P3–P5 · 128/128/128
        self.fpn = FPN([128, 256, 512], out_channels=128)
        # node: classifier → 10 classes
        self.classifier = ClassificationHead(512, 10, pool="spatial")
        # node: segmenter → 5×224×224 mask
        self.segmenter = SegmentationHead(128, 5, hidden=128, size=(224, 224))

    def forward(self, image: torch.Tensor) -> dict[str, torch.Tensor]:
        backbone = self.backbone(image)
        level_1 = backbone[2]
        fpn = self.fpn(backbone)
        classifier = self.classifier(level_1)
        level_2 = fpn[0]
        segmenter = self.segmenter(level_2)
        return {"classifier": classifier, "segmenter": segmenter}


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SegmentationLoss(nn.Module):
    """Cross-entropy (BCE for a single class) + soft Dice.

    Paper: V-Net Dice loss, Milletari et al. 2016 (arXiv:1606.04797).
    """

    def __init__(self, num_classes: int, dice_weight: float = 1.0) -> None:
        super().__init__()
        self.num_classes = num_classes
        self.dice_weight = dice_weight

    def forward(self, logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        logits = logits.float()
        if self.num_classes == 1:
            target = target.float()
            base = F.binary_cross_entropy_with_logits(logits, target)
            prob, onehot, dims = logits.sigmoid(), target, (0, 2, 3)
        else:
            base = F.cross_entropy(logits, target)
            prob = logits.softmax(1)
            onehot = F.one_hot(target, self.num_classes).permute(0, 3, 1, 2).float()
            dims = (0, 2, 3)
        inter = (prob * onehot).sum(dims)
        union = prob.sum(dims) + onehot.sum(dims)
        dice = 1.0 - ((2.0 * inter + 1.0) / (union + 1.0)).mean()
        return base + self.dice_weight * dice


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 224, 224),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > multitask / pytorch > train.py 1`] = `
""""Train Multi-task (cls + seg) (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, SegmentationLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
    "segmenter": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 224, 224), ImageNet mean/std normalised
    targets["classifier"]: int64 class index in [0, 9]
    targets["segmenter"]: int64 mask (224, 224) with class ids in [0, 4]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 224, 224),
        }
        targets = {
            "classifier": torch.randint(0, 10, ()),
            "segmenter": torch.randint(0, 5, (224, 224)),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Image classification from class folders (data/train/<class>/*.jpg):

        from torchvision import datasets, transforms
        tf = transforms.Compose([
            transforms.RandomResizedCrop((224, 224)),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize((0.485, 0.456, 0.406), (0.229, 0.224, 0.225)),
        ])
        train = DictDataset(datasets.ImageFolder("data/train", tf), "image", "classifier")
    Segmentation: pair each image with an integer mask PNG of the same size
    (pixel value = class id; for a binary mask use 0/1 and return it as float (1, H, W)),
    e.g. torchvision.datasets.VOCSegmentation("data", image_set="train", download=True).
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
            "segmenter": SegmentationLoss(5, dice_weight=1.0),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


class MeanIoU:
    """Mean intersection-over-union from a running confusion matrix."""

    def __init__(self, num_classes: int) -> None:
        self.n = max(2, num_classes)
        self.confusion = torch.zeros(self.n, self.n, dtype=torch.long)

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if logits.shape[1] == 1:
            pred, target = (logits[:, 0] > 0).long(), target[:, 0].long()
        else:
            pred = logits.argmax(1)
        idx = target.flatten().cpu() * self.n + pred.flatten().cpu()
        self.confusion += torch.bincount(idx, minlength=self.n * self.n).reshape(self.n, self.n)

    def compute(self) -> dict[str, float]:
        inter = self.confusion.diag().float()
        union = self.confusion.sum(0).float() + self.confusion.sum(1).float() - inter
        iou = inter / union.clamp_min(1)
        return {"miou": iou[union > 0].mean().item() if (union > 0).any() else 0.0}


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
        "segmenter": MeanIoU(5),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > resnet18 / pytorch > model.py 1`] = `
""""ResNet-18 classifier — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 224, 224)  # image 3×224×224
Outputs:
    classifier: 1000 classes (classification)
Parameters: 11.69M (11,689,512)
FLOPs: ~3.64 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
from torch import nn


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 224, 224],
            "norm": "imagenet",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 1000,
            "output_shape": [1000],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class BasicBlock(nn.Module):
    """ResNet basic block: two 3×3 convs plus an identity or 1×1 projection shortcut.

    Paper: Deep Residual Learning, He et al. 2016 (arXiv:1512.03385).
    """

    def __init__(self, c_in: int, c_out: int, stride: int = 1) -> None:
        super().__init__()
        self.conv1 = ConvBNAct(c_in, c_out, 3, stride, act="relu")
        self.conv2 = ConvBNAct(c_out, c_out, 3, act="none")
        self.shortcut = (
            nn.Identity() if stride == 1 and c_in == c_out else ConvBNAct(c_in, c_out, 1, stride, act="none")
        )
        self.act = nn.ReLU(inplace=True)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.conv2(self.conv1(x)) + self.shortcut(x))


def make_stage(block: type[nn.Module], c_in: int, c_out: int, n: int, stride: int = 1, **kwargs) -> nn.Sequential:
    """Stack n blocks; only the first one changes the channel count / stride."""
    return nn.Sequential(*[block(c_in if i == 0 else c_out, c_out, stride if i == 0 else 1, **kwargs) for i in range(n)])


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """ResNet-18 classifier.

    forward(image) returns the classifier output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: stem → image 64×112×112
        self.stem = ConvBNAct(3, 64, k=7, s=2, act="relu")
        # node: maxpool → image 64×56×56
        self.maxpool = nn.MaxPool2d(kernel_size=3, stride=2, padding=1)
        # node: layer1 → image 64×56×56
        self.layer1 = make_stage(BasicBlock, 64, 64, n=2, stride=1)
        # node: layer2 → image 128×28×28
        self.layer2 = make_stage(BasicBlock, 64, 128, n=2, stride=2)
        # node: layer3 → image 256×14×14
        self.layer3 = make_stage(BasicBlock, 128, 256, n=2, stride=2)
        # node: layer4 → image 512×7×7
        self.layer4 = make_stage(BasicBlock, 256, 512, n=2, stride=2)
        # node: classifier → 1000 classes
        self.classifier = ClassificationHead(512, 1000)

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        stem = self.stem(image)
        maxpool = self.maxpool(stem)
        layer1 = self.layer1(maxpool)
        layer2 = self.layer2(layer1)
        layer3 = self.layer3(layer2)
        layer4 = self.layer4(layer3)
        gap = layer4.mean(dim=(2, 3))
        classifier = self.classifier(gap)
        return classifier


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 224, 224),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > resnet18 / pytorch > train.py 1`] = `
""""Train ResNet-18 classifier (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 224, 224), ImageNet mean/std normalised
    targets["classifier"]: int64 class index in [0, 999]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 224, 224),
        }
        targets = {
            "classifier": torch.randint(0, 1000, ()),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Image classification from class folders (data/train/<class>/*.jpg):

        from torchvision import datasets, transforms
        tf = transforms.Compose([
            transforms.RandomResizedCrop((224, 224)),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize((0.485, 0.456, 0.406), (0.229, 0.224, 0.225)),
        ])
        train = DictDataset(datasets.ImageFolder("data/train", tf), "image", "classifier")
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > resnet18 / tensorflow > model.py 1`] = `
""""ResNet-18 classifier — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 224, 224, 3)  # image 3×224×224
Outputs:
    classifier: 1000 classes (classification)
Parameters: 11.69M (11,689,512)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 224, 224, 3)",
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 1000,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def activation(name: str, layer_name: str) -> layers.Layer:
    """Activation layer by name ("none" gives an identity)."""
    if name == "leaky_relu":
        return layers.LeakyReLU(negative_slope=0.1, name=layer_name)
    if name == "relu6":
        return layers.ReLU(max_value=6.0, name=layer_name)
    if name == "hardswish":
        return layers.Activation("hard_swish", name=layer_name)
    if name == "none":
        return layers.Identity(name=layer_name)
    return layers.Activation(name, name=layer_name)


def conv_bn_act(x, filters: int, k: int = 3, s: int = 1, d: int = 1, groups: int = 1, act: str = "silu", name: str = "cba"):
    """Conv2D → BatchNormalization → activation with "same" padding (NHWC)."""
    if groups > 1 and groups == x.shape[-1] == filters:
        x = layers.DepthwiseConv2D(k, strides=s, padding="same", dilation_rate=d, use_bias=False, name=f"{name}_dw")(x)
    else:
        x = layers.Conv2D(
            filters, k, strides=s, padding="same", dilation_rate=d, groups=groups, use_bias=False, name=f"{name}_conv"
        )(x)
    x = layers.BatchNormalization(momentum=0.9, epsilon=1e-5, name=f"{name}_bn")(x)
    return activation(act, f"{name}_act")(x)


def basic_block(x, filters: int, stride: int = 1, name: str = "basic"):
    """ResNet basic block (He et al. 2016)."""
    shortcut = x
    if stride != 1 or x.shape[-1] != filters:
        shortcut = conv_bn_act(x, filters, 1, stride, act="none", name=f"{name}_proj")
    y = conv_bn_act(x, filters, 3, stride, act="relu", name=f"{name}_1")
    y = conv_bn_act(y, filters, 3, act="none", name=f"{name}_2")
    return layers.ReLU(name=f"{name}_out")(layers.Add(name=f"{name}_add")([y, shortcut]))


def repeat_block(x, block, n: int, filters: int, stride: int, name: str, **kwargs):
    """Apply block n times; only the first one changes channels / stride."""
    for i in range(n):
        x = block(x, filters, stride if i == 0 else 1, name=f"{name}_{i}", **kwargs)
    return x


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(224, 224, 3), name="image")
    # node: stem → image 64×112×112
    stem = conv_bn_act(image, 64, k=7, s=2, d=1, groups=1, act="relu", name="stem")
    # node: maxpool → image 64×56×56
    maxpool = layers.MaxPooling2D(pool_size=3, strides=2, padding="same", name="maxpool")(stem)
    # node: layer1 → image 64×56×56
    layer1 = repeat_block(maxpool, basic_block, 2, 64, 1, name="layer1")
    # node: layer2 → image 128×28×28
    layer2 = repeat_block(layer1, basic_block, 2, 128, 2, name="layer2")
    # node: layer3 → image 256×14×14
    layer3 = repeat_block(layer2, basic_block, 2, 256, 2, name="layer3")
    # node: layer4 → image 512×7×7
    layer4 = repeat_block(layer3, basic_block, 2, 512, 2, name="layer4")
    # node: gap → vector 512
    gap = layers.GlobalAveragePooling2D(name="gap")(layer4)
    # node: classifier → 1000 classes
    classifier = layers.Dense(1000, name="classifier")(gap)
    return keras.Model(inputs={"image": image}, outputs=classifier, name="ResNet_18_classifier")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 224, 224, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > resnet18 / tensorflow > train.py 1`] = `
""""Train ResNet-18 classifier with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 224, 224, 3)
    classifier: int64 class index in [0, 999]
    """
    inputs = {
        "image": np.random.rand(n, 224, 224, 3).astype("float32"),
    }
    targets = np.random.randint(0, 1000, size=(n,))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=["accuracy"],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > retinanet / pytorch > model.py 1`] = `
""""RetinaNet — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 512, 512)  # image 3×512×512
Outputs:
    detector: boxes + 20 cls (detection)
Parameters: 31.44M (31,435,809)
FLOPs: ~131.96 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import collections

import torch
import torch.nn.functional as F
from torch import nn
from torchvision.models.detection.anchor_utils import AnchorGenerator
from torchvision.ops import MultiScaleRoIAlign
import timm
import torchvision


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 512, 512],
            "norm": "0-1",
        },
    },
    "heads": {
        "detector": {
            "task": "detection",
            "classes": 20,
            "output_shape": [20],
            "strides": [8, 16, 32],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class FPN(nn.Module):
    """Feature pyramid network: 1×1 laterals, top-down nearest upsampling, 3×3 output convs.

    Paper: Feature Pyramid Networks for Object Detection, Lin et al. 2017 (arXiv:1612.03144).
    """

    def __init__(self, in_channels: list[int], out_channels: int = 256) -> None:
        super().__init__()
        self.lateral = nn.ModuleList(nn.Conv2d(c, out_channels, 1) for c in in_channels)
        self.output = nn.ModuleList(nn.Conv2d(out_channels, out_channels, 3, padding=1) for _ in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> list[torch.Tensor]:
        laterals = [conv(f) for conv, f in zip(self.lateral, feats)]
        for i in range(len(laterals) - 1, 0, -1):
            up = F.interpolate(laterals[i], size=laterals[i - 1].shape[-2:], mode="nearest")
            laterals[i - 1] = laterals[i - 1] + up
        return [conv(x) for conv, x in zip(self.output, laterals)]


class TorchvisionDetector(nn.Module):
    """Adapts a torchvision detector to batched image tensors and 0-based labels.

    torchvision reserves label 0 for background (num_classes = C + 1), so labels are shifted +1 for
    training and −1 in the predictions. Train mode returns a loss dict, eval mode a list of detections.
    """

    def __init__(self, detector: nn.Module) -> None:
        super().__init__()
        self.detector = detector

    def forward(self, images: torch.Tensor, targets: list[dict[str, torch.Tensor]] | None = None):
        if targets is not None:
            targets = [{**t, "labels": t["labels"] + 1} for t in targets]
        out = self.detector(list(images), targets)
        if self.training:
            return out
        return [{**o, "labels": o["labels"] - 1} for o in out]


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GraphBackbone(nn.Module):
    """Everything upstream of the detector; returns an OrderedDict of equal-channel feature maps."""

    def __init__(self) -> None:
        super().__init__()
        self.out_channels = 256
        # node: backbone → pyramid P3–P5 · 512/1024/2048
        self.backbone = TimmBackbone("resnet50", out_indices=(2, 3, 4), pretrained=True)
        # node: fpn → pyramid P3–P5 · 256/256/256
        self.fpn = FPN([512, 1024, 2048], out_channels=256)

    def forward(self, image: torch.Tensor) -> collections.OrderedDict[str, torch.Tensor]:
        backbone = self.backbone(image)
        fpn = self.fpn(backbone)
        return collections.OrderedDict(zip(("0", "1", "2"), fpn))


class GeneratedModel(nn.Module):
    """RetinaNet: RetinaNet on top of GraphBackbone.

    Training: model(image, targets) → dict of losses.
    Inference: model(image) → list of {"boxes", "labels", "scores"} per image.
    image: float tensor (B, 3, 512, 512) with values in [0, 1] (torchvision normalises internally).
    targets: list of {"boxes": (N, 4) xyxy pixels, "labels": (N,) int64 in [0, C-1]}.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: detector
        self.detector = TorchvisionDetector(
            torchvision.models.detection.RetinaNet(
                GraphBackbone(),
                anchor_generator=AnchorGenerator(
                    sizes=((32, 40, 51), (64, 81, 102), (128, 161, 203)),
                    aspect_ratios=((0.5, 1, 2), (0.5, 1, 2), (0.5, 1, 2)),
                ),
                num_classes=21,
                min_size=512,
                max_size=512,
            ),
        )

    def forward(self, image: torch.Tensor, targets: list[dict[str, torch.Tensor]] | None = None):
        return self.detector(image, targets)


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 512, 512),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"detector": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > retinanet / pytorch > train.py 1`] = `
""""Train RetinaNet (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


def random_detection_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """1–5 random boxes (xyxy, pixels) with labels in [0, num_classes - 1]."""
    n = int(torch.randint(1, 6, ()).item())
    xy = torch.rand(n, 2) * torch.tensor([width * 0.7, height * 0.7])
    wh = torch.rand(n, 2) * torch.tensor([width * 0.25, height * 0.25]) + 8
    boxes = torch.cat([xy, (xy + wh).minimum(torch.tensor([width - 1.0, height - 1.0]))], dim=1)
    return {"boxes": boxes, "labels": torch.randint(0, num_classes, (n,))}


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 512, 512), scaled to [0, 1]
    targets["detector"]: dict with "boxes" float (M, 4) xyxy pixels and "labels" int64 (M,) in [
        0,
        C-1,
    ]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 512, 512),
        }
        targets = {
            "detector": random_detection_target(512, 512, 20),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Detection from COCO json (pip install pycocotools):

        from torchvision.datasets import CocoDetection, wrap_dataset_for_transforms_v2
        coco = wrap_dataset_for_transforms_v2(CocoDetection("images/", "instances.json"))
        # convert each sample to ({"image": img}, {head: {"boxes": xyxy, "labels": 0..C-1}})
        # and resize images to the declared input size, scaling boxes accordingly.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


class DetectionMAP:
    """COCO-style mAP via torchmetrics (pip install torchmetrics pycocotools); skipped if unavailable."""

    def __init__(self) -> None:
        try:
            from torchmetrics.detection import MeanAveragePrecision

            self.metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox")
        except Exception:  # torchmetrics / pycocotools missing
            self.metric = None

    def update(self, preds: list[dict[str, torch.Tensor]], targets: list[dict[str, torch.Tensor]]) -> None:
        if self.metric is not None:
            self.metric.update(
                [{k: v.detach().cpu() for k, v in p.items() if k in ("boxes", "scores", "labels")} for p in preds],
                [{k: v.detach().cpu() for k, v in t.items() if k in ("boxes", "labels")} for t in targets],
            )

    def compute(self) -> dict[str, float]:
        if self.metric is None:
            return {}
        result = self.metric.compute()
        return {"mAP": float(result["map"]), "mAP50": float(result["map_50"])}


def build_metrics() -> dict:
    return {
        "detector": DetectionMAP(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict) -> tuple[torch.Tensor, dict]:
    """torchvision detectors return their own loss dict in train mode."""
    losses = model(**inputs, targets=targets["detector"])
    losses = {k: v.float() for k, v in losses.items()}
    return sum(losses.values()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader) -> dict[str, float]:
    """Detection mAP (losses are only available in train mode for torchvision detectors)."""
    model.eval()
    metrics = build_metrics()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        preds = model(**inputs)
        for metric in metrics.values():
            metric.update(preds, targets["detector"])
    results: dict[str, float] = {}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    optimizer = torch.optim.AdamW(param_groups(model, WEIGHT_DECAY), lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > segformer-lite / pytorch > model.py 1`] = `
""""SegFormer-lite — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 256, 256)  # image 3×256×256
Outputs:
    seg_head: 19×256×256 mask (segmentation)
Parameters: 2.88M (2,881,043)
FLOPs: ~4.03 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
import torch.nn.functional as F
from torch import nn


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 256, 256],
            "norm": "imagenet",
        },
    },
    "heads": {
        "seg_head": {
            "task": "segmentation",
            "classes": 19,
            "output_shape": [19, 256, 256],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


def apply_rope(x: torch.Tensor, base: float = 10000.0) -> torch.Tensor:
    """Rotary position embedding on the last axis of (B, H, N, Dh) queries / keys.

    Paper: RoFormer, Su et al. 2021 (arXiv:2104.09864).
    """
    n, dh = x.shape[-2], x.shape[-1]
    half = dh // 2
    freqs = base ** (-torch.arange(half, device=x.device, dtype=torch.float32) / half)
    angles = torch.arange(n, device=x.device, dtype=torch.float32)[:, None] * freqs[None]
    cos, sin = angles.cos().to(x.dtype), angles.sin().to(x.dtype)
    x1, x2 = x[..., :half], x[..., half : 2 * half]
    rotated = torch.cat([x1 * cos - x2 * sin, x1 * sin + x2 * cos], dim=-1)
    return torch.cat([rotated, x[..., 2 * half :]], dim=-1) if dh % 2 else rotated


class Attention(nn.Module):
    """Multi-head self-attention with fused scaled-dot-product attention and optional RoPE."""

    def __init__(self, dim: int, heads: int, dropout: float = 0.0, rope: bool = False) -> None:
        super().__init__()
        self.heads, self.dropout, self.rope = heads, dropout, rope
        self.qkv = nn.Linear(dim, 3 * dim)
        self.proj = nn.Linear(dim, dim)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        b, n, d = x.shape
        q, k, v = self.qkv(x).reshape(b, n, 3, self.heads, d // self.heads).permute(2, 0, 3, 1, 4)
        if self.rope:
            q, k = apply_rope(q), apply_rope(k)
        x = F.scaled_dot_product_attention(q, k, v, dropout_p=self.dropout if self.training else 0.0)
        return self.proj(x.transpose(1, 2).reshape(b, n, d))


class DropPath(nn.Module):
    """Stochastic depth: randomly drops the whole residual branch per sample.

    Paper: Deep Networks with Stochastic Depth, Huang et al. 2016 (arXiv:1603.09382).
    """

    def __init__(self, p: float = 0.0) -> None:
        super().__init__()
        self.p = p

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.p == 0.0 or not self.training:
            return x
        keep = 1.0 - self.p
        mask = x.new_empty((x.shape[0],) + (1,) * (x.ndim - 1)).bernoulli_(keep)
        return x * mask / keep


class TransformerBlock(nn.Module):
    """Pre-norm encoder block: x + Attention(LN(x)), then x + MLP(LN(x)).

    Papers: Attention Is All You Need (arXiv:1706.03762); ViT (arXiv:2010.11929).
    """

    def __init__(
        self, dim: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, drop_path: float = 0.0, rope: bool = False
    ) -> None:
        super().__init__()
        hidden = int(dim * mlp_ratio)
        self.norm1 = nn.LayerNorm(dim, eps=1e-6)
        self.attn = Attention(dim, heads, dropout, rope)
        self.norm2 = nn.LayerNorm(dim, eps=1e-6)
        self.mlp = nn.Sequential(
            nn.Linear(dim, hidden), nn.GELU(), nn.Dropout(dropout), nn.Linear(hidden, dim), nn.Dropout(dropout)
        )
        self.drop_path = DropPath(drop_path)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x + self.drop_path(self.attn(self.norm1(x)))
        return x + self.drop_path(self.mlp(self.norm2(x)))


class TransformerEncoder(nn.Module):
    """depth × pre-norm TransformerBlock (linearly increasing drop path) + final LayerNorm."""

    def __init__(
        self,
        dim: int,
        depth: int,
        heads: int,
        mlp_ratio: float = 4.0,
        dropout: float = 0.0,
        drop_path: float = 0.0,
        rope: bool = False,
    ) -> None:
        super().__init__()
        rates = [drop_path * i / max(1, depth - 1) for i in range(depth)]
        self.blocks = nn.ModuleList(TransformerBlock(dim, heads, mlp_ratio, dropout, r, rope) for r in rates)
        self.norm = nn.LayerNorm(dim, eps=1e-6)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        for block in self.blocks:
            x = block(x)
        return self.norm(x)


def seq_to_image(x: torch.Tensor, h: int, w: int, prefix: int = 0) -> torch.Tensor:
    """(B, prefix + h·w, D) token sequence → (B, D, h, w) feature map (drops prefix tokens)."""
    x = x[:, prefix:]
    return x.transpose(1, 2).reshape(x.shape[0], x.shape[2], h, w)


class SegmentationHead(nn.Module):
    """3×3 Conv·BN·ReLU → 1×1 classifier → bilinear upsample to the input resolution."""

    def __init__(self, c_in: int, num_classes: int, hidden: int, size: tuple[int, int]) -> None:
        super().__init__()
        self.size = size
        self.conv = ConvBNAct(c_in, hidden, 3, act="relu") if hidden > 0 else nn.Identity()
        self.cls = nn.Conv2d(hidden if hidden > 0 else c_in, num_classes, 1)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = self.cls(self.conv(x))
        return F.interpolate(x, size=self.size, mode="bilinear", align_corners=False)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """SegFormer-lite.

    forward(image) returns the seg_head output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: patch_merge1 → image 32×64×64
        self.patch_merge1 = ConvBNAct(3, 32, k=7, s=4, act="none")
        # node: stage1 → sequence 4096×32
        self.stage1 = TransformerEncoder(32, depth=1, heads=1, drop_path=0.1)
        # node: patch_merge2 → image 64×32×32
        self.patch_merge2 = ConvBNAct(32, 64, k=3, s=2, act="none")
        # node: stage2 → sequence 1024×64
        self.stage2 = TransformerEncoder(64, depth=1, heads=2, drop_path=0.1)
        # node: patch_merge3 → image 160×16×16
        self.patch_merge3 = ConvBNAct(64, 160, k=3, s=2, act="none")
        # node: mlp2 → image 128×32×32
        self.mlp2 = nn.Conv2d(64, 128, kernel_size=1, stride=1, padding=0, bias=True)
        # node: mlp1 → image 128×64×64
        self.mlp1 = nn.Conv2d(32, 128, kernel_size=1, stride=1, padding=0, bias=True)
        # node: stage3 → sequence 256×160
        self.stage3 = TransformerEncoder(160, depth=2, heads=5, drop_path=0.1)
        # node: patch_merge4 → image 256×8×8
        self.patch_merge4 = ConvBNAct(160, 256, k=3, s=2, act="none")
        # node: mlp3 → image 128×16×16
        self.mlp3 = nn.Conv2d(160, 128, kernel_size=1, stride=1, padding=0, bias=True)
        # node: stage4 → sequence 64×256
        self.stage4 = TransformerEncoder(256, depth=2, heads=8, drop_path=0.1)
        # node: mlp4 → image 128×8×8
        self.mlp4 = nn.Conv2d(256, 128, kernel_size=1, stride=1, padding=0, bias=True)
        # node: fuse → image 128×64×64
        self.fuse = ConvBNAct(512, 128, k=1, s=1, act="relu")
        # node: seg_head → 19×256×256 mask
        self.seg_head = SegmentationHead(128, 19, hidden=0, size=(256, 256))

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        patch_merge1 = self.patch_merge1(image)
        tokens_1 = patch_merge1.flatten(2).transpose(1, 2)
        stage1 = self.stage1(tokens_1)
        fmap_1 = seq_to_image(stage1, 64, 64, prefix=0)
        patch_merge2 = self.patch_merge2(fmap_1)
        tokens_2 = patch_merge2.flatten(2).transpose(1, 2)
        stage2 = self.stage2(tokens_2)
        fmap_2 = seq_to_image(stage2, 32, 32, prefix=0)
        patch_merge3 = self.patch_merge3(fmap_2)
        mlp2 = self.mlp2(fmap_2)
        tokens_3 = patch_merge3.flatten(2).transpose(1, 2)
        resized_1 = F.interpolate(
            mlp2,
            size=fmap_1.shape[-2:],
            mode="bilinear",
            align_corners=False,
        )
        mlp1 = self.mlp1(fmap_1)
        stage3 = self.stage3(tokens_3)
        fmap_3 = seq_to_image(stage3, 16, 16, prefix=0)
        patch_merge4 = self.patch_merge4(fmap_3)
        mlp3 = self.mlp3(fmap_3)
        tokens_4 = patch_merge4.flatten(2).transpose(1, 2)
        resized_2 = F.interpolate(
            mlp3,
            size=fmap_1.shape[-2:],
            mode="bilinear",
            align_corners=False,
        )
        stage4 = self.stage4(tokens_4)
        fmap_4 = seq_to_image(stage4, 8, 8, prefix=0)
        mlp4 = self.mlp4(fmap_4)
        resized_3 = F.interpolate(
            mlp4,
            size=fmap_1.shape[-2:],
            mode="bilinear",
            align_corners=False,
        )
        cat = torch.cat([mlp1, resized_1, resized_2, resized_3], dim=1)
        fuse = self.fuse(cat)
        seg_head = self.seg_head(fuse)
        return seg_head


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SegmentationLoss(nn.Module):
    """Cross-entropy (BCE for a single class) + soft Dice.

    Paper: V-Net Dice loss, Milletari et al. 2016 (arXiv:1606.04797).
    """

    def __init__(self, num_classes: int, dice_weight: float = 1.0) -> None:
        super().__init__()
        self.num_classes = num_classes
        self.dice_weight = dice_weight

    def forward(self, logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
        logits = logits.float()
        if self.num_classes == 1:
            target = target.float()
            base = F.binary_cross_entropy_with_logits(logits, target)
            prob, onehot, dims = logits.sigmoid(), target, (0, 2, 3)
        else:
            base = F.cross_entropy(logits, target)
            prob = logits.softmax(1)
            onehot = F.one_hot(target, self.num_classes).permute(0, 3, 1, 2).float()
            dims = (0, 2, 3)
        inter = (prob * onehot).sum(dims)
        union = prob.sum(dims) + onehot.sum(dims)
        dice = 1.0 - ((2.0 * inter + 1.0) / (union + 1.0)).mean()
        return base + self.dice_weight * dice


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 256, 256),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > segformer-lite / pytorch > train.py 1`] = `
""""Train SegFormer-lite (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, SegmentationLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0003  # transformers prefer a smaller LR
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "seg_head": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 256, 256), ImageNet mean/std normalised
    targets["seg_head"]: int64 mask (256, 256) with class ids in [0, 18]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 256, 256),
        }
        targets = {
            "seg_head": torch.randint(0, 19, (256, 256)),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Segmentation: pair each image with an integer mask PNG of the same size
    (pixel value = class id; for a binary mask use 0/1 and return it as float (1, H, W)),
    e.g. torchvision.datasets.VOCSegmentation("data", image_set="train", download=True).
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "seg_head": SegmentationLoss(19, dice_weight=1.0),
        }
    )


class MeanIoU:
    """Mean intersection-over-union from a running confusion matrix."""

    def __init__(self, num_classes: int) -> None:
        self.n = max(2, num_classes)
        self.confusion = torch.zeros(self.n, self.n, dtype=torch.long)

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if logits.shape[1] == 1:
            pred, target = (logits[:, 0] > 0).long(), target[:, 0].long()
        else:
            pred = logits.argmax(1)
        idx = target.flatten().cpu() * self.n + pred.flatten().cpu()
        self.confusion += torch.bincount(idx, minlength=self.n * self.n).reshape(self.n, self.n)

    def compute(self) -> dict[str, float]:
        inter = self.confusion.diag().float()
        union = self.confusion.sum(0).float() + self.confusion.sum(1).float() - inter
        iou = inter / union.clamp_min(1)
        return {"miou": iou[union > 0].mean().item() if (union > 0).any() else 0.0}


def build_metrics() -> dict:
    return {
        "seg_head": MeanIoU(19),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"seg_head": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > segformer-lite / tensorflow > model.py 1`] = `
""""SegFormer-lite — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 256, 256, 3)  # image 3×256×256
Outputs:
    seg_head: 19×256×256 mask (segmentation)
Parameters: 2.88M (2,881,043)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 256, 256, 3)",
    },
    "heads": {
        "seg_head": {
            "task": "segmentation",
            "classes": 19,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def activation(name: str, layer_name: str) -> layers.Layer:
    """Activation layer by name ("none" gives an identity)."""
    if name == "leaky_relu":
        return layers.LeakyReLU(negative_slope=0.1, name=layer_name)
    if name == "relu6":
        return layers.ReLU(max_value=6.0, name=layer_name)
    if name == "hardswish":
        return layers.Activation("hard_swish", name=layer_name)
    if name == "none":
        return layers.Identity(name=layer_name)
    return layers.Activation(name, name=layer_name)


def conv_bn_act(x, filters: int, k: int = 3, s: int = 1, d: int = 1, groups: int = 1, act: str = "silu", name: str = "cba"):
    """Conv2D → BatchNormalization → activation with "same" padding (NHWC)."""
    if groups > 1 and groups == x.shape[-1] == filters:
        x = layers.DepthwiseConv2D(k, strides=s, padding="same", dilation_rate=d, use_bias=False, name=f"{name}_dw")(x)
    else:
        x = layers.Conv2D(
            filters, k, strides=s, padding="same", dilation_rate=d, groups=groups, use_bias=False, name=f"{name}_conv"
        )(x)
    x = layers.BatchNormalization(momentum=0.9, epsilon=1e-5, name=f"{name}_bn")(x)
    return activation(act, f"{name}_act")(x)


def transformer_encoder(x, depth: int, heads: int, mlp_ratio: float = 4.0, dropout: float = 0.0, name: str = "encoder"):
    """depth × pre-norm transformer block + final LayerNorm (Vaswani 2017; ViT 2021)."""
    dim = x.shape[-1]
    for i in range(depth):
        p = f"{name}_{i}"
        h = layers.LayerNormalization(epsilon=1e-6, name=f"{p}_ln1")(x)
        h = layers.MultiHeadAttention(heads, dim // heads, dropout=dropout, name=f"{p}_attn")(h, h)
        x = layers.Add(name=f"{p}_add1")([x, h])
        h = layers.LayerNormalization(epsilon=1e-6, name=f"{p}_ln2")(x)
        h = layers.Dense(int(dim * mlp_ratio), activation="gelu", name=f"{p}_fc1")(h)
        h = layers.Dropout(dropout, name=f"{p}_drop")(h)
        h = layers.Dense(dim, name=f"{p}_fc2")(h)
        x = layers.Add(name=f"{p}_add2")([x, h])
    return layers.LayerNormalization(epsilon=1e-6, name=f"{name}_ln")(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(256, 256, 3), name="image")
    # node: patch_merge1 → image 32×64×64
    patch_merge1 = conv_bn_act(image, 32, k=7, s=4, d=1, groups=1, act="none", name="patch_merge1")
    # node: tokens_1 → sequence 4096×32
    tokens_1 = layers.Reshape((4096, 32), name="tokens_1")(patch_merge1)
    # node: stage1 → sequence 4096×32
    stage1 = transformer_encoder(tokens_1, depth=1, heads=1, mlp_ratio=4, dropout=0, name="stage1")
    # node: fmap_1 → image 32×64×64
    fmap_1 = layers.Reshape((64, 64, 32), name="fmap_1")(stage1)
    # node: patch_merge2 → image 64×32×32
    patch_merge2 = conv_bn_act(fmap_1, 64, k=3, s=2, d=1, groups=1, act="none", name="patch_merge2")
    # node: tokens_2 → sequence 1024×64
    tokens_2 = layers.Reshape((1024, 64), name="tokens_2")(patch_merge2)
    # node: stage2 → sequence 1024×64
    stage2 = transformer_encoder(tokens_2, depth=1, heads=2, mlp_ratio=4, dropout=0, name="stage2")
    # node: fmap_2 → image 64×32×32
    fmap_2 = layers.Reshape((32, 32, 64), name="fmap_2")(stage2)
    # node: patch_merge3 → image 160×16×16
    patch_merge3 = conv_bn_act(
        fmap_2,
        160,
        k=3,
        s=2,
        d=1,
        groups=1,
        act="none",
        name="patch_merge3",
    )
    # node: mlp2 → image 128×32×32
    mlp2 = layers.Conv2D(128, kernel_size=1, strides=1, padding="same", dilation_rate=1, groups=1, use_bias=True, name="mlp2")(
        fmap_2,
    )
    # node: tokens_3 → sequence 256×160
    tokens_3 = layers.Reshape((256, 160), name="tokens_3")(patch_merge3)
    # node: resized_1 → image 128×64×64
    resized_1 = layers.Resizing(64, 64, interpolation="bilinear", name="resized_1")(mlp2)
    # node: mlp1 → image 128×64×64
    mlp1 = layers.Conv2D(128, kernel_size=1, strides=1, padding="same", dilation_rate=1, groups=1, use_bias=True, name="mlp1")(
        fmap_1,
    )
    # node: stage3 → sequence 256×160
    stage3 = transformer_encoder(tokens_3, depth=2, heads=5, mlp_ratio=4, dropout=0, name="stage3")
    # node: fmap_3 → image 160×16×16
    fmap_3 = layers.Reshape((16, 16, 160), name="fmap_3")(stage3)
    # node: patch_merge4 → image 256×8×8
    patch_merge4 = conv_bn_act(
        fmap_3,
        256,
        k=3,
        s=2,
        d=1,
        groups=1,
        act="none",
        name="patch_merge4",
    )
    # node: mlp3 → image 128×16×16
    mlp3 = layers.Conv2D(128, kernel_size=1, strides=1, padding="same", dilation_rate=1, groups=1, use_bias=True, name="mlp3")(
        fmap_3,
    )
    # node: tokens_4 → sequence 64×256
    tokens_4 = layers.Reshape((64, 256), name="tokens_4")(patch_merge4)
    # node: resized_2 → image 128×64×64
    resized_2 = layers.Resizing(64, 64, interpolation="bilinear", name="resized_2")(mlp3)
    # node: stage4 → sequence 64×256
    stage4 = transformer_encoder(tokens_4, depth=2, heads=8, mlp_ratio=4, dropout=0, name="stage4")
    # node: fmap_4 → image 256×8×8
    fmap_4 = layers.Reshape((8, 8, 256), name="fmap_4")(stage4)
    # node: mlp4 → image 128×8×8
    mlp4 = layers.Conv2D(128, kernel_size=1, strides=1, padding="same", dilation_rate=1, groups=1, use_bias=True, name="mlp4")(
        fmap_4,
    )
    # node: resized_3 → image 128×64×64
    resized_3 = layers.Resizing(64, 64, interpolation="bilinear", name="resized_3")(mlp4)
    # node: cat → image 512×64×64
    cat = layers.Concatenate(axis=-1, name="cat")([mlp1, resized_1, resized_2, resized_3])
    # node: fuse → image 128×64×64
    fuse = conv_bn_act(cat, 128, k=1, s=1, d=1, groups=1, act="relu", name="fuse")
    # node: seg_head → 19×256×256 mask
    seg_head = layers.Resizing(256, 256, interpolation="bilinear", name="seg_head")(
        layers.Conv2D(19, 1, name="seg_head_cls")(fuse),
    )
    return keras.Model(inputs={"image": image}, outputs=seg_head, name="SegFormer_lite")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 256, 256, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"seg_head": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > segformer-lite / tensorflow > train.py 1`] = `
""""Train SegFormer-lite with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 8
LR = 0.0003
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 256, 256, 3)
    seg_head: int64 mask (256, 256) with class ids in [0, 18]
    """
    inputs = {
        "image": np.random.rand(n, 256, 256, 3).astype("float32"),
    }
    targets = np.random.randint(0, 19, size=(n, 256, 256))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=[keras.metrics.MeanIoU(num_classes=19, sparse_y_pred=False)],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > simple-cnn / pytorch > model.py 1`] = `
""""Simple CNN classifier — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 64, 64)  # image 3×64×64
Outputs:
    classifier: 10 classes (classification)
Parameters: 94.8K (94,762)
FLOPs: ~0.08 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import torch
from torch import nn


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 64, 64],
            "norm": "imagenet",
        },
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 10,
            "output_shape": [10],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def make_act(name: str) -> nn.Module:
    """Build an activation module by name ("none" gives an identity)."""
    if name == "relu":
        return nn.ReLU(inplace=True)
    if name == "relu6":
        return nn.ReLU6(inplace=True)
    if name == "silu":
        return nn.SiLU(inplace=True)
    if name == "gelu":
        return nn.GELU()
    if name == "leaky_relu":
        return nn.LeakyReLU(0.1, inplace=True)
    if name == "hardswish":
        return nn.Hardswish(inplace=True)
    if name == "mish":
        return nn.Mish(inplace=True)
    if name == "sigmoid":
        return nn.Sigmoid()
    if name == "tanh":
        return nn.Tanh()
    return nn.Identity()


class ConvBNAct(nn.Module):
    """Conv2d → BatchNorm2d → activation, with "same" padding by default."""

    def __init__(
        self,
        c_in: int,
        c_out: int,
        k: int = 3,
        s: int = 1,
        d: int = 1,
        g: int = 1,
        act: str = "silu",
    ) -> None:
        super().__init__()
        self.conv = nn.Conv2d(c_in, c_out, k, s, d * (k - 1) // 2, dilation=d, groups=g, bias=False)
        self.bn = nn.BatchNorm2d(c_out)
        self.act = make_act(act)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.act(self.bn(self.conv(x)))


class ClassificationHead(nn.Module):
    """Pool (if needed) → optional hidden MLP → dropout → linear class logits."""

    def __init__(self, c_in: int, num_classes: int, hidden: int = 0, dropout: float = 0.0, pool: str = "none") -> None:
        super().__init__()
        self.pool = pool
        layers: list[nn.Module] = []
        if hidden > 0:
            layers += [nn.Linear(c_in, hidden), nn.GELU()]
            c_in = hidden
        layers += [nn.Dropout(dropout), nn.Linear(c_in, num_classes)]
        self.mlp = nn.Sequential(*layers)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if self.pool == "spatial":
            x = x.mean(dim=(2, 3))
        elif self.pool == "tokens":
            x = x.mean(dim=1)
        return self.mlp(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """Simple CNN classifier.

    forward(image) returns the classifier output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: cba_1 → image 32×64×64
        self.cba_1 = ConvBNAct(3, 32, k=3, s=1, act="silu")
        # node: cba_2 → image 64×32×32
        self.cba_2 = ConvBNAct(32, 64, k=3, s=2, act="silu")
        # node: cba_3 → image 128×16×16
        self.cba_3 = ConvBNAct(64, 128, k=3, s=2, act="silu")
        # node: classifier → 10 classes
        self.classifier = ClassificationHead(128, 10)

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        cba_1 = self.cba_1(image)
        cba_2 = self.cba_2(cba_1)
        cba_3 = self.cba_3(cba_2)
        gap = cba_3.mean(dim=(2, 3))
        classifier = self.classifier(gap)
        return classifier


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 64, 64),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > simple-cnn / pytorch > train.py 1`] = `
""""Train Simple CNN classifier (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "classifier": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 64, 64), ImageNet mean/std normalised
    targets["classifier"]: int64 class index in [0, 9]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.randn(3, 64, 64),
        }
        targets = {
            "classifier": torch.randint(0, 10, ()),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Image classification from class folders (data/train/<class>/*.jpg):

        from torchvision import datasets, transforms
        tf = transforms.Compose([
            transforms.RandomResizedCrop((64, 64)),
            transforms.RandomHorizontalFlip(),
            transforms.ToTensor(),
            transforms.Normalize((0.485, 0.456, 0.406), (0.229, 0.224, 0.225)),
        ])
        train = DictDataset(datasets.ImageFolder("data/train", tf), "image", "classifier")
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "classifier": nn.CrossEntropyLoss(label_smoothing=0.1),
        }
    )


class Accuracy:
    """Top-1 / top-5 accuracy for (B, C) logits, token accuracy for (B, L, C) logits (-100 ignored)."""

    def __init__(self) -> None:
        self.correct = self.correct5 = self.total = 0

    def update(self, logits: torch.Tensor, target: torch.Tensor) -> None:
        if not logits.is_floating_point():  # already-decoded tags (e.g. CRF Viterbi), (B, L)
            mask = target != -100
            self.correct += (logits[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        if logits.ndim == 3:
            mask = target != -100
            self.correct += (logits.argmax(-1)[mask] == target[mask]).sum().item()
            self.total += mask.sum().item()
            return
        k = min(5, logits.shape[1])
        top = logits.topk(k, dim=1).indices
        self.correct += (top[:, 0] == target).sum().item()
        self.correct5 += (top == target[:, None]).any(dim=1).sum().item()
        self.total += target.numel()

    def compute(self) -> dict[str, float]:
        out = {"acc": self.correct / max(1, self.total)}
        if self.correct5:
            out["top5"] = self.correct5 / max(1, self.total)
        return out


def build_metrics() -> dict:
    return {
        "classifier": Accuracy(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"classifier": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > simple-cnn / tensorflow > model.py 1`] = `
""""Simple CNN classifier — Keras 3 model (functional API, NHWC) generated by Netloom.

Inputs:
    image: (B, 64, 64, 3)  # image 3×64×64
Outputs:
    classifier: 10 classes (classification)
Parameters: 94.8K (94,762)

Run \`python model.py\` for a smoke test. Train with \`python train.py\`.
"""

from __future__ import annotations

import keras
import numpy as np
from keras import layers, ops


CONFIG = {
    "inputs": {
        "image": "(None, 64, 64, 3)",
    },
    "heads": {
        "classifier": {
            "task": "classification",
            "classes": 10,
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


def activation(name: str, layer_name: str) -> layers.Layer:
    """Activation layer by name ("none" gives an identity)."""
    if name == "leaky_relu":
        return layers.LeakyReLU(negative_slope=0.1, name=layer_name)
    if name == "relu6":
        return layers.ReLU(max_value=6.0, name=layer_name)
    if name == "hardswish":
        return layers.Activation("hard_swish", name=layer_name)
    if name == "none":
        return layers.Identity(name=layer_name)
    return layers.Activation(name, name=layer_name)


def conv_bn_act(x, filters: int, k: int = 3, s: int = 1, d: int = 1, groups: int = 1, act: str = "silu", name: str = "cba"):
    """Conv2D → BatchNormalization → activation with "same" padding (NHWC)."""
    if groups > 1 and groups == x.shape[-1] == filters:
        x = layers.DepthwiseConv2D(k, strides=s, padding="same", dilation_rate=d, use_bias=False, name=f"{name}_dw")(x)
    else:
        x = layers.Conv2D(
            filters, k, strides=s, padding="same", dilation_rate=d, groups=groups, use_bias=False, name=f"{name}_conv"
        )(x)
    x = layers.BatchNormalization(momentum=0.9, epsilon=1e-5, name=f"{name}_bn")(x)
    return activation(act, f"{name}_act")(x)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


def build_model() -> keras.Model:
    """Construct the model defined in the Netloom graph."""
    image = keras.Input(shape=(64, 64, 3), name="image")
    # node: cba_1 → image 32×64×64
    cba_1 = conv_bn_act(image, 32, k=3, s=1, d=1, groups=1, act="silu", name="cba_1")
    # node: cba_2 → image 64×32×32
    cba_2 = conv_bn_act(cba_1, 64, k=3, s=2, d=1, groups=1, act="silu", name="cba_2")
    # node: cba_3 → image 128×16×16
    cba_3 = conv_bn_act(cba_2, 128, k=3, s=2, d=1, groups=1, act="silu", name="cba_3")
    # node: gap → vector 128
    gap = layers.GlobalAveragePooling2D(name="gap")(cba_3)
    # node: classifier → 10 classes
    classifier = layers.Dense(10, name="classifier")(gap)
    return keras.Model(inputs={"image": image}, outputs=classifier, name="Simple_CNN_classifier")


def example_inputs(batch_size: int = 2) -> dict[str, np.ndarray]:
    """Random inputs with the declared shapes (NHWC)."""
    return {
        "image": np.random.rand(batch_size, 64, 64, 3).astype("float32"),
    }


if __name__ == "__main__":
    model = build_model()
    outputs = model(example_inputs(), training=False)
    if not isinstance(outputs, dict):
        outputs = {"classifier": outputs}
    for name, value in outputs.items():
        print(f"{name}: {tuple(value.shape)}")
    print(f"parameters: {model.count_params():,}")
"
`;

exports[`codegen snapshots > simple-cnn / tensorflow > train.py 1`] = `
""""Train Simple CNN classifier with Keras 3 (generated by Netloom).

    python train.py                       # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --epochs 1 --max-steps 2

Replace synthetic_dataset() with a real tf.data pipeline yielding the same structure.
"""

from __future__ import annotations

import argparse
import os

import keras
import numpy as np
import tensorflow as tf

from model import build_model


EPOCHS = 30
BATCH_SIZE = 32
LR = 0.001
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 1
TRAIN_SAMPLES = 256
VAL_SAMPLES = 64
OUT_DIR = "checkpoints"


def synthetic_dataset(n: int, batch_size: int, shuffle: bool) -> tf.data.Dataset:
    """Random (inputs, targets) with the exact shapes the model expects.

    Real data must provide the same structure (NHWC images):
    image: (N, 64, 64, 3)
    classifier: int64 class index in [0, 9]
    """
    inputs = {
        "image": np.random.rand(n, 64, 64, 3).astype("float32"),
    }
    targets = np.random.randint(0, 10, size=(n,))
    ds = tf.data.Dataset.from_tensor_slices((inputs, targets))
    if shuffle:
        ds = ds.shuffle(n)
    return ds.batch(batch_size, drop_remainder=shuffle).prefetch(tf.data.AUTOTUNE)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="limit steps per epoch (0 = full epoch)",
    )
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    keras.utils.set_random_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_ds = synthetic_dataset(TRAIN_SAMPLES, args.batch_size, shuffle=True)
    val_ds = synthetic_dataset(VAL_SAMPLES, args.batch_size, shuffle=False)
    steps = args.max_steps or TRAIN_SAMPLES // args.batch_size
    total = max(1, steps * args.epochs)
    schedule = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=0.0,
        decay_steps=total,
        warmup_target=args.lr,
        warmup_steps=min(WARMUP_EPOCHS * steps, max(1, total // 10)),
    )
    model = build_model()
    model.compile(
        optimizer=keras.optimizers.AdamW(learning_rate=schedule, weight_decay=WEIGHT_DECAY, clipnorm=1.0),
        loss=keras.losses.SparseCategoricalCrossentropy(from_logits=True),
        metrics=["accuracy"],
    )
    model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=args.epochs,
        steps_per_epoch=steps,
        validation_steps=1 if args.max_steps else None,
        callbacks=[keras.callbacks.ModelCheckpoint(os.path.join(args.out, "best.keras"), save_best_only=True)],
    )
    model.save(os.path.join(args.out, "last.keras"))
    if not args.no_export:
        export_dir = os.path.join(args.out, "saved_model")
        model.export(export_dir)
        converter = tf.lite.TFLiteConverter.from_saved_model(export_dir)
        converter.optimizations = [tf.lite.Optimize.DEFAULT]
        with open(os.path.join(args.out, "model.tflite"), "wb") as f:
            f.write(converter.convert())
        print(f"exported {export_dir} and model.tflite")


if __name__ == "__main__":
    main()
"
`;

exports[`codegen snapshots > ssd-mobilenet / pytorch > model.py 1`] = `
""""SSD-MobileNetV3 — PyTorch model generated by Netloom.

Inputs:
    image: (B, 3, 320, 320)  # image 3×320×320
Outputs:
    ssd: boxes + 20 cls (detection)
Parameters: 3.97M (3,973,052)
FLOPs: ~7.53 GFLOPs per sample at the declared input size.

Run \`python model.py\` for a smoke test (builds the model, runs a dummy forward pass,
prints every output shape and the parameter count). Train with \`python train.py\`.
"""

from __future__ import annotations

import math

import torch
import torch.nn.functional as F
from torch import nn
import timm
import torchvision


CONFIG = {
    "inputs": {
        "image": {
            "kind": "image",
            "shape": [3, 320, 320],
            "norm": "0-1",
        },
    },
    "heads": {
        "ssd": {
            "task": "detection",
            "classes": 20,
            "output_shape": [20],
            "strides": [8, 16, 32],
        },
    },
}


# ---------------------------------------------------------------------------
# Building blocks
# ---------------------------------------------------------------------------


class TimmBackbone(nn.Module):
    """timm feature extractor returning one feature map or a list of maps (e.g. strides 8 / 16 / 32).

    Pretrained weights expect 3-channel images normalised with ImageNet mean / std.
    freeze_stages=n freezes the stem and the first n feature stages (requires_grad=False).
    """

    def __init__(
        self, name: str, out_indices: tuple[int, ...], pretrained: bool = False, freeze_stages: int = 0, in_chans: int = 3
    ) -> None:
        super().__init__()
        self.body = timm.create_model(
            name, pretrained=pretrained, features_only=True, out_indices=out_indices, in_chans=in_chans
        )
        self.single = len(out_indices) == 1
        self.freeze(freeze_stages)

    def freeze(self, n: int) -> None:
        infos = self.body.feature_info.info
        if n <= 0:
            return
        params = list(self.body.named_parameters())
        stop = len(params)
        if n < len(infos):
            nxt = infos[n]["module"]
            owners = (f".{nxt}.", f".{nxt.replace('.', '_')}.")
            stop = next((i for i, (k, _) in enumerate(params) if any(o in f".{k}" for o in owners)), stop)
        for _, p in params[:stop]:
            p.requires_grad_(False)

    def forward(self, x: torch.Tensor) -> torch.Tensor | list[torch.Tensor]:
        feats = self.body(x)
        return feats[0] if self.single else feats


class SSDHead(nn.Module):
    """SSD multibox head: per level 3×3 convs for A·(C + 1) class logits and A·4 box offsets.

    Returns (B, N, 4 + C + 1) with offsets first; class 0 is background inside the head.
    Paper: SSD, Liu et al. 2016 (arXiv:1512.02325).
    """

    def __init__(self, in_channels: list[int], num_classes: int, num_anchors: int = 4) -> None:
        super().__init__()
        self.nc = num_classes
        self.cls = nn.ModuleList(nn.Conv2d(c, num_anchors * (num_classes + 1), 3, padding=1) for c in in_channels)
        self.reg = nn.ModuleList(nn.Conv2d(c, num_anchors * 4, 3, padding=1) for c in in_channels)

    def forward(self, feats: list[torch.Tensor]) -> torch.Tensor:
        cls, reg = [], []
        for f, c, r in zip(feats, self.cls, self.reg):
            b = f.shape[0]
            cls.append(c(f).permute(0, 2, 3, 1).reshape(b, -1, self.nc + 1))
            reg.append(r(f).permute(0, 2, 3, 1).reshape(b, -1, 4))
        return torch.cat([torch.cat(reg, dim=1), torch.cat(cls, dim=1)], dim=-1)


def ssd_default_boxes(
    feat_sizes: list[tuple[int, int]],
    image_size: tuple[int, int],
    ratios: tuple[float, ...] = (1.0, 2.0, 0.5),
    smin: float = 0.1,
    smax: float = 0.9,
) -> torch.Tensor:
    """Default boxes (cx, cy, w, h in pixels), ordered like SSDHead outputs: level, y, x, anchor."""
    height, width = image_size
    levels = len(feat_sizes)
    scales = [smin + (smax - smin) * k / max(1, levels - 1) for k in range(levels)] + [1.0]
    boxes = []
    for k, (h, w) in enumerate(feat_sizes):
        s, s_next = scales[k], scales[k + 1]
        whs = [(s * math.sqrt(r), s / math.sqrt(r)) for r in ratios] + [(math.sqrt(s * s_next),) * 2]
        yy, xx = torch.meshgrid((torch.arange(h) + 0.5) / h, (torch.arange(w) + 0.5) / w, indexing="ij")
        centers = torch.stack([xx, yy], dim=-1).reshape(-1, 1, 2).expand(-1, len(whs), 2)
        sizes = torch.tensor(whs).expand(h * w, -1, -1)
        boxes.append(torch.cat([centers, sizes], dim=-1).reshape(-1, 4))
    return torch.cat(boxes) * torch.tensor([width, height, width, height], dtype=torch.float32)


def ssd_encode(boxes: torch.Tensor, anchors: torch.Tensor) -> torch.Tensor:
    """cxcywh boxes → offsets relative to anchors (variances 0.1 / 0.2)."""
    xy = (boxes[:, :2] - anchors[:, :2]) / anchors[:, 2:] / 0.1
    wh = torch.log(boxes[:, 2:] / anchors[:, 2:]) / 0.2
    return torch.cat([xy, wh], dim=-1)


def ssd_decode(offsets: torch.Tensor, anchors: torch.Tensor) -> torch.Tensor:
    """Offsets → xyxy boxes in pixels."""
    xy = offsets[..., :2] * 0.1 * anchors[:, 2:] + anchors[:, :2]
    wh = torch.exp(offsets[..., 2:] * 0.2) * anchors[:, 2:]
    return torch.cat([xy - wh / 2, xy + wh / 2], dim=-1)


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------


class GeneratedModel(nn.Module):
    """SSD-MobileNetV3.

    forward(image) returns the ssd output.
    """

    def __init__(self) -> None:
        super().__init__()
        # node: backbone → pyramid P3–P5 · 40/112/960
        self.backbone = TimmBackbone(
            "mobilenetv3_large_100",
            out_indices=(2, 3, 4),
            pretrained=True,
        )
        # node: ssd → boxes + 20 cls
        self.ssd = SSDHead([40, 112, 960], 20)

    def forward(self, image: torch.Tensor) -> torch.Tensor:
        backbone = self.backbone(image)
        ssd = self.ssd(backbone)
        return ssd


# ---------------------------------------------------------------------------
# Post-processing
# ---------------------------------------------------------------------------


@torch.no_grad()
def ssd_postprocess(
    preds: torch.Tensor,
    feat_sizes: list[tuple[int, int]],
    image_size: tuple[int, int],
    conf: float = 0.01,
    iou: float = 0.45,
    max_det: int = 200,
) -> list[dict[str, torch.Tensor]]:
    """Softmax scores (background dropped), decode offsets, class-wise NMS; labels are 0-based."""
    preds = preds.float()
    anchors = ssd_default_boxes(feat_sizes, image_size).to(preds.device)
    boxes = ssd_decode(preds[..., :4], anchors)
    scores = preds[..., 4:].softmax(-1)[..., 1:]
    results = []
    for b in range(preds.shape[0]):
        anchor_idx, label = (scores[b] > conf).nonzero(as_tuple=True)
        bx, score = boxes[b][anchor_idx], scores[b][anchor_idx, label]
        keep = torchvision.ops.batched_nms(bx, score, label, iou)[:max_det]
        results.append({"boxes": bx[keep], "scores": score[keep], "labels": label[keep]})
    return results


# ---------------------------------------------------------------------------
# Losses
# ---------------------------------------------------------------------------


class SSDLoss(nn.Module):
    """Multibox loss: IoU ≥ 0.5 matching (plus the best anchor of every box), smooth-L1 on offsets,
    cross-entropy with 3:1 hard-negative mining. Labels shift +1 internally (0 = background)."""

    def __init__(self, feat_sizes: list[tuple[int, int]], image_size: tuple[int, int], neg_ratio: float = 3.0, iou: float = 0.5) -> None:
        super().__init__()
        anchors = ssd_default_boxes(feat_sizes, image_size)
        self.register_buffer("anchors", anchors, persistent=False)
        self.register_buffer("anchors_xyxy", torchvision.ops.box_convert(anchors, "cxcywh", "xyxy"), persistent=False)
        self.neg_ratio, self.iou = neg_ratio, iou

    def match(self, boxes: torch.Tensor, labels: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
        n = self.anchors.shape[0]
        if boxes.numel() == 0:
            return torch.zeros(n, dtype=torch.long, device=boxes.device), self.anchors.new_zeros(n, 4)
        iou = torchvision.ops.box_iou(boxes, self.anchors_xyxy)
        best_iou, best_gt = iou.max(dim=0)
        best_anchor = iou.argmax(dim=1)
        best_gt[best_anchor] = torch.arange(len(boxes), device=boxes.device)
        best_iou[best_anchor] = 1.0
        target_labels = labels[best_gt] + 1
        target_labels[best_iou < self.iou] = 0
        matched = torchvision.ops.box_convert(boxes[best_gt], "xyxy", "cxcywh")
        return target_labels, ssd_encode(matched, self.anchors)

    def forward(self, preds: torch.Tensor, targets: list[dict[str, torch.Tensor]]) -> torch.Tensor:
        preds = preds.float()
        total = preds.new_zeros(())
        for i, t in enumerate(targets):
            labels, offsets = self.match(t["boxes"].float(), t["labels"])
            pos = labels > 0
            num_pos = pos.sum().clamp_min(1)
            ce = F.cross_entropy(preds[i, :, 4:], labels, reduction="none")
            neg_ce = ce.masked_fill(pos, 0.0)
            k = int(min(self.neg_ratio * num_pos.item(), (~pos).sum().item()))
            hard = neg_ce.topk(k).indices
            loss_cls = (ce[pos].sum() + ce[hard].sum()) / num_pos
            loss_box = F.smooth_l1_loss(preds[i, pos, :4], offsets[pos], reduction="sum") / num_pos
            total = total + loss_cls + loss_box
        return total / len(targets)


def build_model() -> nn.Module:
    """Construct the model defined in the Netloom graph."""
    return GeneratedModel()


def count_parameters(model: nn.Module) -> int:
    return sum(p.numel() for p in model.parameters())


def example_inputs(batch_size: int = 2) -> dict[str, torch.Tensor]:
    """Random inputs with the declared shapes."""
    return {
        "image": torch.randn(batch_size, 3, 320, 320),
    }


def describe(value: object) -> str:
    """Readable shape summary for tensors, lists and dicts of tensors."""
    if isinstance(value, torch.Tensor):
        return str(tuple(value.shape))
    if isinstance(value, dict):
        return "{" + ", ".join(f"{k}: {describe(v)}" for k, v in value.items()) + "}"
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(describe(v) for v in value) + "]"
    return type(value).__name__


if __name__ == "__main__":
    model = build_model().eval()
    with torch.no_grad():
        outputs = model(**example_inputs())
    if not isinstance(outputs, dict):
        outputs = {"ssd": outputs}
    for name, value in outputs.items():
        print(f"{name}: {describe(value)}")
    print(f"parameters: {count_parameters(model):,}")
"
`;

exports[`codegen snapshots > ssd-mobilenet / pytorch > train.py 1`] = `
""""Train SSD-MobileNetV3 (generated by Netloom).

    python train.py                              # synthetic data: runs immediately
    python train.py --epochs 50 --batch-size 64
    python train.py --resume checkpoints/last.pt
    python train.py --epochs 1 --max-steps 2     # quick check

Replace SyntheticDataset in build_datasets() with real data; the docstrings give the exact format.
"""

from __future__ import annotations

import argparse
import copy
import math
import os
import time

import torch
from torch import nn
from torch.utils.data import DataLoader, Dataset, default_collate

from model import build_model, CONFIG, example_inputs, ssd_postprocess, SSDLoss


# ---------------------------------------------------------------------------
# Hyper-parameters
# ---------------------------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 8
LR = 0.0001  # low: the backbone is pretrained
WEIGHT_DECAY = 0.05
WARMUP_EPOCHS = 3
GRAD_CLIP = 1.0  # max gradient norm, 0 disables
USE_EMA = True  # exponential moving average of the weights for evaluation
EMA_DECAY = 0.999
NUM_WORKERS = 0
OUT_DIR = "checkpoints"
LOSS_WEIGHTS = {
    "ssd": 1.0,
}
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
USE_AMP = DEVICE == "cuda"


# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------


def random_detection_target(height: int, width: int, num_classes: int) -> dict[str, torch.Tensor]:
    """1–5 random boxes (xyxy, pixels) with labels in [0, num_classes - 1]."""
    n = int(torch.randint(1, 6, ()).item())
    xy = torch.rand(n, 2) * torch.tensor([width * 0.7, height * 0.7])
    wh = torch.rand(n, 2) * torch.tensor([width * 0.25, height * 0.25]) + 8
    boxes = torch.cat([xy, (xy + wh).minimum(torch.tensor([width - 1.0, height - 1.0]))], dim=1)
    return {"boxes": boxes, "labels": torch.randint(0, num_classes, (n,))}


class SyntheticDataset(Dataset):
    """Random samples with exactly the shapes the model and losses expect.

    Real data must yield the same (inputs, targets) structure:
    inputs["image"]: float32 (3, 320, 320), scaled to [0, 1]
    targets["ssd"]: dict with "boxes" float (M, 4) xyxy pixels and "labels" int64 (M,) in [0, C-1]
    """

    def __init__(self, length: int = 256) -> None:
        self.length = length

    def __len__(self) -> int:
        return self.length

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        inputs = {
            "image": torch.rand(3, 320, 320),
        }
        targets = {
            "ssd": random_detection_target(320, 320, 20),
        }
        return inputs, targets


class DictDataset(Dataset):
    """Adapt a classic (x, y) dataset to the ({input: x}, {head: y}) format used here."""

    def __init__(self, base: Dataset, input_name: str, head_name: str) -> None:
        self.base, self.input_name, self.head_name = base, input_name, head_name

    def __len__(self) -> int:
        return len(self.base)

    def __getitem__(self, index: int) -> tuple[dict, dict]:
        x, y = self.base[index]
        return {self.input_name: x}, {self.head_name: torch.as_tensor(y)}


def collate(batch: list[tuple[dict, dict]]) -> tuple[dict, dict]:
    """Stack inputs; stack equal-shape targets, keep variable-size ones (e.g. boxes) as lists."""
    inputs = default_collate([b[0] for b in batch])
    targets = {}
    for key in batch[0][1]:
        values = [b[1][key] for b in batch]
        same = all(isinstance(v, torch.Tensor) for v in values) and len({tuple(v.shape) for v in values}) == 1
        targets[key] = torch.stack(values) if same else values
    return inputs, targets


def build_datasets() -> tuple[Dataset, Dataset]:
    """Return (train, val) datasets yielding (inputs, targets) dicts.

    Detection from COCO json (pip install pycocotools):

        from torchvision.datasets import CocoDetection, wrap_dataset_for_transforms_v2
        coco = wrap_dataset_for_transforms_v2(CocoDetection("images/", "instances.json"))
        # convert each sample to ({"image": img}, {head: {"boxes": xyxy, "labels": 0..C-1}})
        # and resize images to the declared input size, scaling boxes accordingly.
    """
    return SyntheticDataset(256), SyntheticDataset(64)


# ---------------------------------------------------------------------------
# Losses, metrics, optimisation
# ---------------------------------------------------------------------------


def build_criteria() -> nn.ModuleDict:
    """One loss per head. Losses with parameters (CRF, ArcFace) are trained too."""
    return nn.ModuleDict(
        {
            "ssd": SSDLoss(feat_sizes=((40, 40), (20, 20), (10, 10)), image_size=(320, 320)),
        }
    )


class DetectionMAP:
    """COCO-style mAP via torchmetrics (pip install torchmetrics pycocotools); skipped if unavailable."""

    def __init__(self) -> None:
        try:
            from torchmetrics.detection import MeanAveragePrecision

            self.metric = MeanAveragePrecision(box_format="xyxy", iou_type="bbox")
        except Exception:  # torchmetrics / pycocotools missing
            self.metric = None

    def update(self, preds: list[dict[str, torch.Tensor]], targets: list[dict[str, torch.Tensor]]) -> None:
        if self.metric is not None:
            self.metric.update(
                [{k: v.detach().cpu() for k, v in p.items() if k in ("boxes", "scores", "labels")} for p in preds],
                [{k: v.detach().cpu() for k, v in t.items() if k in ("boxes", "labels")} for t in targets],
            )

    def compute(self) -> dict[str, float]:
        if self.metric is None:
            return {}
        result = self.metric.compute()
        return {"mAP": float(result["map"]), "mAP50": float(result["map_50"])}


def build_metrics() -> dict:
    return {
        "ssd": DetectionMAP(),
    }


def param_groups(module: nn.Module, weight_decay: float) -> list[dict]:
    """No weight decay on biases and normalisation / scale parameters."""
    decay, no_decay = [], []
    for name, p in module.named_parameters():
        if not p.requires_grad:
            continue
        (no_decay if p.ndim <= 1 or name.endswith(".bias") else decay).append(p)
    groups = [
        {"params": decay, "weight_decay": weight_decay},
        {"params": no_decay, "weight_decay": 0.0},
    ]
    return [g for g in groups if g["params"]]


def cosine_with_warmup(step: int, total: int, warmup: int) -> float:
    """Linear warm-up then cosine decay to zero (LR multiplier)."""
    if step < warmup:
        return (step + 1) / warmup
    progress = (step - warmup) / max(1, total - warmup)
    return 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))


class ModelEMA:
    """Exponential moving average of model weights (evaluated instead of the raw model)."""

    def __init__(self, model: nn.Module, decay: float) -> None:
        self.module = copy.deepcopy(model).eval()
        self.decay = decay
        for p in self.module.parameters():
            p.requires_grad_(False)

    @torch.no_grad()
    def update(self, model: nn.Module) -> None:
        for ema_v, v in zip(self.module.state_dict().values(), model.state_dict().values()):
            if v.dtype.is_floating_point:
                ema_v.lerp_(v, 1.0 - self.decay)
            else:
                ema_v.copy_(v)


def to_device(x, device: str):
    """Move tensors inside nested dicts / lists to a device."""
    if isinstance(x, torch.Tensor):
        return x.to(device, non_blocking=True)
    if isinstance(x, dict):
        return {k: to_device(v, device) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return type(x)(to_device(v, device) for v in x)
    return x


def compute_loss(model: nn.Module, inputs: dict, targets: dict, criteria: nn.ModuleDict) -> tuple[
    torch.Tensor,
    dict,
]:
    """Weighted sum of per-head losses (computed in float32)."""
    outputs = model(**inputs)
    if not isinstance(outputs, dict):
        outputs = {"ssd": outputs}
    losses = {name: criteria[name](outputs[name], targets[name]) for name in criteria}
    return sum(LOSS_WEIGHTS[name] * loss for name, loss in losses.items()), losses


def train_one_epoch(model, loader, optimizer, scheduler, scaler, ema, criteria, max_steps: int, step: int) -> int:
    model.train()
    start = time.time()
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        with torch.autocast(device_type=DEVICE, enabled=USE_AMP):
            loss, parts = compute_loss(model, inputs, targets, criteria)
        optimizer.zero_grad(set_to_none=True)
        scaler.scale(loss).backward()
        if GRAD_CLIP > 0:
            scaler.unscale_(optimizer)
            params = [p for g in optimizer.param_groups for p in g["params"]]
            torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP)
        scaler.step(optimizer)
        scaler.update()
        scheduler.step()
        if ema is not None:
            ema.update(model)
        step += 1
        if step % 20 == 0 or step == 1:
            detail = " ".join(f"{k}={v.item():.4f}" for k, v in parts.items())
            print(
                f"  step {step:>6}  loss={loss.item():.4f}  {detail}  ({time.time() - start:.1f}s)",
            )
        if max_steps and step >= max_steps:
            break
    return step


@torch.no_grad()
def evaluate(model: nn.Module, loader: DataLoader, criteria: nn.ModuleDict) -> dict[str, float]:
    model.eval()
    metrics = build_metrics()
    total, batches = 0.0, 0
    for inputs, targets in loader:
        inputs, targets = to_device(inputs, DEVICE), to_device(targets, DEVICE)
        outputs = model(**inputs)
        if not isinstance(outputs, dict):
            outputs = {"ssd": outputs}
        total += sum(LOSS_WEIGHTS[n] * criteria[n](outputs[n], targets[n]).item() for n in criteria)
        batches += 1
        outputs["ssd"] = ssd_postprocess(
            outputs["ssd"],
            feat_sizes=((40, 40), (20, 20), (10, 10)),
            image_size=(320, 320),
        )
        for name, metric in metrics.items():
            metric.update(outputs[name], targets[name])
    results = {"val_loss": total / max(1, batches)}
    for name, metric in metrics.items():
        results.update({f"{name}/{k}": v for k, v in metric.compute().items()})
    return results


def export(model: nn.Module, out_dir: str) -> None:
    """Export TorchScript and ONNX (opset 17, dynamic batch)."""
    model = model.eval().cpu()
    example = example_inputs(batch_size=2)
    names = list(example)
    try:
        traced = torch.jit.trace(model, example_kwarg_inputs=example, strict=False)
        traced.save(os.path.join(out_dir, "model.torchscript.pt"))
        print(f"saved {out_dir}/model.torchscript.pt")
    except Exception as exc:  # data-dependent control flow (e.g. NMS) can't be traced
        print(f"TorchScript export skipped: {exc}")
    try:
        torch.onnx.export(
            model,
            (),
            os.path.join(out_dir, "model.onnx"),
            kwargs=example,
            input_names=names,
            dynamic_axes={name: {0: "batch"} for name in names},
            opset_version=17,
            dynamo=False,
        )
        print(f"saved {out_dir}/model.onnx")
    except Exception as exc:
        print(f"ONNX export skipped: {exc}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--epochs", type=int, default=EPOCHS)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--lr", type=float, default=LR)
    parser.add_argument(
        "--max-steps",
        type=int,
        default=0,
        help="stop after N optimizer steps (0 = full run)",
    )
    parser.add_argument("--resume", default="", help="checkpoint to resume from")
    parser.add_argument("--out", default=OUT_DIR)
    parser.add_argument("--no-export", action="store_true")
    args = parser.parse_args()

    torch.manual_seed(0)
    os.makedirs(args.out, exist_ok=True)
    train_set, val_set = build_datasets()
    train_loader = DataLoader(
        train_set, batch_size=args.batch_size, shuffle=True, num_workers=NUM_WORKERS, collate_fn=collate, drop_last=True
    )
    val_loader = DataLoader(
        val_set,
        batch_size=args.batch_size,
        num_workers=NUM_WORKERS,
        collate_fn=collate,
    )

    model = build_model().to(DEVICE)
    criteria = build_criteria().to(DEVICE)
    groups = param_groups(model, WEIGHT_DECAY) + param_groups(criteria, WEIGHT_DECAY)
    optimizer = torch.optim.AdamW(groups, lr=args.lr)
    total_steps = args.epochs * len(train_loader)
    if args.max_steps:
        total_steps = min(total_steps, args.max_steps)
    warmup = min(WARMUP_EPOCHS * len(train_loader), max(1, total_steps // 10))
    schedule = lambda s: cosine_with_warmup(s, total_steps, warmup)  # noqa: E731
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, schedule)
    scaler = torch.amp.GradScaler("cuda", enabled=USE_AMP)
    ema = ModelEMA(model, EMA_DECAY) if USE_EMA else None

    start_epoch, step, best = 0, 0, float("inf")
    if args.resume:
        ckpt = torch.load(args.resume, map_location=DEVICE)
        model.load_state_dict(ckpt["model"])
        criteria.load_state_dict(ckpt["criteria"])
        optimizer.load_state_dict(ckpt["optimizer"])
        scheduler.load_state_dict(ckpt["scheduler"])
        if ema is not None and ckpt.get("ema"):
            ema.module.load_state_dict(ckpt["ema"])
        start_epoch, step, best = ckpt["epoch"] + 1, ckpt["step"], ckpt["best"]
        print(f"resumed from {args.resume} (epoch {start_epoch})")

    print(f"training on {DEVICE} for {args.epochs} epochs ({len(train_loader)} steps/epoch)")
    for epoch in range(start_epoch, args.epochs):
        print(f"epoch {epoch + 1}/{args.epochs}")
        args_ = (model, train_loader, optimizer, scheduler, scaler, ema, criteria)
        step = train_one_epoch(*args_, max_steps=args.max_steps, step=step)
        eval_model = ema.module if ema is not None else model
        results = evaluate(eval_model, val_loader, criteria)
        print("  " + "  ".join(f"{k}={v:.4f}" for k, v in results.items()))
        score = results.get("val_loss", -sum(results.values()))
        best = min(best, score)
        state = {
            "model": model.state_dict(),
            "criteria": criteria.state_dict(),
            "optimizer": optimizer.state_dict(),
            "scheduler": scheduler.state_dict(),
            "ema": ema.module.state_dict() if ema is not None else None,
            "epoch": epoch,
            "step": step,
            "best": best,
            "config": CONFIG,
        }
        torch.save(state, os.path.join(args.out, "last.pt"))
        if score <= best:
            torch.save(state, os.path.join(args.out, "best.pt"))
            print(f"  new best checkpoint ({score:.4f})")
        if args.max_steps and step >= args.max_steps:
            break

    if not args.no_export:
        export(ema.module if ema is not None else model, args.out)


if __name__ == "__main__":
    main()
